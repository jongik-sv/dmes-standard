# .dflow — D'Flow 에이전트 프로젝트 공통 설정. 리포에 commit (비밀 금지).
# 같은 프로젝트 사람 모두 같은 값. 개인 값(토큰·개발 branch)은 .dflow.local.

# D'Flow 서버. 스테이징 test = 파일 수정 금지, 그 세션에만 DFLOW_API_BASE export.
api_base=https://wbs-web.vercel.app

# 이 리포의 D'Flow 프로젝트 UUID (프로젝트 URL /p/<UUID>/). 서브시스템마다 프로젝트가 다르면 비우고
# 각자 .dflow.local 의 project_map 에 맡은 것만 적음.
project_id=

# 운영 branch — 개발 branch 승격으로만 진입. 비우면 원격 기본 branch(origin/HEAD).
release_branch=main

# D'Flow 워커는 기본적으로 docker 안 씀 (docker·Testcontainers 검증을 게이트에서 빼고 보고). 예외 = D'Flow 작업에
# docker 태그 달린 Task 뿐. 1 이면 태그 있어도·수동 /dflow-dev 에서도 막는 강제 금지. 0 은 아무것도 안 풂.
# 규칙 정본: .claude/skills/dflow-dev/references/dev-discipline.md 「도커 사용 규칙」.
# no_docker=1

# 방언 검증 명령. 승인 스윕(/dflow-merge)이 merge 마친 뒤 스윕마다 1회, 개발 branch 끝 commit 의 깨끗한 임시 worktree
# 최상위에서 bash -c 로 실행 (PC 전역 docker 슬롯 안). 비우면 단계 없음 (dmes-standard 는 DB 가 Oracle 하나라 비움. test = Oracle PDB 하니스). PC 전용 값(JAVA_HOME 등) 든 명령은
# .dflow.local 에 둠 (.dflow.local 우선). 정본: .claude/skills/dflow-merge/SKILL.md 「방언 검증」.
# dialect_check=cd <폴더> && <DB 마다 다른 검증 시험 명령>   (DB 를 둘 이상 지원하는 리포에서만)

# 게이트 범위 대응표 = 이 파일 아닌 리포 최상위 별도 파일 .dflow-gates (여러 줄 표라 key=value 한 줄에 안 맞음).
# 있으면 /dflow-dev 의 Build 게이트·변이 검증이 바꾼 module test 만 실행, 전체는 Verify 에서 1회. 없으면
# 게이트마다 전체. 형식·예시: .claude/skills/dflow-dev/references/dflow-gates.example, 정본 dev-discipline.md
# 「게이트 범위 대응표(.dflow-gates)」.
