# .dflow.local — D'Flow 에이전트 개인 설정. git 에 올리지 않음 (.gitignore). 값을 어디에도 출력·붙여넣지 않음.

# 개인 액세스 토큰 — D'Flow 웹 /account "내 토큰" 에서 발급. 쉼표로 여러 개 (첫 토큰이 기본). 하나면 pat= 도 됨.
pats=

# 토큰 둘 이상일 때 이 리포가 쓸 키 prefix (토큰의 셋째 '_' 칸). 비우면 첫 토큰. 목록 = dflow.sh profiles.
# /dflow-team 은 비어 있으면 시작 때 정해서 파일 끝에 적음.
as=

# 내 개발 브랜치 (필수). 에이전트 머지·스택 기점·반영 확인의 기준. 동료와 같은 이름이면 그 브랜치 공유.
# 운영 브랜치에서 직접 개발하면 그 이름(예 main). 원격에 먼저 push 돼 있어야 함.
dev_branch=

# 1 이면 팀장이 완료 보고된 작업을 승인 전에 개발 브랜치로 머지. 기본 0.
automerge=0

# 내가 맡은 서브시스템의 DOCS_DIR=프로젝트 UUID (쉼표 구분). 리포 전체가 한 프로젝트면 비움.
# project_map=docs/c10=<uuid>

# 1 이면 이 PC 에서 docker 태그 Task 의 워커와 수동 /dflow-dev 도 docker 안 씀 (강제 금지). .dflow 의 no_docker 를
# 덮음. 워커는 이 값과 무관하게 기본 금지 (0 으로 못 풂 — 허용은 D'Flow 의 docker 태그로만). 정본: dev-discipline.md
# 「도커 사용 규칙」.
# no_docker=1

# 방언 검증 명령 (.dflow 의 dialect_check 를 덮음). PC 전용 값(JAVA_HOME 등) 든 명령은 .dflow.local 에 둠.
# 정본: .claude/skills/dflow-merge/SKILL.md 「방언 검증」.
# dialect_check=cd <폴더> && JAVA_HOME=<JDK 경로> <DB 마다 다른 검증 시험 명령>   (DB 를 둘 이상 지원하는 리포에서만. dmes-standard 는 안 씀)

# Build 모델 시험 (기본 꺼짐). 배정표가 opus 로 정한 Build 중 일부를 sonnet(+정해진 시점 advisor)으로 돌려 비교.
# sonnet 밖의 값 = 꺼짐 (haiku Build 금지). 목록 있으면 목록만, 없으면 비율 (TSK ID 로 결정적 판정 — 재개해도 같음).
# 판정은 Phase 01 에서 1회, state.json 에 기록. 정본: dflow-dev/references/dev-discipline.md 「Build 모델 시험(build_model_trial)」.
# build_model_trial=sonnet
# build_model_trial_rate=30
# build_model_trial_tasks=TSK-02-05,WP-03,dict/WP-01
# /dflow-team 팀원의 첫 턴 컨텍스트 줄이기 (선택). 안 적으면 종전과 같음. dflow-* 와 이 리포의 프로젝트 스킬은 늘 남음.
# 적은 이름이 이 PC 에 없으면 경고 한 줄만 내고 진행. 정본: .claude/skills/dflow-team/references/backends.md 「첫 턴 컨텍스트 줄이기」.
# worker_keep_skills=auto   (내 ~/.claude/CLAUDE.md 에 이름이 나오는 사용자 스킬만 남김. 또는 이름 쉼표 목록, 없으면 none)
# worker_skills_off=<그 밖에 끌 스킬 이름, 쉼표. 예: 쓰지 않는 Claude Code 내장 스킬>
# worker_keep_plugins=auto  (지침이 쓰라는 플러그인만 켜 두고 그 MCP 를 살림. 또는 이름@마켓 쉼표 목록, 없으면 none)
# worker_output_style=default
