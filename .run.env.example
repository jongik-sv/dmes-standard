# Local run defaults.
# Shell syntax. Each value is used only when the matching script is run without CLI args.
#
# 기본값은 "전부 띄우기" 다. 필요한 것만 띄우려면 아래 예시처럼 좁혀 쓴다.
#
# BE_RUN_ARGS — 백엔드 (모듈 플래그: --mpn --mcm --mls --mqc --mpp --analog)
#   BE_RUN_ARGS="--all"            # 전체 6개 모듈 (mls 8092 · mqc 8093 · mpp 8094 · mpn 8095 · mcm 8100 · analog 8191)
#   BE_RUN_ARGS="--mcm"            # 포털 호스트만
#   BE_RUN_ARGS="--mcm --mpn"      # 조합
#
# FE_RUN_ARGS — 프론트엔드
#   FE_RUN_ARGS="--all"            # install + 화면 라이브러리 전체 build + 전체 dev
#   FE_RUN_ARGS="--all -q"         # 설치/빌드 건너뛰고 dev 만 (dist 가 이미 있을 때 가장 빠름)
#   FE_RUN_ARGS="--all --clean"    # m-mcm/.next 캐시 비우고 전체 dev
#   FE_RUN_ARGS="--mpn -q"         # MPN 만 (shared + m-mpn watch + mcm portal)
#
# LOCAL_RUN_ARGS — local-run.sh (BE + FE 동시). FE 쪽 옵션을 여기에 쓴다.
#   LOCAL_RUN_ARGS="--all"
#   LOCAL_RUN_ARGS="--all -q"

FE_RUN_ARGS="--all"
BE_RUN_ARGS="--all"
LOCAL_RUN_ARGS="--all"
