# ────────────────────────────────────────────────────
# mcm Next.js BFF — 환경변수 예시
# 실제 값은 .env 또는 .env.local 에 작성한다 (둘 다 git 제외).
# ./fe-run.sh 는 둘 다 없을 때만 본 파일을 복사해 .env 를 만들고 AUTH_SECRET 을 자동 발급한다.
# ────────────────────────────────────────────────────

## NextAuth — AUTH_SECRET 이 없으면 기동 자체가 실패한다.
NEXTAUTH_URL="http://localhost:5100"
AUTH_SECRET="replace-with-32-plus-random-characters"
AUTH_COOKIE_PREFIX="oasis-mcm-auth"

## 로그인 화면 하단 저작권 문구 (미지정 시 "© {올해} {appName}")
# NEXT_PUBLIC_COPYRIGHT="Copyright © 2026 <회사명>. All Rights Reserved."

## Backend (BFF → WAS) 기본 목적지
# 운영: 게이트웨이(Nginx) 단일 URL — 게이트웨이가 모듈별 라우팅을 담당
# 개발: 포털 호스트인 mcm 의 로컬 주소
BACKEND_API_URL="http://localhost:8100"

## Backend client key (BFF → WAS 마스터 시크릿 — BE 는 이 값을 든 요청의 X-Authenticated-* 사용자를 믿는다)
## 백엔드 application.yml 의 cactus.security.client-key(또는 백엔드 환경변수 BACKEND_CLIENT_KEY)와 같은 값이어야 한다.
## BFF → BE 방향에만 쓴다. BE → BFF 호출(권한 캐시 무효화)은 아래 BFF_INTERNAL_SECRET 으로 따로 확인한다.
## 운영에서는 반드시 별도 시크릿으로 교체한다.
BACKEND_CLIENT_KEY="dmes-bff-local-client-key-2026"

## BE → BFF 내부 호출 비밀 (서버 전용 — NEXT_PUBLIC_ 을 붙이지 않는다)
## BE RoleChangedEventListener 가 권한 캐시 무효화(/api/mcm/internal/cache/invalidate-role)를 부를 때 X-Bff-Internal-Secret 으로 싣는다.
## 백엔드 mcm.bff.internal-secret(백엔드 환경변수 BFF_INTERNAL_SECRET)과 같은 값이어야 한다. 아래 값은 로컬 전용이다
## (백엔드 application-local.yml 기본값과 같다). 비어 있으면 그 호출을 403 으로 거절하고 권한 변경은 5분 TTL 로 반영된다.
## 운영(NODE_ENV=production)에서는 이 로컬 값이나 BACKEND_CLIENT_KEY 와 같은 값이면 거절한다 — 반드시 별도 비밀로 바꾼다.
BFF_INTERNAL_SECRET="dmes-bff-internal-local-2026"

## 신뢰할 앞단(리버스 프록시) 단계 수 — BE 로 넘기는 X-Forwarded-For 를 정한다(lib/http/forwarded-for.ts).
## 0(기본): 클라이언트가 보낸 X-Forwarded-For 를 버리고 넘기지 않는다(브라우저가 BFF 에 바로 붙는 로컬 개발).
## N: 오른쪽에서 N 번째 주소 하나만 넘긴다. 운영 Nginx 한 단계면 1 + Nginx `proxy_set_header X-Forwarded-For $remote_addr;`.
# TRUSTED_PROXY_HOPS=0

# ────────────────────────────────────────────────────
# 모듈별 WAS 매핑 (개발 전용)
#
# 규칙: `{moduleId 대문자}_WAS_URL` 이 있으면 그 모듈 호출은 해당 주소로 직접 가고,
#       없으면 BACKEND_API_URL 로 폴백한다 (lib/http/be-proxy.ts).
# 운영에서는 전부 비우고 BACKEND_API_URL 만 게이트웨이로 지정한다.
#
# 아래 값은 ./be-run.sh --all 이 띄우는 로컬 포트와 일치한다.
# 일부 모듈만 띄운다면 그 줄만 남기고 나머지는 주석 처리한다.
# ────────────────────────────────────────────────────
MCM_WAS_URL="http://localhost:8100"
MPN_WAS_URL="http://localhost:8095"
MLS_WAS_URL="http://localhost:8092"
MQC_WAS_URL="http://localhost:8093"
MPP_WAS_URL="http://localhost:8094"
MDM_WAS_URL="http://localhost:8096"
ANALOG_WAS_URL="http://localhost:8191"

NEXT_PUBLIC_OASIS_API_URL="http://localhost:8100"
OIDC_ISSUER="http://localhost:5100"
OIDC_AUDIENCE="oasis-mcm"
