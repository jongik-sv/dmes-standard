{
  "name": "@dk-oasis/m-analog",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./pages/*": {
      "types": "./dist/pages/*.d.ts",
      "import": "./dist/pages/*.js"
    },
    "./pages/*.css": "./dist/pages/*.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../scripts/lib-dev.mjs pkg-build",
    "dev": "node ../scripts/lib-dev.mjs watch",
    "format": "prettier --write .",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@dk-oasis/shared": "workspace:*",
    "next": "^16.3.8",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react18-json-view": "^0.2.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@types/node": "25.3.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "prettier": "^3.8.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
