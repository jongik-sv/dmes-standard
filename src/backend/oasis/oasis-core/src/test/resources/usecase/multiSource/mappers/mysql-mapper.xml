<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="usecase.multiDataSource">
    <select id="selectUsers" parameterType="java.util.HashMap"
            resultType="usecase.multiDataSource.UserEntity">
        select id, firstName, lastName
        from users
    </select>
    <select id="selectUser" parameterType="usecase.multiDataSource.UserDto"
            resultType="usecase.multiDataSource.UserEntity">
        select id, firstName, lastName
        from users
        where id = #{id}
    </select>
</mapper>
