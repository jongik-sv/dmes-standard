    <bpmn:endEvent id="Event_1cyxcyy">
      <bpmn:incoming>Flow_05jbh3n</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:scriptTask id="recordOrder" name="실적조회" scriptFormat="sql">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="output" value="result" />
          <camunda:property name="ds" value="ds1" />
          <camunda:property name="log" value="[0][id] +  &#34; id selected&#34;" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0snd4m7</bpmn:incoming>
      <bpmn:outgoing>Flow_001axqo</bpmn:outgoing>
      <bpmn:script>select id, firstName, lastName from Employee</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_001axqo" sourceRef="recordOrder" targetRef="Activity_0udkis8" />
    <bpmn:scriptTask id="Activity_0udkis8" name="실적저장" scriptFormat="sql">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="output" value="result" />
          <camunda:property name="ds" value="ds1" />
          <camunda:property name="log" value="[0][id] +  &#34; id selected&#34;" />
        </camunda:properties>
        <camunda:inputOutput>
          <camunda:inputParameter name="param">
            <camunda:map>
              <camunda:entry key="id">2</camunda:entry>
              <camunda:entry key="firstName">nn</camunda:entry>
            </camunda:map>
          </camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_001axqo</bpmn:incoming>
      <bpmn:outgoing>Flow_05jbh3n</bpmn:outgoing>
      <bpmn:script>update employee set firstName = :firstName where id = :id</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_05jbh3n" sourceRef="Activity_0udkis8" targetRef="Event_1cyxcyy" />
