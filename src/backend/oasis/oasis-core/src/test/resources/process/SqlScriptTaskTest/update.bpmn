  <bpmn:process id="Process_1ob4rra" name="Hey Process" isExecutable="true">
    <bpmn:startEvent id="s1" name="s1">
      <bpmn:outgoing>Flow_0snd4m7</bpmn:outgoing>
    </bpmn:startEvent>
