<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" id="Definitions_txAuxOk" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="txAuxOk" name="커밋 실패 시험 - 보조 DB 정상 저장" isExecutable="true">
    <bpmn:extensionElements>
      <camunda:properties>
        <camunda:property name="tx" value="txAux" />
      </camunda:properties>
    </bpmn:extensionElements>
    <bpmn:startEvent id="start">
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="flow_1" sourceRef="start" targetRef="task" />
    <bpmn:serviceTask id="task" name="보조 DB 저장" camunda:class="txProbeTask">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="saveAux" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="flow_2" sourceRef="task" targetRef="end" />
    <bpmn:endEvent id="end">
      <bpmn:incoming>flow_2</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
