<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  id="Definitions_commRoleMng"
                  targetNamespace="http://bpmn.io/schema/bpmn">

  <!--
    역할 관리 — commRoleMng BPMN (csa 그룹 / mcm 모듈 / W3)

    분석리포트 §8 + BPMN설계서 §2 의 As-Is 8 action 보존 (To-Be 7 — 정책 #1 / Q-011 / Q-016 round-2 fix / 미사용 분기 제거):
      As-Is 8 → To-Be 7 (2026-06-02 round-2 fix — searchObjectLov 추가):
        - searchCmRole      — 역할 마스터 그리드 조회 (selectCommRole)
        - saveCmRole        — 역할 마스터 일괄 저장 (insertCommRole / updateCommRole / deleteCommRole status 자동 분기)
        - searchCmRoleMap   — 선택 역할의 현재 권한 조회 (3-table JOIN selectCommRoleMapList)
        - saveCmRoleMap     — 현재 권한 일괄 저장 (insertCommRoleMap / deleteCommRoleMap — UPDATE ✗ / Q-011 closed)
        - searchCmPerm      — 전체 권한 후보 조회 (selectCommPerm NOT EXISTS — 미할당 권한 풀)
        - lov               — MENU_ID 1 dataset (To-Be 정책 #1: As-Is APP_HOST_ID 폐기 → selectMenuId 1 SQL 만)
        - searchObjectLov   — sub2 OBJECT-LoV (round-2 fix / Q-016 closed — As-Is xfdl:321~336
                              commonDynamic_onload "csa::CommMenuMng/commonList" 본 namespace 내재화 —
                              selectMenuObjPop 의 TB_MCM_SEC_OBJ WHERE USE_TP='Y' AND UPPER LIKE)
        ~~- searchCmRoleMapPnt — 부모역할 부여 조회 (As-Is xfdl 주석 / 분석 §11 #11)~~
        ~~- pntRoleIdPop      — 부모 역할 POPUP (As-Is xfdl 주석 / 분석 §11 #11)~~

    As-Is 결함 To-Be 정정 (BPMN §6.1):
      - process id:   As-Is "CommRoleMng" → To-Be "commRoleMng" (camelCase / Q-012 closed)
      - process name: As-Is "부모역할 부여 조회" (오기재 — 다른 화면명 복붙) → To-Be "역할 관리" (Q-012 closed)

    OASIS executor 가 actionGateway 의 input='action' 으로 분기. serviceTask 별
    Spring bean 'commRoleMngService' 의 method 호출 → 결과 Map 을 process variable 로 누적.

    가이드 §6-C/D/E 정합 (W1·W2 정본 패턴):
      - grid property 사용 ✗ (saveCmRole / saveCmRoleMap 는 grids.master.rows → method param `master` 자동 매핑)
      - output="result" 명시 (응답 누락 결함 회피 — 가이드 §6-D)
      - dto property: searchCmRole / searchCmRoleMap / searchCmPerm 3 action 만 (params → DTO 변환)
      - <conditionExpression> 미사용 — sequenceFlow `name` 만으로 분기
  -->

  <bpmn:process id="commRoleMng" name="역할 관리" isExecutable="true">

    <bpmn:startEvent id="start">
      <bpmn:outgoing>flow_to_gw</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="flow_to_gw" sourceRef="start" targetRef="actionGateway" />

    <bpmn:exclusiveGateway id="actionGateway">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="input" value="action" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_to_gw</bpmn:incoming>
      <bpmn:outgoing>flow_searchCmRole</bpmn:outgoing>
      <bpmn:outgoing>flow_saveCmRole</bpmn:outgoing>
      <bpmn:outgoing>flow_searchCmRoleMap</bpmn:outgoing>
      <bpmn:outgoing>flow_saveCmRoleMap</bpmn:outgoing>
      <bpmn:outgoing>flow_searchCmPerm</bpmn:outgoing>
      <bpmn:outgoing>flow_lov</bpmn:outgoing>
      <bpmn:outgoing>flow_searchObjectLov</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- ─────────── action: searchCmRole — 역할 마스터 그리드 조회 ─────────── -->
    <bpmn:sequenceFlow id="flow_searchCmRole" name="search" sourceRef="actionGateway" targetRef="searchCmRoleTask" />
    <bpmn:serviceTask id="searchCmRoleTask" name="역할 마스터 조회" camunda:class="commRoleMngService">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="searchCmRole" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mcm.csa.commRoleMng.dto.CommRoleMngSearchRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_searchCmRole</bpmn:incoming>
      <bpmn:outgoing>flow_searchCmRole_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="flow_searchCmRole_end" sourceRef="searchCmRoleTask" targetRef="endSearchCmRole" />
    <bpmn:endEvent id="endSearchCmRole">
      <bpmn:incoming>flow_searchCmRole_end</bpmn:incoming>
    </bpmn:endEvent>

    <!-- ─────────── action: saveCmRole — input grid: grids.master.rows → method param `master` ─────────── -->
    <bpmn:sequenceFlow id="flow_saveCmRole" name="save" sourceRef="actionGateway" targetRef="saveCmRoleTask" />
    <bpmn:serviceTask id="saveCmRoleTask" name="역할 마스터 저장 (status 분기) + 후속 재조회" camunda:class="commRoleMngService">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="saveCmRole" />
          <camunda:property name="output" value="result" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_saveCmRole</bpmn:incoming>
      <bpmn:outgoing>flow_saveCmRole_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="flow_saveCmRole_end" sourceRef="saveCmRoleTask" targetRef="endSaveCmRole" />
    <bpmn:endEvent id="endSaveCmRole">
      <bpmn:incoming>flow_saveCmRole_end</bpmn:incoming>
    </bpmn:endEvent>

    <!-- ─────────── action: searchCmRoleMap — 선택 역할의 현재 권한 조회 (3-table JOIN) ─────────── -->
    <bpmn:sequenceFlow id="flow_searchCmRoleMap" name="searchCmRoleMap" sourceRef="actionGateway" targetRef="searchCmRoleMapTask" />
    <bpmn:serviceTask id="searchCmRoleMapTask" name="역할 부여 조회 (3-table JOIN)" camunda:class="commRoleMngService">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="searchCmRoleMap" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mcm.csa.commRoleMng.dto.CommRoleMngSearchRoleMapRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_searchCmRoleMap</bpmn:incoming>
      <bpmn:outgoing>flow_searchCmRoleMap_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="flow_searchCmRoleMap_end" sourceRef="searchCmRoleMapTask" targetRef="endSearchCmRoleMap" />
    <bpmn:endEvent id="endSearchCmRoleMap">
      <bpmn:incoming>flow_searchCmRoleMap_end</bpmn:incoming>
    </bpmn:endEvent>

    <!-- ─────────── action: saveCmRoleMap — INSERT/DELETE 분기 (UPDATE ✗ / Q-011 closed) ─────────── -->
    <bpmn:sequenceFlow id="flow_saveCmRoleMap" name="saveCmRoleMap" sourceRef="actionGateway" targetRef="saveCmRoleMapTask" />
    <bpmn:serviceTask id="saveCmRoleMapTask" name="역할 부여 저장 (INSERT/DELETE) + 후속 재조회" camunda:class="commRoleMngService">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="saveCmRoleMap" />
          <camunda:property name="output" value="result" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_saveCmRoleMap</bpmn:incoming>
      <bpmn:outgoing>flow_saveCmRoleMap_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="flow_saveCmRoleMap_end" sourceRef="saveCmRoleMapTask" targetRef="endSaveCmRoleMap" />
    <bpmn:endEvent id="endSaveCmRoleMap">
      <bpmn:incoming>flow_saveCmRoleMap_end</bpmn:incoming>
    </bpmn:endEvent>

    <!-- ─────────── action: searchCmPerm — 전체 권한 후보 조회 (NOT EXISTS) ─────────── -->
    <bpmn:sequenceFlow id="flow_searchCmPerm" name="searchCmPerm" sourceRef="actionGateway" targetRef="searchCmPermTask" />
    <bpmn:serviceTask id="searchCmPermTask" name="PERMISSION 후보 조회 (NOT EXISTS)" camunda:class="commRoleMngService">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="searchCmPerm" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mcm.csa.commRoleMng.dto.CommRoleMngSearchPermRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_searchCmPerm</bpmn:incoming>
      <bpmn:outgoing>flow_searchCmPerm_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="flow_searchCmPerm_end" sourceRef="searchCmPermTask" targetRef="endSearchCmPerm" />
    <bpmn:endEvent id="endSearchCmPerm">
      <bpmn:incoming>flow_searchCmPerm_end</bpmn:incoming>
    </bpmn:endEvent>

    <!-- ─────────── action: lov — MENU_ID 1 dataset (To-Be 정책 #1) ─────────── -->
    <bpmn:sequenceFlow id="flow_lov" name="lov" sourceRef="actionGateway" targetRef="lovTask" />
    <bpmn:serviceTask id="lovTask" name="MENU ID LoV 조회" camunda:class="commRoleMngService">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="lov" />
          <camunda:property name="output" value="result" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_lov</bpmn:incoming>
      <bpmn:outgoing>flow_lov_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="flow_lov_end" sourceRef="lovTask" targetRef="endLov" />
    <bpmn:endEvent id="endLov">
      <bpmn:incoming>flow_lov_end</bpmn:incoming>
    </bpmn:endEvent>

    <!-- ─────────── action: searchObjectLov — sub2 OBJECT-LoV (round-2 fix / Q-016 closed) ─────────── -->
    <bpmn:sequenceFlow id="flow_searchObjectLov" name="searchObjectLov" sourceRef="actionGateway" targetRef="searchObjectLovTask" />
    <bpmn:serviceTask id="searchObjectLovTask" name="OBJECT LoV 조회 (selectMenuObjPop 내재화)" camunda:class="commRoleMngService">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="searchObjectLov" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mcm.csa.commRoleMng.dto.CommRoleMngSearchObjectLovRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_searchObjectLov</bpmn:incoming>
      <bpmn:outgoing>flow_searchObjectLov_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="flow_searchObjectLov_end" sourceRef="searchObjectLovTask" targetRef="endSearchObjectLov" />
    <bpmn:endEvent id="endSearchObjectLov">
      <bpmn:incoming>flow_searchObjectLov_end</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="commRoleMng">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="152" y="482" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="actionGateway_di" bpmnElement="actionGateway" isMarkerVisible="true">
        <dc:Bounds x="245" y="475" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="searchCmRoleTask_di" bpmnElement="searchCmRoleTask">
        <dc:Bounds x="370" y="40" width="220" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endSearchCmRole_di" bpmnElement="endSearchCmRole">
        <dc:Bounds x="640" y="62" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="saveCmRoleTask_di" bpmnElement="saveCmRoleTask">
        <dc:Bounds x="370" y="200" width="220" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endSaveCmRole_di" bpmnElement="endSaveCmRole">
        <dc:Bounds x="640" y="222" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="searchCmRoleMapTask_di" bpmnElement="searchCmRoleMapTask">
        <dc:Bounds x="370" y="360" width="220" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endSearchCmRoleMap_di" bpmnElement="endSearchCmRoleMap">
        <dc:Bounds x="640" y="382" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="saveCmRoleMapTask_di" bpmnElement="saveCmRoleMapTask">
        <dc:Bounds x="370" y="460" width="220" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endSaveCmRoleMap_di" bpmnElement="endSaveCmRoleMap">
        <dc:Bounds x="640" y="482" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="searchCmPermTask_di" bpmnElement="searchCmPermTask">
        <dc:Bounds x="370" y="620" width="220" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endSearchCmPerm_di" bpmnElement="endSearchCmPerm">
        <dc:Bounds x="640" y="642" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lovTask_di" bpmnElement="lovTask">
        <dc:Bounds x="370" y="780" width="220" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endLov_di" bpmnElement="endLov">
        <dc:Bounds x="640" y="802" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="searchObjectLovTask_di" bpmnElement="searchObjectLovTask">
        <dc:Bounds x="370" y="940" width="220" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endSearchObjectLov_di" bpmnElement="endSearchObjectLov">
        <dc:Bounds x="640" y="962" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_to_gw_di" bpmnElement="flow_to_gw">
        <di:waypoint x="188" y="500" />
        <di:waypoint x="245" y="500" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_searchCmRole_di" bpmnElement="flow_searchCmRole">
        <di:waypoint x="270" y="475" />
        <di:waypoint x="270" y="80" />
        <di:waypoint x="370" y="80" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_searchCmRole_end_di" bpmnElement="flow_searchCmRole_end">
        <di:waypoint x="590" y="80" />
        <di:waypoint x="640" y="80" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_saveCmRole_di" bpmnElement="flow_saveCmRole">
        <di:waypoint x="270" y="475" />
        <di:waypoint x="270" y="240" />
        <di:waypoint x="370" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_saveCmRole_end_di" bpmnElement="flow_saveCmRole_end">
        <di:waypoint x="590" y="240" />
        <di:waypoint x="640" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_searchCmRoleMap_di" bpmnElement="flow_searchCmRoleMap">
        <di:waypoint x="270" y="475" />
        <di:waypoint x="270" y="400" />
        <di:waypoint x="370" y="400" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_searchCmRoleMap_end_di" bpmnElement="flow_searchCmRoleMap_end">
        <di:waypoint x="590" y="400" />
        <di:waypoint x="640" y="400" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_saveCmRoleMap_di" bpmnElement="flow_saveCmRoleMap">
        <di:waypoint x="295" y="500" />
        <di:waypoint x="370" y="500" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_saveCmRoleMap_end_di" bpmnElement="flow_saveCmRoleMap_end">
        <di:waypoint x="590" y="500" />
        <di:waypoint x="640" y="500" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_searchCmPerm_di" bpmnElement="flow_searchCmPerm">
        <di:waypoint x="270" y="525" />
        <di:waypoint x="270" y="660" />
        <di:waypoint x="370" y="660" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_searchCmPerm_end_di" bpmnElement="flow_searchCmPerm_end">
        <di:waypoint x="590" y="660" />
        <di:waypoint x="640" y="660" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_lov_di" bpmnElement="flow_lov">
        <di:waypoint x="270" y="525" />
        <di:waypoint x="270" y="820" />
        <di:waypoint x="370" y="820" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_lov_end_di" bpmnElement="flow_lov_end">
        <di:waypoint x="590" y="820" />
        <di:waypoint x="640" y="820" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_searchObjectLov_di" bpmnElement="flow_searchObjectLov">
        <di:waypoint x="270" y="525" />
        <di:waypoint x="270" y="980" />
        <di:waypoint x="370" y="980" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_searchObjectLov_end_di" bpmnElement="flow_searchObjectLov_end">
        <di:waypoint x="590" y="980" />
        <di:waypoint x="640" y="980" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
