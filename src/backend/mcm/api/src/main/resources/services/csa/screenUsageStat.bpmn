    </bpmn:serviceTask>
    <bpmn:endEvent id="endByUser">
      <bpmn:incoming>flow_byUser_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="unusedTask" name="미사용 화면" camunda:class="screenUsageStatService">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="unused" />
