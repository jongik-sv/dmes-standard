    <bpmn:sequenceFlow id="flow_to_gw" sourceRef="start" targetRef="actionGateway" />
    <bpmn:sequenceFlow id="flow_overview" name="overview" sourceRef="actionGateway" targetRef="overviewTask" />
    <bpmn:sequenceFlow id="flow_overview_end" sourceRef="overviewTask" targetRef="endOverview" />
    <bpmn:sequenceFlow id="flow_byScreen" name="byScreen" sourceRef="actionGateway" targetRef="byScreenTask" />
    <bpmn:sequenceFlow id="flow_byScreen_end" sourceRef="byScreenTask" targetRef="endByScreen" />
    <bpmn:sequenceFlow id="flow_byDept" name="byDept" sourceRef="actionGateway" targetRef="byDeptTask" />
    <bpmn:sequenceFlow id="flow_byDept_end" sourceRef="byDeptTask" targetRef="endByDept" />
    <bpmn:sequenceFlow id="flow_byUser" name="byUser" sourceRef="actionGateway" targetRef="byUserTask" />
    <bpmn:sequenceFlow id="flow_byUser_end" sourceRef="byUserTask" targetRef="endByUser" />
    <bpmn:sequenceFlow id="flow_unused" name="unused" sourceRef="actionGateway" targetRef="unusedTask" />
    <bpmn:sequenceFlow id="flow_unused_end" sourceRef="unusedTask" targetRef="endUnused" />
    <bpmn:sequenceFlow id="flow_history" name="history" sourceRef="actionGateway" targetRef="historyTask" />
    <bpmn:sequenceFlow id="flow_history_end" sourceRef="historyTask" targetRef="endHistory" />
