<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_screenUsageStat" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-tool" exporterVersion="1.2.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.15.0">
  <bpmn:process id="screenUsageStat" name="화면 사용 통계 서비스" isExecutable="true">
    <bpmn:startEvent id="start">
      <bpmn:outgoing>flow_to_gw</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="actionGateway">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="input" value="action" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_to_gw</bpmn:incoming>
      <bpmn:outgoing>flow_overview</bpmn:outgoing>
      <bpmn:outgoing>flow_byScreen</bpmn:outgoing>
      <bpmn:outgoing>flow_byDept</bpmn:outgoing>
      <bpmn:outgoing>flow_byUser</bpmn:outgoing>
      <bpmn:outgoing>flow_unused</bpmn:outgoing>
      <bpmn:outgoing>flow_history</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="overviewTask" name="개요" camunda:class="screenUsageStatService">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="overview" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mcm.screenusage.dto.ScreenUsageStatRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_overview</bpmn:incoming>
      <bpmn:outgoing>flow_overview_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="endOverview">
      <bpmn:incoming>flow_overview_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="byScreenTask" name="화면별" camunda:class="screenUsageStatService">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="byScreen" />
          <camunda:property name="output" value="screens" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mcm.screenusage.dto.ScreenUsageStatRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_byScreen</bpmn:incoming>
      <bpmn:outgoing>flow_byScreen_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="endByScreen">
      <bpmn:incoming>flow_byScreen_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="byDeptTask" name="부서별" camunda:class="screenUsageStatService">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="byDept" />
          <camunda:property name="output" value="depts" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mcm.screenusage.dto.ScreenUsageStatRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_byDept</bpmn:incoming>
      <bpmn:outgoing>flow_byDept_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="endByDept">
      <bpmn:incoming>flow_byDept_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="byUserTask" name="사용자별" camunda:class="screenUsageStatService">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="byUser" />
          <camunda:property name="output" value="users" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mcm.screenusage.dto.ScreenUsageStatRequest" />
