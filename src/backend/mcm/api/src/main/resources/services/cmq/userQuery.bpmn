      <bpmndi:BPMNShape id="endGetDef_di" bpmnElement="endGetDef">
        <dc:Bounds x="582" y="282" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="runTask_di" bpmnElement="runTask">
        <dc:Bounds x="400" y="420" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endRun_di" bpmnElement="endRun">
        <dc:Bounds x="582" y="442" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_to_gw_di" bpmnElement="flow_to_gw">
        <di:waypoint x="188" y="278" />
        <di:waypoint x="245" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_myList_di" bpmnElement="flow_myList">
        <di:waypoint x="270" y="235" />
        <di:waypoint x="270" y="140" />
        <di:waypoint x="400" y="140" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="315" y="123" width="48" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_myList_end_di" bpmnElement="flow_myList_end">
        <di:waypoint x="500" y="140" />
        <di:waypoint x="582" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_getDef_di" bpmnElement="flow_getDef">
        <di:waypoint x="270" y="285" />
        <di:waypoint x="270" y="300" />
        <di:waypoint x="400" y="300" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="315" y="268" width="48" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_getDef_end_di" bpmnElement="flow_getDef_end">
        <di:waypoint x="500" y="300" />
        <di:waypoint x="582" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_run_di" bpmnElement="flow_run">
        <di:waypoint x="270" y="285" />
        <di:waypoint x="270" y="460" />
        <di:waypoint x="400" y="460" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="315" y="268" width="24" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_run_end_di" bpmnElement="flow_run_end">
        <di:waypoint x="500" y="460" />
        <di:waypoint x="582" y="460" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
