<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_userQuery" targetNamespace="http://dongkuk.com/dmes/mcm" exporter="bpmn-tool" exporterVersion="1.3.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.15.0">
  <bpmn:process id="userQuery" name="맞춤 레포트 조회 서비스" isExecutable="true">
    <bpmn:documentation>맞춤 레포트 조회 화면(cmq/userQuery) — 내 쿼리 목록·정의·실행. 스펙 2026-10-10-user-query-program-design §4.2. 실행은 queryId 와 입력 값만 받고 할당을 DB 에서 다시 확인한다. 응답에 SQL 을 싣지 않는다.</bpmn:documentation>
    <bpmn:startEvent id="start">
      <bpmn:outgoing>flow_to_gw</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="actionGateway">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="input" value="action" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_to_gw</bpmn:incoming>
      <bpmn:outgoing>flow_myList</bpmn:outgoing>
      <bpmn:outgoing>flow_getDef</bpmn:outgoing>
      <bpmn:outgoing>flow_run</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="myListTask" name="내 쿼리 목록" camunda:class="userQueryService">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="myList" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mcm.userq.dto.UserQueryRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_myList</bpmn:incoming>
      <bpmn:outgoing>flow_myList_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="endMyList">
      <bpmn:incoming>flow_myList_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="getDefTask" name="쿼리 정의 조회" camunda:class="userQueryService">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="getDef" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mcm.userq.dto.UserQueryRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_getDef</bpmn:incoming>
      <bpmn:outgoing>flow_getDef_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="endGetDef">
      <bpmn:incoming>flow_getDef_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="runTask" name="쿼리 실행" camunda:class="userQueryService">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="run" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mcm.userq.dto.UserQueryRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_run</bpmn:incoming>
      <bpmn:outgoing>flow_run_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="endRun">
      <bpmn:incoming>flow_run_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_to_gw" sourceRef="start" targetRef="actionGateway" />
    <bpmn:sequenceFlow id="flow_myList" name="myList" sourceRef="actionGateway" targetRef="myListTask" />
    <bpmn:sequenceFlow id="flow_myList_end" sourceRef="myListTask" targetRef="endMyList" />
    <bpmn:sequenceFlow id="flow_getDef" name="getDef" sourceRef="actionGateway" targetRef="getDefTask" />
    <bpmn:sequenceFlow id="flow_getDef_end" sourceRef="getDefTask" targetRef="endGetDef" />
    <bpmn:sequenceFlow id="flow_run" name="run" sourceRef="actionGateway" targetRef="runTask" />
    <bpmn:sequenceFlow id="flow_run_end" sourceRef="runTask" targetRef="endRun" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="userQuery">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="152" y="260" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="actionGateway_di" bpmnElement="actionGateway" isMarkerVisible="true">
        <dc:Bounds x="245" y="235" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="myListTask_di" bpmnElement="myListTask">
        <dc:Bounds x="400" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endMyList_di" bpmnElement="endMyList">
        <dc:Bounds x="582" y="122" width="36" height="36" />
