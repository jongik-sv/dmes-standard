<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="widgetMemoDefinitions" targetNamespace="http://dongkuk.com/dmes/mcm" exporter="bpmn-tool" exporterVersion="1.3.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.15.0">
  <bpmn:process id="widgetMemo" name="메모장 위젯 서비스" isExecutable="true">
    <bpmn:documentation>포털 홈 메모장 위젯의 개인 메모 — 스펙 2026-10-02-widget-admin-generic §17.3. 본인 메모라 AUTH_ONLY(widgetMemo/*). action: load(조회) · save(저장).</bpmn:documentation>
    <bpmn:startEvent id="start">
      <bpmn:outgoing>flow_to_gw</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="actionGateway">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="input" value="action" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_to_gw</bpmn:incoming>
      <bpmn:outgoing>flow_load</bpmn:outgoing>
      <bpmn:outgoing>flow_save</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="loadTask" name="메모 조회" camunda:class="widgetMemoService">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="load" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mcm.widget.memo.dto.WidgetMemoRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_load</bpmn:incoming>
      <bpmn:outgoing>flow_load_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="saveTask" name="메모 저장" camunda:class="widgetMemoService">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="save" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mcm.widget.memo.dto.WidgetMemoRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_save</bpmn:incoming>
      <bpmn:outgoing>flow_save_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="endLoad">
      <bpmn:incoming>flow_load_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="endSave">
      <bpmn:incoming>flow_save_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_to_gw" sourceRef="start" targetRef="actionGateway" />
    <bpmn:sequenceFlow id="flow_load" name="load" sourceRef="actionGateway" targetRef="loadTask" />
    <bpmn:sequenceFlow id="flow_save" name="save" sourceRef="actionGateway" targetRef="saveTask" />
    <bpmn:sequenceFlow id="flow_load_end" sourceRef="loadTask" targetRef="endLoad" />
    <bpmn:sequenceFlow id="flow_save_end" sourceRef="saveTask" targetRef="endSave" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="widgetMemo">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="180" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="actionGateway_di" bpmnElement="actionGateway" isMarkerVisible="true">
        <dc:Bounds x="270" y="175" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="loadTask_di" bpmnElement="loadTask">
        <dc:Bounds x="400" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="saveTask_di" bpmnElement="saveTask">
        <dc:Bounds x="400" y="230" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endLoad_di" bpmnElement="endLoad">
        <dc:Bounds x="580" y="112" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endSave_di" bpmnElement="endSave">
        <dc:Bounds x="580" y="252" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_to_gw_di" bpmnElement="flow_to_gw">
        <di:waypoint x="216" y="200" />
        <di:waypoint x="270" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_load_di" bpmnElement="flow_load">
        <di:waypoint x="295" y="175" />
        <di:waypoint x="295" y="130" />
        <di:waypoint x="400" y="130" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="327.5" y="113" width="32" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_save_di" bpmnElement="flow_save">
        <di:waypoint x="295" y="225" />
        <di:waypoint x="295" y="270" />
        <di:waypoint x="400" y="270" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="327.5" y="208" width="32" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_load_end_di" bpmnElement="flow_load_end">
        <di:waypoint x="500" y="130" />
        <di:waypoint x="580" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_save_end_di" bpmnElement="flow_save_end">
        <di:waypoint x="500" y="270" />
        <di:waypoint x="580" y="270" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

