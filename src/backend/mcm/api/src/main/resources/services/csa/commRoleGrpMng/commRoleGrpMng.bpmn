<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  id="Definitions_commRoleGrpMng"
                  targetNamespace="http://bpmn.io/schema/bpmn">

  <!--
    역할 그룹 관리 — commRoleGrpMng BPMN (csa 그룹 / mcm 모듈 / W4)

    분석리포트 §8 + BPMN설계서 §2 의 As-Is 7 action 보존 (To-Be 6 — 정책 #1 / BIZ SYSTEM 콤보 폐기 → lov 자동 해소):
      As-Is 7 → To-Be 6:
        - searchCmRoleGrp     — 역할 그룹 메인 그리드 조회 (selectCommRoleGrp + USER_ID scalar subquery)
        - saveCmRoleGrp       — 역할 그룹 일괄 저장 (insertCommRoleGrp / updateCommRoleGrp / deleteCommRoleGrp status 자동 분기)
        - searchCmRoleGrpMap  — 선택 역할 그룹의 매핑 역할 조회 (2-table JOIN + PARENT_ROLE_ID — Q-010 해소)
        - saveCmRoleGrpMap    — 매핑 일괄 저장 (insertCommRoleGrpMap / deleteCommRoleGrpMap — UPDATE ✗ / 더미 DUAL 폐기)
        - searchCmRole        — 미매핑 전체 역할 조회 (selectCommRole NOT EXISTS — 후보 풀 + PARENT_ROLE_ID)
        - searchCmRoleGrpMenu — 매핑 역할이 보유한 메뉴 트리 조회 (selectMenuObjTree — Oracle CTE+CONNECT BY → MSSQL WITH RECURSIVE 변환)
        ~~- lov               — BIZ SYSTEM 콤보 LoV (CommObjMngMapper.selectAppHostId 외부 namespace) — 정책 #1 폐기~~

    As-Is 결함 To-Be 정정 (BPMN §6.1):
      - process id:   As-Is "CommRoleGrpMng" → To-Be "commRoleGrpMng" (camelCase)
      - process name: As-Is "부모역할 부여 조회" (오기재 — 다른 화면명 복붙) → To-Be "역할 그룹 관리" (Q-011 해소)

    OASIS executor 가 actionGateway 의 input='action' 으로 분기. serviceTask 별
    Spring bean 'commRoleGrpMngService' 의 method 호출 → 결과 Map 을 process variable 로 누적.

    가이드 §6-C/D/E 정합 (W1·W2·W3 정본 패턴):
      - grid property 사용 ✗ (saveCmRoleGrp / saveCmRoleGrpMap 는 grids.master.rows → method param `master` 자동 매핑)
      - output="result" 명시 (응답 누락 결함 회피 — 가이드 §6-D)
      - dto property: searchCmRoleGrp / searchCmRoleGrpMap / searchCmRole / searchCmRoleGrpMenu 4 action
      - <conditionExpression> 미사용 — sequenceFlow `name` 만으로 분기
  -->

  <bpmn:process id="commRoleGrpMng" name="역할 그룹 관리" isExecutable="true">

    <bpmn:startEvent id="start">
      <bpmn:outgoing>flow_to_gw</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="flow_to_gw" sourceRef="start" targetRef="actionGateway" />

    <bpmn:exclusiveGateway id="actionGateway">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="input" value="action" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_to_gw</bpmn:incoming>
      <bpmn:outgoing>flow_searchCmRoleGrp</bpmn:outgoing>
      <bpmn:outgoing>flow_saveCmRoleGrp</bpmn:outgoing>
      <bpmn:outgoing>flow_searchCmRoleGrpMap</bpmn:outgoing>
      <bpmn:outgoing>flow_saveCmRoleGrpMap</bpmn:outgoing>
      <bpmn:outgoing>flow_searchCmRole</bpmn:outgoing>
      <bpmn:outgoing>flow_searchCmRoleGrpMenu</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- ─────────── action: searchCmRoleGrp — 역할 그룹 메인 그리드 조회 ─────────── -->
    <bpmn:sequenceFlow id="flow_searchCmRoleGrp" name="search" sourceRef="actionGateway" targetRef="searchCmRoleGrpTask" />
    <bpmn:serviceTask id="searchCmRoleGrpTask" name="역할 그룹 조회" camunda:class="commRoleGrpMngService">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="searchCmRoleGrp" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mcm.csa.commRoleGrpMng.dto.CommRoleGrpMngSearchRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_searchCmRoleGrp</bpmn:incoming>
      <bpmn:outgoing>flow_searchCmRoleGrp_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="flow_searchCmRoleGrp_end" sourceRef="searchCmRoleGrpTask" targetRef="endSearchCmRoleGrp" />
    <bpmn:endEvent id="endSearchCmRoleGrp">
      <bpmn:incoming>flow_searchCmRoleGrp_end</bpmn:incoming>
    </bpmn:endEvent>

    <!-- ─────────── action: saveCmRoleGrp — input grid: grids.master.rows → method param `master` ─────────── -->
    <bpmn:sequenceFlow id="flow_saveCmRoleGrp" name="save" sourceRef="actionGateway" targetRef="saveCmRoleGrpTask" />
    <bpmn:serviceTask id="saveCmRoleGrpTask" name="역할 그룹 저장 (status 분기) + 후속 재조회" camunda:class="commRoleGrpMngService">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="saveCmRoleGrp" />
          <camunda:property name="output" value="result" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_saveCmRoleGrp</bpmn:incoming>
      <bpmn:outgoing>flow_saveCmRoleGrp_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="flow_saveCmRoleGrp_end" sourceRef="saveCmRoleGrpTask" targetRef="endSaveCmRoleGrp" />
    <bpmn:endEvent id="endSaveCmRoleGrp">
      <bpmn:incoming>flow_saveCmRoleGrp_end</bpmn:incoming>
    </bpmn:endEvent>

    <!-- ─────────── action: searchCmRoleGrpMap — 선택 역할 그룹의 매핑 역할 조회 (2-table JOIN + PARENT_ROLE_ID) ─────────── -->
    <bpmn:sequenceFlow id="flow_searchCmRoleGrpMap" name="searchCmRoleGrpMap" sourceRef="actionGateway" targetRef="searchCmRoleGrpMapTask" />
    <bpmn:serviceTask id="searchCmRoleGrpMapTask" name="역할 그룹 부여 조회 (2-table JOIN)" camunda:class="commRoleGrpMngService">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="searchCmRoleGrpMap" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mcm.csa.commRoleGrpMng.dto.CommRoleGrpMngSearchMapRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_searchCmRoleGrpMap</bpmn:incoming>
      <bpmn:outgoing>flow_searchCmRoleGrpMap_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="flow_searchCmRoleGrpMap_end" sourceRef="searchCmRoleGrpMapTask" targetRef="endSearchCmRoleGrpMap" />
    <bpmn:endEvent id="endSearchCmRoleGrpMap">
      <bpmn:incoming>flow_searchCmRoleGrpMap_end</bpmn:incoming>
    </bpmn:endEvent>

    <!-- ─────────── action: saveCmRoleGrpMap — INSERT/DELETE 분기 (UPDATE ✗ / 더미 DUAL 폐기) ─────────── -->
    <bpmn:sequenceFlow id="flow_saveCmRoleGrpMap" name="saveCmRoleGrpMap" sourceRef="actionGateway" targetRef="saveCmRoleGrpMapTask" />
    <bpmn:serviceTask id="saveCmRoleGrpMapTask" name="역할 그룹 부여 저장 (INSERT/DELETE) + 후속 재조회" camunda:class="commRoleGrpMngService">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="saveCmRoleGrpMap" />
          <camunda:property name="output" value="result" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_saveCmRoleGrpMap</bpmn:incoming>
      <bpmn:outgoing>flow_saveCmRoleGrpMap_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="flow_saveCmRoleGrpMap_end" sourceRef="saveCmRoleGrpMapTask" targetRef="endSaveCmRoleGrpMap" />
    <bpmn:endEvent id="endSaveCmRoleGrpMap">
      <bpmn:incoming>flow_saveCmRoleGrpMap_end</bpmn:incoming>
    </bpmn:endEvent>

    <!-- ─────────── action: searchCmRole — 미매핑 전체 역할 조회 (NOT EXISTS + PARENT_ROLE_ID) ─────────── -->
    <bpmn:sequenceFlow id="flow_searchCmRole" name="searchCmRole" sourceRef="actionGateway" targetRef="searchCmRoleTask" />
    <bpmn:serviceTask id="searchCmRoleTask" name="역할 조회 (NOT EXISTS)" camunda:class="commRoleGrpMngService">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="searchCmRole" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mcm.csa.commRoleGrpMng.dto.CommRoleGrpMngSearchMapRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_searchCmRole</bpmn:incoming>
      <bpmn:outgoing>flow_searchCmRole_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="flow_searchCmRole_end" sourceRef="searchCmRoleTask" targetRef="endSearchCmRole" />
    <bpmn:endEvent id="endSearchCmRole">
      <bpmn:incoming>flow_searchCmRole_end</bpmn:incoming>
    </bpmn:endEvent>

    <!-- ─────────── action: searchCmRoleGrpMenu — 매핑 역할 보유 메뉴 트리 조회 (CTE 변환) ─────────── -->
    <bpmn:sequenceFlow id="flow_searchCmRoleGrpMenu" name="searchCmRoleGrpMenu" sourceRef="actionGateway" targetRef="searchCmRoleGrpMenuTask" />
    <bpmn:serviceTask id="searchCmRoleGrpMenuTask" name="역할 그룹 메뉴 조회 (CTE)" camunda:class="commRoleGrpMngService">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="searchCmRoleGrpMenu" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mcm.csa.commRoleGrpMng.dto.CommRoleGrpMngSearchMapRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_searchCmRoleGrpMenu</bpmn:incoming>
      <bpmn:outgoing>flow_searchCmRoleGrpMenu_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="flow_searchCmRoleGrpMenu_end" sourceRef="searchCmRoleGrpMenuTask" targetRef="endSearchCmRoleGrpMenu" />
    <bpmn:endEvent id="endSearchCmRoleGrpMenu">
      <bpmn:incoming>flow_searchCmRoleGrpMenu_end</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="commRoleGrpMng">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="152" y="482" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="actionGateway_di" bpmnElement="actionGateway" isMarkerVisible="true">
        <dc:Bounds x="245" y="475" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="searchCmRoleGrpTask_di" bpmnElement="searchCmRoleGrpTask">
        <dc:Bounds x="370" y="40" width="220" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endSearchCmRoleGrp_di" bpmnElement="endSearchCmRoleGrp">
        <dc:Bounds x="640" y="62" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="saveCmRoleGrpTask_di" bpmnElement="saveCmRoleGrpTask">
        <dc:Bounds x="370" y="200" width="220" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endSaveCmRoleGrp_di" bpmnElement="endSaveCmRoleGrp">
        <dc:Bounds x="640" y="222" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="searchCmRoleGrpMapTask_di" bpmnElement="searchCmRoleGrpMapTask">
        <dc:Bounds x="370" y="360" width="220" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endSearchCmRoleGrpMap_di" bpmnElement="endSearchCmRoleGrpMap">
        <dc:Bounds x="640" y="382" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="saveCmRoleGrpMapTask_di" bpmnElement="saveCmRoleGrpMapTask">
        <dc:Bounds x="370" y="460" width="220" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endSaveCmRoleGrpMap_di" bpmnElement="endSaveCmRoleGrpMap">
        <dc:Bounds x="640" y="482" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="searchCmRoleTask_di" bpmnElement="searchCmRoleTask">
        <dc:Bounds x="370" y="620" width="220" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endSearchCmRole_di" bpmnElement="endSearchCmRole">
        <dc:Bounds x="640" y="642" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="searchCmRoleGrpMenuTask_di" bpmnElement="searchCmRoleGrpMenuTask">
        <dc:Bounds x="370" y="780" width="220" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endSearchCmRoleGrpMenu_di" bpmnElement="endSearchCmRoleGrpMenu">
        <dc:Bounds x="640" y="802" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_to_gw_di" bpmnElement="flow_to_gw">
        <di:waypoint x="188" y="500" />
        <di:waypoint x="245" y="500" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_searchCmRoleGrp_di" bpmnElement="flow_searchCmRoleGrp">
        <di:waypoint x="270" y="475" />
        <di:waypoint x="270" y="80" />
        <di:waypoint x="370" y="80" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_searchCmRoleGrp_end_di" bpmnElement="flow_searchCmRoleGrp_end">
        <di:waypoint x="590" y="80" />
        <di:waypoint x="640" y="80" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_saveCmRoleGrp_di" bpmnElement="flow_saveCmRoleGrp">
        <di:waypoint x="270" y="475" />
        <di:waypoint x="270" y="240" />
        <di:waypoint x="370" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_saveCmRoleGrp_end_di" bpmnElement="flow_saveCmRoleGrp_end">
        <di:waypoint x="590" y="240" />
        <di:waypoint x="640" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_searchCmRoleGrpMap_di" bpmnElement="flow_searchCmRoleGrpMap">
        <di:waypoint x="270" y="475" />
        <di:waypoint x="270" y="400" />
        <di:waypoint x="370" y="400" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_searchCmRoleGrpMap_end_di" bpmnElement="flow_searchCmRoleGrpMap_end">
        <di:waypoint x="590" y="400" />
        <di:waypoint x="640" y="400" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_saveCmRoleGrpMap_di" bpmnElement="flow_saveCmRoleGrpMap">
        <di:waypoint x="295" y="500" />
        <di:waypoint x="370" y="500" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_saveCmRoleGrpMap_end_di" bpmnElement="flow_saveCmRoleGrpMap_end">
