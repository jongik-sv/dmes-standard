{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dmes.dongkuk.local/mdm/engine-contract.schema.json",
  "title": "EngineContract",
  "description": "정본 위치 = 이 파일(TSK-03-01). 원본 초안은 docs/mdm/engine-contract/schema/. 서버 엔진(Java)과 화면 JS 평가기(TS)가 주고받는 JSON 모양의 정본. Java record·TS 타입은 이 스키마에서 나온다(엔진 EngineContractSchemaTest 가 Java 를, m-mdm 생성 스크립트가 TS 를 맞춘다). 숫자는 전부 문자열이다(06:1038).",
  "$defs": {
    "AstNode": {
      "description": "EvalEx AST 노드(evalex-guide §8.3). 자식이 없으면 params 키를 뺀다. 설정이 허용하는 여섯 종류만 나온다(design D1).",
      "oneOf": [
        { "$ref": "#/$defs/AstNumberLiteral" },
        { "$ref": "#/$defs/AstStringLiteral" },
        { "$ref": "#/$defs/AstVariable" },
        { "$ref": "#/$defs/AstPrefix" },
        { "$ref": "#/$defs/AstInfix" },
        { "$ref": "#/$defs/AstFunction" }
      ]
    },
    "AstNumberLiteral": {
      "type": "object",
      "properties": {
        "type": { "const": "NUMBER_LITERAL" },
        "value": { "type": "string", "pattern": "^(0[xX][0-9A-Fa-f]+|([0-9]+(\\.[0-9]*)?|\\.[0-9]+)([eE][+-]?[0-9]+)?)$" }
      },
      "required": ["type", "value"],
      "additionalProperties": false
    },
    "AstStringLiteral": {
      "type": "object",
      "properties": {
        "type": { "const": "STRING_LITERAL" },
        "value": { "type": "string" }
      },
      "required": ["type", "value"],
      "additionalProperties": false
    },
    "AstVariable": {
      "description": "변수 또는 상수(TRUE/FALSE/NULL/PI/E …). 상수가 변수보다 먼저다(evalex-guide §8.3).",
      "type": "object",
      "properties": {
        "type": { "const": "VARIABLE_OR_CONSTANT" },
        "value": { "type": "string", "pattern": "^[^0-9\\s][^\\s]*$" }
      },
      "required": ["type", "value"],
      "additionalProperties": false
    },
    "AstPrefix": {
      "type": "object",
      "properties": {
        "type": { "const": "PREFIX_OPERATOR" },
        "value": { "$ref": "#/$defs/PrefixOperator" },
        "params": { "type": "array", "items": { "$ref": "#/$defs/AstNode" }, "minItems": 1, "maxItems": 1 }
      },
      "required": ["type", "value", "params"],
      "additionalProperties": false
    },
    "AstInfix": {
      "type": "object",
      "properties": {
        "type": { "const": "INFIX_OPERATOR" },
        "value": { "$ref": "#/$defs/InfixOperator" },
        "params": { "type": "array", "items": { "$ref": "#/$defs/AstNode" }, "minItems": 2, "maxItems": 2 }
      },
      "required": ["type", "value", "params"],
      "additionalProperties": false
    },
    "PrefixOperator": { "description": "전위 연산자(Java AstNode.PREFIX_OPERATORS).", "enum": ["-", "+", "!"] },
    "InfixOperator": {
      "description": "EvalEx 3.7.0 표준 중위 연산자(evalex-guide §2, Java AstNode.INFIX_OPERATORS).",
      "enum": ["+", "-", "*", "/", "%", "^", "=", "==", "!=", "<>", "<", "<=", ">", ">=", "&&", "||"]
    },
    "AstFunction": {
      "type": "object",
      "properties": {
        "type": { "const": "FUNCTION" },
        "value": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "params": { "type": "array", "items": { "$ref": "#/$defs/AstNode" }, "minItems": 1 }
      },
      "required": ["type", "value"],
      "additionalProperties": false
    },

    "DataType": { "enum": ["NUMBER", "STRING", "BOOLEAN", "DATE"] },

    "TypedValue": {
      "description": "타입을 붙인 값. NUMBER 는 십진 문자열이고 값으로 견준다(1.10 == 1.1). NULL 은 value 가 없다. LIST 는 COLLECT LIST 결과.",
      "oneOf": [
        {
          "type": "object",
          "properties": { "type": { "enum": ["NUMBER"] }, "value": { "type": "string", "pattern": "^-?([0-9]+(\\.[0-9]*)?|\\.[0-9]+)$" } },
          "required": ["type", "value"], "additionalProperties": false
        },
        {
          "type": "object",
          "properties": { "type": { "enum": ["STRING"] }, "value": { "type": "string" } },
          "required": ["type", "value"], "additionalProperties": false
        },
        {
          "type": "object",
          "properties": { "type": { "enum": ["BOOLEAN"] }, "value": { "enum": ["true", "false"] } },
          "required": ["type", "value"], "additionalProperties": false
        },
        {
          "type": "object",
          "properties": { "type": { "enum": ["NULL"] } },
          "required": ["type"], "additionalProperties": false
        },
        {
          "type": "object",
          "properties": { "type": { "enum": ["LIST"] }, "items": { "type": "array", "items": { "$ref": "#/$defs/TypedValue" } } },
          "required": ["type", "items"], "additionalProperties": false
        }
      ]
    },

    "CellOp": {
      "enum": ["NA", "EQ", "NE", "LT", "LE", "GT", "GE", "IN", "NOT_IN", "CODE_IN", "CONTAINS", "INSTR", "IS_NULL", "NOT_NULL",
               "<= 변수 <=", "<= 변수 <", "< 변수 <=", "< 변수 <"]
    },
    "NoValueOp": { "description": "값 없는 op(CellOp 의 한 묶음).", "enum": ["NA", "IS_NULL", "NOT_NULL"] },
    "SingleValueOp": { "description": "left 하나를 쓰는 op(CellOp 의 한 묶음).", "enum": ["EQ", "NE", "LT", "LE", "GT", "GE", "CODE_IN", "CONTAINS", "INSTR"] },
    "ListOp": { "description": "list 를 쓰는 op(CellOp 의 한 묶음).", "enum": ["IN", "NOT_IN"] },
    "RangeOp": { "description": "left·right 를 쓰는 범위 op(CellOp 의 한 묶음).", "enum": ["<= 변수 <=", "<= 변수 <", "< 변수 <=", "< 변수 <"] },
    "CellJson": {
      "description": "룰 셀(06:1036-1054). 키는 일곱뿐이고 값은 전부 문자열. op 에 따라 쓰는 키가 정해진다.",
      "oneOf": [
        {
          "type": "object",
          "properties": { "op": { "$ref": "#/$defs/NoValueOp" } },
          "required": ["op"], "additionalProperties": false
        },
        {
          "type": "object",
          "properties": { "op": { "$ref": "#/$defs/SingleValueOp" }, "left": { "type": "string", "minLength": 1 } },
          "required": ["op", "left"], "additionalProperties": false
        },
        {
          "type": "object",
          "properties": { "op": { "$ref": "#/$defs/ListOp" }, "list": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true } },
          "required": ["op", "list"], "additionalProperties": false
        },
        {
          "type": "object",
          "properties": { "op": { "$ref": "#/$defs/RangeOp" }, "left": { "type": "string", "minLength": 1 }, "right": { "type": "string", "minLength": 1 } },
          "required": ["op", "left", "right"], "additionalProperties": false
        },
        {
          "type": "object",
          "properties": { "expr": { "type": "string", "minLength": 1 }, "ast": { "$ref": "#/$defs/AstNode" } },
          "required": ["expr", "ast"], "additionalProperties": false
        },
        {
          "type": "object",
          "properties": { "val": { "type": "string" } },
          "required": ["val"], "additionalProperties": false
        }
      ]
    },

    "ErrorCode": {
      "description": "판정 오류 코드(Java EngineEvaluationException.Code 와 같은 이름).",
      "enum": ["RULE_NOT_FOUND", "SET_NOT_FOUND", "SET_DEPRECATED", "MISSING_KEY", "REQUIRED_NULL", "TYPE_CONVERSION",
               "CONSTANT_KEY", "RESERVED_KEY", "EVAL_TS_KEY", "UNIQUE_MULTIPLE_HITS", "ANY_CONFLICT", "EVALUATION_ERROR",
               "BRANCH_EVAL_ERROR", "FLOW_INVALID", "EDIT_POINT_MISMATCH"]
    },

    "CorpusFile": {
      "description": "서버·화면 정합성 코퍼스(06:284-296, evalex-guide §8.5 2항). 양쪽 러너(JUnit·Vitest)가 같은 파일을 읽는다.",
      "type": "object",
      "properties": {
        "version": { "const": 1 },
        "cases": { "type": "array", "items": { "$ref": "#/$defs/CorpusCase" }, "minItems": 1 }
      },
      "required": ["version", "cases"],
      "additionalProperties": false
    },
    "CorpusCase": { "oneOf": [ { "$ref": "#/$defs/ExprCase" }, { "$ref": "#/$defs/CellCase" } ] },
    "ExprCase": {
      "description": "자유 식 — 서버는 expr 을 EvalEx 로, 화면은 ast 를 인터프리터로 평가한다.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "kind": { "const": "expr" },
        "slot": { "$ref": "#/$defs/ExprSlot" },
        "expr": { "type": "string", "minLength": 1 },
        "ast": { "$ref": "#/$defs/AstNode" },
        "vars": { "type": "object", "additionalProperties": { "$ref": "#/$defs/TypedValue" } },
        "evalTs": { "$ref": "#/$defs/LocalDateTime" },
        "codeSets": { "$ref": "#/$defs/CodeSets" },
        "expect": { "$ref": "#/$defs/Expect" }
      },
      "required": ["id", "kind", "expr", "ast", "vars", "expect"],
      "additionalProperties": false
    },
    "ExprSlot": {
      "description": "식 칸(Java FunctionSets.Slot). 칸이 허용 함수 집합과 변수 제한을 정한다.",
      "enum": ["DOMAIN_STD", "DOMAIN_BIZ", "RULE_COND_EXPR", "RULE_RESULT_EXPR", "RULE_EXPR_VAR", "RULE_GRP_COND"]
    },
    "CellCase": {
      "description": "op-code 셀 — 서버는 생성 텍스트를 EvalEx 로, 화면은 셀 구조를 직접 견준다(06:271·284).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "kind": { "const": "cell" },
        "variable": {
          "type": "object",
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "dataType": { "enum": ["NUMBER", "STRING", "BOOLEAN"] },
            "dateString": { "type": "boolean", "description": "일자 String(YYYYMMDD·YYYYMM·YYYY) 도메인" },
            "maruCodeId": { "type": "string", "description": "코드 도메인 변수의 마루 코드(CODE_IN 용)" }
          },
          "required": ["name", "dataType"],
          "additionalProperties": false
        },
        "cell": { "$ref": "#/$defs/CellJson" },
        "patternRegex": { "type": "string", "description": "= 패턴이 정규식형일 때 서버가 저장 응답으로 준 정규식(06:267)" },
        "value": { "$ref": "#/$defs/TypedValue" },
        "evalTs": { "$ref": "#/$defs/LocalDateTime" },
        "codeSets": { "$ref": "#/$defs/CodeSets" },
        "expect": { "$ref": "#/$defs/Expect" }
      },
      "required": ["id", "kind", "variable", "cell", "value", "expect"],
      "additionalProperties": false
    },
    "CodeSets": {
      "description": "화면이 받아 둔 카테고리 코드 집합. 키는 '마루코드ID|카테고리ID'. 서버 러너는 키마다 가짜 사본을 합성한다 — CodeLookup(헤더 INUSE, RELEASED 버전 1.000 하나를 전 기간 열어 두고 집합의 코드를 ITEM 행으로)과 CodeEffLookup(id, 1.000, cate → 집합). 없는 id 는 마루 데이터 대상(MasterLookup.NONE)이다(design §6.10).",
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z0-9_]+\\|[A-Za-z0-9_]+$" },
      "additionalProperties": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
    },
    "Expect": {
      "description": "기대 결과. value 또는 error 중 하나. screenFallback=true 면 화면은 isSupported=false 로 폴백해야 하고 서버 결과만 견준다.",
      "oneOf": [
        {
          "type": "object",
          "properties": { "value": { "$ref": "#/$defs/TypedValue" }, "screenFallback": { "type": "boolean" } },
          "required": ["value"], "additionalProperties": false
        },
        {
          "type": "object",
          "properties": { "error": { "$ref": "#/$defs/ErrorCode" }, "screenFallback": { "type": "boolean" } },
          "required": ["error"], "additionalProperties": false
        }
      ]
    },
    "LocalDateTime": {
      "description": "KST 벽시계 초 단위(naming-dialect-rules §3 #16).",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}$"
    },

    "VarType": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "dataType": { "$ref": "#/$defs/DataType" },
        "scale": { "type": ["integer", "null"] },
        "domainId": { "type": ["string", "null"] }
      },
      "required": ["name", "dataType"],
      "additionalProperties": false
    },
    "InputContract": {
      "description": "입력 계약(06:202-230). 스냅샷에 실리고 정의 조회 CONTRACT 로도 나간다.",
      "type": "object",
      "properties": {
        "always": { "type": "array", "items": { "$ref": "#/$defs/VarType" } },
        "rows": { "type": "array", "items": { "$ref": "#/$defs/RowContract" } }
      },
      "required": ["always", "rows"],
      "additionalProperties": false
    },
    "RowContract": {
      "description": "행마다 필요한 입력(06:202-230).",
      "type": "object",
      "properties": {
        "rowId": { "type": "integer" },
        "cond": { "type": "string" },
        "required": { "type": "array", "items": { "$ref": "#/$defs/VarType" } },
        "optional": { "type": "array", "items": { "$ref": "#/$defs/VarType" } }
      },
      "required": ["rowId", "cond", "required", "optional"],
      "additionalProperties": false
    },

    "RuleResult": {
      "description": "룰 판정 결과(Java RuleResult 의 JSON 모양). 값 테스트 API·판정 서비스 응답.",
      "type": "object",
      "properties": {
        "ruleId": { "type": "string" },
        "ver": { "type": "integer" },
        "evalTs": { "$ref": "#/$defs/LocalDateTime" },
        "hits": { "type": "array", "items": { "$ref": "#/$defs/RuleHit" } },
        "defaultApplied": { "type": "boolean" },
        "results": { "type": "object", "additionalProperties": { "$ref": "#/$defs/TypedValue" } },
        "trace": { "type": "array", "items": { "$ref": "#/$defs/RowTrace" } },
        "warnings": { "type": "array", "items": { "$ref": "#/$defs/EngineWarning" } }
      },
      "required": ["ruleId", "ver", "evalTs", "hits", "defaultApplied", "results", "trace", "warnings"],
      "additionalProperties": false
    },
    "RuleHit": {
      "description": "적중 행(Java RuleResult.Hit). groupChoices 는 res_grp → 고른 열의 var_id, 고른 열이 없으면 null(06:69).",
      "type": "object",
      "properties": {
        "rowId": { "type": "integer" },
        "seq": { "type": "integer" },
        "groupChoices": { "type": "object", "additionalProperties": { "type": ["integer", "null"] } }
      },
      "required": ["rowId", "seq", "groupChoices"],
      "additionalProperties": false
    },
    "RowTrace": {
      "description": "평가한 행마다 적중 여부와 첫 거짓 셀(Java RuleResult.RowTrace, 06:319).",
      "type": "object",
      "properties": {
        "rowId": { "type": "integer" },
        "seq": { "type": "integer" },
        "evaluated": { "type": "boolean" },
        "hit": { "type": "boolean" },
        "firstFalseVarId": { "type": ["integer", "null"] }
      },
      "required": ["rowId", "seq", "evaluated", "hit", "firstFalseVarId"],
      "additionalProperties": false
    },
    "EngineWarning": {
      "description": "판정을 멈추지 않는 경고(Java EngineWarning, 06:200·425·427).",
      "type": "object",
      "properties": {
        "code": { "$ref": "#/$defs/EngineWarningCode" },
        "ruleId": { "type": ["string", "null"] },
        "rowId": { "type": ["integer", "null"] },
        "varId": { "type": ["integer", "null"] },
        "message": { "type": "string" }
      },
      "required": ["code", "message"],
      "additionalProperties": false
    },
    "EngineWarningCode": { "description": "경고 코드(Java EngineWarning.Code).", "enum": ["EXPR_CELL_NULL", "GRP_COND_NULL", "BRANCH_COND_NULL"] },
    "RuleSetResult": {
      "description": "룰 세트 판정 결과(Java RuleSetResult, 06:429 + 룰 세트 흐름도 spec §4.1). steps 는 실행한 룰마다 결과, finalValues 는 마지막 룰 뒤 결과 변수 전체, path 는 방문한 노드, warnings 는 세트 경고(BRANCH_COND_NULL).",
      "type": "object",
      "properties": {
        "setId": { "type": "string" },
        "evalTs": { "$ref": "#/$defs/LocalDateTime" },
        "steps": { "type": "array", "items": { "$ref": "#/$defs/RuleResult" } },
        "finalValues": { "type": "object", "additionalProperties": { "$ref": "#/$defs/TypedValue" } },
        "path": { "type": "array", "items": { "$ref": "#/$defs/PathStep" } },
        "warnings": { "type": "array", "items": { "$ref": "#/$defs/EngineWarning" } }
      },
      "required": ["setId", "evalTs", "steps", "finalValues", "path", "warnings"],
      "additionalProperties": false
    },
    "PathStep": {
      "description": "세트에서 방문한 노드 하나(Java RuleSetResult.PathStep). chosenEdgeId 는 IF 에서 고른 선, stepIndex 는 RULE 결과의 steps 자리.",
      "type": "object",
      "properties": {
        "nodeId": { "type": "string" },
        "kind": { "$ref": "#/$defs/FlowNodeKind" },
        "chosenEdgeId": { "type": ["string", "null"] },
        "stepIndex": { "type": ["integer", "null"] }
      },
      "required": ["nodeId", "kind", "chosenEdgeId", "stepIndex"],
      "additionalProperties": false
    },
    "RunTrace": {
      "description": "룰 세트 실행 기록(Java RunTrace, 룰 세트 흐름도 spec §4.2). 판정 오류는 던지지 않고 violations 에 담는다. 실행 전 오류면 nodes 가 비었다. edits 는 디버거에서 고친 값을 끼워 다시 실행했을 때만 있고(4단계 spec §2.3), 없으면 키를 뺀다.",
      "type": "object",
      "properties": {
        "setId": { "type": "string" },
        "evalTs": { "$ref": "#/$defs/LocalDateTime" },
        "input": { "type": "object", "additionalProperties": { "$ref": "#/$defs/TypedValue" } },
        "nodes": { "type": "array", "items": { "$ref": "#/$defs/NodeTrace" } },
        "finalValues": { "type": "object", "additionalProperties": { "$ref": "#/$defs/TypedValue" } },
        "violations": { "type": ["array", "null"], "items": { "$ref": "#/$defs/Violation" } },
        "edits": { "type": "array", "items": { "$ref": "#/$defs/TraceEdit" } }
      },
      "required": ["setId", "evalTs", "input", "nodes", "finalValues", "violations"],
      "additionalProperties": false
    },
    "NodeTrace": {
      "description": "노드 하나의 기록(Java RunTrace.NodeTrace). RULE: ruleId·ver·reads·result, IF: branches·chosenEdgeId, PARALLEL: order, MERGE: splitId·merged, TASK: 칸 없이 status 만, ERROR: violations. result 는 OK 인 RULE 노드에만 있고, 값이 없으면 키를 뺀다(null 을 쓰지 않는다).",
      "type": "object",
      "properties": {
        "seq": { "type": "integer" },
        "nodeId": { "type": "string" },
        "kind": { "$ref": "#/$defs/FlowNodeKind" },
        "status": { "$ref": "#/$defs/NodeStatus" },
        "ruleId": { "type": ["string", "null"] },
        "ver": { "type": ["integer", "null"] },
        "reads": { "type": ["object", "null"], "additionalProperties": { "$ref": "#/$defs/TypedValue" } },
        "result": { "$ref": "#/$defs/RuleResult" },
        "branches": { "type": ["array", "null"], "items": { "$ref": "#/$defs/BranchTrace" } },
        "chosenEdgeId": { "type": ["string", "null"] },
        "order": { "type": ["array", "null"], "items": { "type": "string" } },
        "splitId": { "type": ["string", "null"] },
        "merged": { "type": ["array", "null"], "items": { "type": "string" } },
        "violations": { "type": ["array", "null"], "items": { "$ref": "#/$defs/Violation" } }
      },
      "required": ["seq", "nodeId", "kind", "status", "ruleId", "ver", "reads", "branches", "chosenEdgeId", "order", "splitId", "merged", "violations"],
      "additionalProperties": false
    },
    "BranchTrace": {
      "description": "IF 갈래 선 하나의 평가(Java RunTrace.BranchTrace). message 는 ERROR 원인.",
      "type": "object",
      "properties": {
        "edgeId": { "type": "string" },
        "outcome": { "$ref": "#/$defs/BranchOutcome" },
        "message": { "type": ["string", "null"] }
      },
      "required": ["edgeId", "outcome", "message"],
      "additionalProperties": false
    },
    "TraceEdit": {
      "description": "디버거에서 고친 값 하나(Java RunTrace.TraceEdit, 4단계 spec §2.2). beforeSeq 번째 노드(1부터, NodeTrace.seq 와 같은 수)를 시작하기 직전에 그 노드 범위의 ctx 에 values 를 넣는다. NULL 은 비우기, ctx 에 없던 이름은 추가다.",
      "type": "object",
      "properties": {
        "beforeSeq": { "type": "integer", "minimum": 1 },
        "nodeId": { "type": "string", "minLength": 1 },
        "values": { "type": "object", "additionalProperties": { "$ref": "#/$defs/TypedValue" } }
      },
      "required": ["beforeSeq", "nodeId", "values"],
      "additionalProperties": false
    },
    "NodeStatus": { "description": "노드 실행 상태(Java RunTrace.NodeStatus).", "enum": ["OK", "ERROR"] },
    "BranchOutcome": { "description": "IF 갈래 평가 결과(Java RunTrace.BranchOutcome). NOT_EVALUATED = 앞 갈래가 참이었거나 앞 갈래 평가가 오류로 멈춰 평가하지 않음. IF 의 branches 는 늘 나가는 선마다 하나씩, 실행 순서대로 있다.", "enum": ["TRUE", "FALSE", "NULL", "ERROR", "NOT_EVALUATED"] },
    "RuleSetFlow": {
      "description": "룰 세트 흐름 정의(Java DefinitionLookup.FlowDefinition, spec §3.3). TB_MDM_RULE_SET.FLOW_JSON 의 nodes·edges 이고 화면 전용 view 는 여기 없다.",
      "type": "object",
      "properties": {
        "version": { "type": "integer", "minimum": 1 },
        "nodes": { "type": "array", "items": { "$ref": "#/$defs/FlowNode" } },
        "edges": { "type": "array", "items": { "$ref": "#/$defs/FlowEdge" } }
      },
      "required": ["version", "nodes", "edges"],
      "additionalProperties": false
    },
    "FlowNode": {
      "description": "흐름 노드(Java DefinitionLookup.FlowNode). ruleId 는 RULE 만, splitId 는 MERGE 만 쓴다. TASK(빈 단계)는 label 만 쓰고 실행 때 그냥 지나간다.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "$ref": "#/$defs/FlowNodeKind" },
        "ruleId": { "type": ["string", "null"] },
        "splitId": { "type": ["string", "null"] },
        "label": { "type": ["string", "null"] }
      },
      "required": ["id", "kind", "ruleId", "splitId", "label"],
      "additionalProperties": false
    },
    "FlowEdge": {
      "description": "흐름 선(Java DefinitionLookup.FlowEdge). order·cond·otherwise 는 IF·PARALLEL 에서 나가는 선만 쓴다. otherwise=true 는 IF 의 \"그 외\" 선.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "from": { "type": "string" },
        "to": { "type": "string" },
        "order": { "type": ["integer", "null"] },
        "cond": { "type": ["string", "null"] },
        "otherwise": { "type": "boolean" },
        "label": { "type": ["string", "null"] }
      },
      "required": ["id", "from", "to", "order", "cond", "otherwise", "label"],
      "additionalProperties": false
    },
    "FlowNodeKind": { "description": "흐름 노드 종류(Java DefinitionLookup.NodeKind). TASK = 빈 단계(4단계 spec §1.1).", "enum": ["START", "END", "RULE", "TASK", "IF", "PARALLEL", "MERGE"] },
    "EngineError": {
      "description": "판정 오류 응답(Java EngineEvaluationException.violations 의 JSON 모양).",
      "type": "object",
      "properties": {
        "violations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Violation" } }
      },
      "required": ["violations"],
      "additionalProperties": false
    },
    "Violation": {
      "description": "판정 오류 하나(Java EngineEvaluationException.Violation). name 은 변수 이름 또는 함수 이름.",
      "type": "object",
      "properties": {
        "stage": { "$ref": "#/$defs/ViolationStage" },
        "code": { "$ref": "#/$defs/ErrorCode" },
        "ruleId": { "type": ["string", "null"] },
        "rowId": { "type": ["integer", "null"] },
        "name": { "type": ["string", "null"] },
        "message": { "type": "string" }
      },
      "required": ["stage", "code", "message"],
      "additionalProperties": false
    },
    "ViolationStage": {
      "description": "판정 단계(Java EngineEvaluationException.Stage, 06:212-217 + 세트 사전 검사 + IF 갈래 고르기).",
      "enum": ["SET_CHECK", "INPUT_CHECK", "ROW_SELECT", "RESULT_CHECK", "RESULT_EVAL", "BRANCH_SELECT"]
    }
  }
