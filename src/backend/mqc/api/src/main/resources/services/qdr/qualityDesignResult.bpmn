<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_qualityDesignResult" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-tool" exporterVersion="1.3.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.15.0">
  <bpmn:process id="qualityDesignResult" name="품질설계결과" isExecutable="true">
    <bpmn:documentation>qualityDesignResult — 주문 줄마다 Maru 룰 파이프라인(입력 검증·주문정합성·주문단중·생산가부·품질사양·설계값)으로 설계값을 계산해 저장하고(calculate) 확정(confirm)·보류 토글(cancel)한다. 표 TB_MQC_ORD·DSN_REQ·DSN_RSLT·DSN_HIST.

action=search -&gt; searchTask (qualityDesignResult.search) 의뢰 목록 조회
action=view -&gt; viewTask (qualityDesignResult.view) 설계결과 상세
action=calculate -&gt; calculateTask (qualityDesignResult.calculate) 설계 계산
action=confirm -&gt; confirmTask (qualityDesignResult.confirm) 설계 확정
action=cancel -&gt; cancelTask (qualityDesignResult.cancel) 보류·보류 해제
action=history -&gt; historyTask (qualityDesignResult.history) 설계 이력</bpmn:documentation>
    <bpmn:startEvent id="start" name="시작">
      <bpmn:outgoing>flow_to_gw</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="actionGateway" name="action 분기">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="input" value="action" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_to_gw</bpmn:incoming>
      <bpmn:outgoing>flow_search</bpmn:outgoing>
      <bpmn:outgoing>flow_view</bpmn:outgoing>
      <bpmn:outgoing>flow_calculate</bpmn:outgoing>
      <bpmn:outgoing>flow_confirm</bpmn:outgoing>
      <bpmn:outgoing>flow_cancel</bpmn:outgoing>
      <bpmn:outgoing>flow_history</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="searchTask" name="의뢰 목록 조회" camunda:class="qualityDesignResult">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="search" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mqc.qdr.qualityDesignResult.dto.QualityDesignResultSearchRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_search</bpmn:incoming>
      <bpmn:outgoing>flow_search_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="viewTask" name="설계결과 상세" camunda:class="qualityDesignResult">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="view" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mqc.qdr.qualityDesignResult.dto.QualityDesignResultKeyRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_view</bpmn:incoming>
      <bpmn:outgoing>flow_view_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="calculateTask" name="설계 계산" camunda:class="qualityDesignResult">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="calculate" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mqc.qdr.qualityDesignResult.dto.QualityDesignResultKeyRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_calculate</bpmn:incoming>
      <bpmn:outgoing>flow_calculate_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="confirmTask" name="설계 확정" camunda:class="qualityDesignResult">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="confirm" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mqc.qdr.qualityDesignResult.dto.QualityDesignResultKeyRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_confirm</bpmn:incoming>
      <bpmn:outgoing>flow_confirm_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="cancelTask" name="보류·보류 해제" camunda:class="qualityDesignResult">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="cancel" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mqc.qdr.qualityDesignResult.dto.QualityDesignResultKeyRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_cancel</bpmn:incoming>
      <bpmn:outgoing>flow_cancel_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="historyTask" name="설계 이력" camunda:class="qualityDesignResult">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="history" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mqc.qdr.qualityDesignResult.dto.QualityDesignResultKeyRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_history</bpmn:incoming>
      <bpmn:outgoing>flow_history_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="endSearch" name="의뢰 목록 조회 완료">
      <bpmn:incoming>flow_search_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="endView" name="설계결과 상세 완료">
      <bpmn:incoming>flow_view_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="endCalculate" name="설계 계산 완료">
      <bpmn:incoming>flow_calculate_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="endConfirm" name="설계 확정 완료">
      <bpmn:incoming>flow_confirm_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="endCancel" name="보류·보류 해제 완료">
      <bpmn:incoming>flow_cancel_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="endHistory" name="설계 이력 완료">
      <bpmn:incoming>flow_history_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_to_gw" sourceRef="start" targetRef="actionGateway" />
    <bpmn:sequenceFlow id="flow_search" name="search" sourceRef="actionGateway" targetRef="searchTask" />
    <bpmn:sequenceFlow id="flow_view" name="view" sourceRef="actionGateway" targetRef="viewTask" />
    <bpmn:sequenceFlow id="flow_calculate" name="calculate" sourceRef="actionGateway" targetRef="calculateTask" />
    <bpmn:sequenceFlow id="flow_confirm" name="confirm" sourceRef="actionGateway" targetRef="confirmTask" />
    <bpmn:sequenceFlow id="flow_cancel" name="cancel" sourceRef="actionGateway" targetRef="cancelTask" />
    <bpmn:sequenceFlow id="flow_history" name="history" sourceRef="actionGateway" targetRef="historyTask" />
    <bpmn:sequenceFlow id="flow_search_end" sourceRef="searchTask" targetRef="endSearch" />
    <bpmn:sequenceFlow id="flow_view_end" sourceRef="viewTask" targetRef="endView" />
    <bpmn:sequenceFlow id="flow_calculate_end" sourceRef="calculateTask" targetRef="endCalculate" />
    <bpmn:sequenceFlow id="flow_confirm_end" sourceRef="confirmTask" targetRef="endConfirm" />
    <bpmn:sequenceFlow id="flow_cancel_end" sourceRef="cancelTask" targetRef="endCancel" />
    <bpmn:sequenceFlow id="flow_history_end" sourceRef="historyTask" targetRef="endHistory" />
  </bpmn:process>
