<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_inspectionCertificate" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-tool" exporterVersion="1.3.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.15.0">
  <bpmn:process id="inspectionCertificate" name="검사증명서관리" isExecutable="true">
    <bpmn:documentation>inspectionCertificate — 코일·적용 규격 단위 검사증명서(MTC). 발행 요청(save) → 검토중 → 발행(issue, 검사값 고정) / 보류(cancel), 재발행(reissue). 발행은 코일이 합격이어야 한다.

action=search -&gt; searchTask (inspectionCertificate.search) 증명서 목록 조회
action=view -&gt; viewTask (inspectionCertificate.view) 증명서 상세
action=save -&gt; saveTask (inspectionCertificate.save) 발행 요청(검토중 생성)
action=issue -&gt; issueTask (inspectionCertificate.issue) 발행
action=reissue -&gt; reissueTask (inspectionCertificate.reissue) 재발행
action=cancel -&gt; cancelTask (inspectionCertificate.cancel) 보류
action=history -&gt; historyTask (inspectionCertificate.history) 처리 이력
action=codes -&gt; codesTask (inspectionCertificate.codes) 발행 요청 고르기 값</bpmn:documentation>
    <bpmn:startEvent id="start" name="시작">
      <bpmn:outgoing>flow_to_gw</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="actionGateway" name="action 분기">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="input" value="action" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_to_gw</bpmn:incoming>
      <bpmn:outgoing>flow_search</bpmn:outgoing>
      <bpmn:outgoing>flow_view</bpmn:outgoing>
      <bpmn:outgoing>flow_save</bpmn:outgoing>
      <bpmn:outgoing>flow_issue</bpmn:outgoing>
      <bpmn:outgoing>flow_reissue</bpmn:outgoing>
      <bpmn:outgoing>flow_cancel</bpmn:outgoing>
      <bpmn:outgoing>flow_history</bpmn:outgoing>
      <bpmn:outgoing>flow_codes</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="searchTask" name="증명서 목록 조회" camunda:class="inspectionCertificate">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="search" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mqc.qpr.inspectionCertificate.dto.InspectionCertificateSearchRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_search</bpmn:incoming>
      <bpmn:outgoing>flow_search_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="viewTask" name="증명서 상세" camunda:class="inspectionCertificate">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="view" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mqc.qpr.inspectionCertificate.dto.InspectionCertificateKeyRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_view</bpmn:incoming>
      <bpmn:outgoing>flow_view_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="saveTask" name="발행 요청(검토중 생성)" camunda:class="inspectionCertificate">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="save" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mqc.qpr.inspectionCertificate.dto.InspectionCertificateSaveRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_save</bpmn:incoming>
      <bpmn:outgoing>flow_save_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="issueTask" name="발행" camunda:class="inspectionCertificate">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="issue" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mqc.qpr.inspectionCertificate.dto.InspectionCertificateKeyRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_issue</bpmn:incoming>
      <bpmn:outgoing>flow_issue_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="reissueTask" name="재발행" camunda:class="inspectionCertificate">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="reissue" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mqc.qpr.inspectionCertificate.dto.InspectionCertificateKeyRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_reissue</bpmn:incoming>
      <bpmn:outgoing>flow_reissue_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="cancelTask" name="보류" camunda:class="inspectionCertificate">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="cancel" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mqc.qpr.inspectionCertificate.dto.InspectionCertificateKeyRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_cancel</bpmn:incoming>
      <bpmn:outgoing>flow_cancel_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="historyTask" name="처리 이력" camunda:class="inspectionCertificate">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="history" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mqc.qpr.inspectionCertificate.dto.InspectionCertificateHistoryRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_history</bpmn:incoming>
      <bpmn:outgoing>flow_history_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="codesTask" name="발행 요청 고르기 값" camunda:class="inspectionCertificate">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="codes" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mqc.qpr.inspectionCertificate.dto.InspectionCertificateSearchRequest" />
