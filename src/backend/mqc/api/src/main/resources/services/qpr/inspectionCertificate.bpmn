<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_inspectionCertificate" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-tool" exporterVersion="1.3.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.15.0">
  <bpmn:process id="inspectionCertificate" name="검사증명서관리" isExecutable="true">
    <bpmn:documentation>inspectionCertificate — 검사증명서(MTC) 발행 목업(계약 docs/mqc/demo/mtc-contract.md). 계산은 화면 TS 엔진이 하고 서버는 양식·예외 규칙·증명서 원천·단건 수정·이미지·발행본·이력을 JSON 본문으로 저장한다. 발행 번호 채번, 신규 수신 복제, 재발행 사유 검사, 위변조방지(문서 해시·진위 확인 번호), 시연 초기화.

action=search -&gt; searchTask (inspectionCertificate.search) 전체 조회(비었으면 시드)
action=save -&gt; saveTask (inspectionCertificate.save) 본문 저장·삭제
action=reg -&gt; regTask (inspectionCertificate.reg) 신규 수신(원천 복제)
action=issue -&gt; issueTask (inspectionCertificate.issue) 발행
action=reissue -&gt; reissueTask (inspectionCertificate.reissue) 재발행
action=confirm -&gt; confirmTask (inspectionCertificate.confirm) 진위 확인
action=reset -&gt; resetTask (inspectionCertificate.reset) 시연 초기화</bpmn:documentation>
    <bpmn:startEvent id="start" name="시작">
      <bpmn:outgoing>flow_to_gw</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="actionGateway" name="action 분기">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="input" value="action" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_to_gw</bpmn:incoming>
      <bpmn:outgoing>flow_search</bpmn:outgoing>
      <bpmn:outgoing>flow_save</bpmn:outgoing>
      <bpmn:outgoing>flow_reg</bpmn:outgoing>
      <bpmn:outgoing>flow_issue</bpmn:outgoing>
      <bpmn:outgoing>flow_reissue</bpmn:outgoing>
      <bpmn:outgoing>flow_confirm</bpmn:outgoing>
      <bpmn:outgoing>flow_reset</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="searchTask" name="전체 조회(비었으면 시드)" camunda:class="inspectionCertificate">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="search" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mqc.qpr.inspectionCertificate.dto.InspectionCertificateRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_search</bpmn:incoming>
      <bpmn:outgoing>flow_search_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="saveTask" name="본문 저장·삭제" camunda:class="inspectionCertificate">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="save" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mqc.qpr.inspectionCertificate.dto.InspectionCertificateRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_save</bpmn:incoming>
      <bpmn:outgoing>flow_save_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="regTask" name="신규 수신(원천 복제)" camunda:class="inspectionCertificate">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="reg" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mqc.qpr.inspectionCertificate.dto.InspectionCertificateRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_reg</bpmn:incoming>
      <bpmn:outgoing>flow_reg_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="issueTask" name="발행" camunda:class="inspectionCertificate">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="issue" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mqc.qpr.inspectionCertificate.dto.InspectionCertificateRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_issue</bpmn:incoming>
      <bpmn:outgoing>flow_issue_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="reissueTask" name="재발행" camunda:class="inspectionCertificate">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="reissue" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mqc.qpr.inspectionCertificate.dto.InspectionCertificateRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_reissue</bpmn:incoming>
      <bpmn:outgoing>flow_reissue_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="confirmTask" name="진위 확인" camunda:class="inspectionCertificate">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="confirm" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mqc.qpr.inspectionCertificate.dto.InspectionCertificateRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_confirm</bpmn:incoming>
      <bpmn:outgoing>flow_confirm_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="resetTask" name="시연 초기화" camunda:class="inspectionCertificate">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="reset" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mqc.qpr.inspectionCertificate.dto.InspectionCertificateRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_reset</bpmn:incoming>
      <bpmn:outgoing>flow_reset_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="endSearch" name="전체 조회(비었으면 시드) 완료">
      <bpmn:incoming>flow_search_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="endSave" name="본문 저장·삭제 완료">
      <bpmn:incoming>flow_save_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="endReg" name="신규 수신(원천 복제) 완료">
      <bpmn:incoming>flow_reg_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="endIssue" name="발행 완료">
      <bpmn:incoming>flow_issue_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="endReissue" name="재발행 완료">
      <bpmn:incoming>flow_reissue_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="endConfirm" name="진위 확인 완료">
      <bpmn:incoming>flow_confirm_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="endReset" name="시연 초기화 완료">
      <bpmn:incoming>flow_reset_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_to_gw" sourceRef="start" targetRef="actionGateway" />
    <bpmn:sequenceFlow id="flow_search" name="search" sourceRef="actionGateway" targetRef="searchTask" />
    <bpmn:sequenceFlow id="flow_save" name="save" sourceRef="actionGateway" targetRef="saveTask" />
    <bpmn:sequenceFlow id="flow_reg" name="reg" sourceRef="actionGateway" targetRef="regTask" />
    <bpmn:sequenceFlow id="flow_issue" name="issue" sourceRef="actionGateway" targetRef="issueTask" />
    <bpmn:sequenceFlow id="flow_reissue" name="reissue" sourceRef="actionGateway" targetRef="reissueTask" />
    <bpmn:sequenceFlow id="flow_confirm" name="confirm" sourceRef="actionGateway" targetRef="confirmTask" />
    <bpmn:sequenceFlow id="flow_reset" name="reset" sourceRef="actionGateway" targetRef="resetTask" />
    <bpmn:sequenceFlow id="flow_search_end" sourceRef="searchTask" targetRef="endSearch" />
    <bpmn:sequenceFlow id="flow_save_end" sourceRef="saveTask" targetRef="endSave" />
    <bpmn:sequenceFlow id="flow_reg_end" sourceRef="regTask" targetRef="endReg" />
    <bpmn:sequenceFlow id="flow_issue_end" sourceRef="issueTask" targetRef="endIssue" />
    <bpmn:sequenceFlow id="flow_reissue_end" sourceRef="reissueTask" targetRef="endReissue" />
    <bpmn:sequenceFlow id="flow_confirm_end" sourceRef="confirmTask" targetRef="endConfirm" />
    <bpmn:sequenceFlow id="flow_reset_end" sourceRef="resetTask" targetRef="endReset" />
  </bpmn:process>
