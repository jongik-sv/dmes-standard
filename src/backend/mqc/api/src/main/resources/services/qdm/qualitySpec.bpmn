<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_qualitySpec" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-tool" exporterVersion="1.3.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.15.0">
  <bpmn:process id="qualitySpec" name="품질사양 관리" isExecutable="true">
    <bpmn:documentation>qualitySpec — 고객 품질사양(조건 IF → 설계결과 THEN) 등록·확정·OMS 전송(시연 흉내)·이력, 항목 사전, 주문 적용 시뮬레이션. 표는 TB_MQC_QSPEC* (mqc V2).

action=search -&gt; searchTask (qualitySpec.search) 사양 목록 조회
action=view -&gt; viewTask (qualitySpec.view) 사양 상세 조회
action=save -&gt; saveTask (qualitySpec.save) 사양·항목 저장
action=delete -&gt; deleteTask (qualitySpec.delete) 사양·항목 삭제
action=confirm -&gt; confirmTask (qualitySpec.confirm) 사양 확정
action=send -&gt; sendTask (qualitySpec.send) OMS 전송
action=history -&gt; historyTask (qualitySpec.history) 변경·전송 이력 조회
action=codes -&gt; codesTask (qualitySpec.codes) 항목 사전·기준 자료 조회
action=run -&gt; runTask (qualitySpec.run) 주문 적용 시뮬레이션</bpmn:documentation>
    <bpmn:startEvent id="start" name="시작">
      <bpmn:outgoing>flow_to_gw</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="actionGateway" name="action 분기">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="input" value="action" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_to_gw</bpmn:incoming>
      <bpmn:outgoing>flow_search</bpmn:outgoing>
      <bpmn:outgoing>flow_view</bpmn:outgoing>
      <bpmn:outgoing>flow_save</bpmn:outgoing>
      <bpmn:outgoing>flow_delete</bpmn:outgoing>
      <bpmn:outgoing>flow_confirm</bpmn:outgoing>
      <bpmn:outgoing>flow_send</bpmn:outgoing>
      <bpmn:outgoing>flow_history</bpmn:outgoing>
      <bpmn:outgoing>flow_codes</bpmn:outgoing>
      <bpmn:outgoing>flow_run</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="searchTask" name="사양 목록 조회" camunda:class="qualitySpec">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="search" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mqc.qdm.qualitySpec.dto.QualitySpecSearchRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_search</bpmn:incoming>
      <bpmn:outgoing>flow_search_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="viewTask" name="사양 상세 조회" camunda:class="qualitySpec">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="view" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mqc.qdm.qualitySpec.dto.QualitySpecViewRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_view</bpmn:incoming>
      <bpmn:outgoing>flow_view_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="saveTask" name="사양·항목 저장" camunda:class="qualitySpec">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="save" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mqc.qdm.qualitySpec.dto.QualitySpecSaveRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_save</bpmn:incoming>
      <bpmn:outgoing>flow_save_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="deleteTask" name="사양·항목 삭제" camunda:class="qualitySpec">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="delete" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mqc.qdm.qualitySpec.dto.QualitySpecDeleteRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_delete</bpmn:incoming>
      <bpmn:outgoing>flow_delete_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="confirmTask" name="사양 확정" camunda:class="qualitySpec">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="confirm" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mqc.qdm.qualitySpec.dto.QualitySpecBatchRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_confirm</bpmn:incoming>
      <bpmn:outgoing>flow_confirm_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="sendTask" name="OMS 전송" camunda:class="qualitySpec">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="send" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mqc.qdm.qualitySpec.dto.QualitySpecBatchRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_send</bpmn:incoming>
      <bpmn:outgoing>flow_send_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="historyTask" name="변경·전송 이력 조회" camunda:class="qualitySpec">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="history" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mqc.qdm.qualitySpec.dto.QualitySpecHistoryRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_history</bpmn:incoming>
      <bpmn:outgoing>flow_history_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="codesTask" name="항목 사전·기준 자료 조회" camunda:class="qualitySpec">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="codes" />
