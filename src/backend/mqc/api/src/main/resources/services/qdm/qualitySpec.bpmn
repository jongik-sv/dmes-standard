      </bpmn:extensionElements>
      <bpmn:incoming>flow_codes</bpmn:incoming>
      <bpmn:outgoing>flow_codes_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="runTask" name="주문 적용 시뮬레이션" camunda:class="qualitySpec">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="run" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mqc.qdm.qualitySpec.dto.QualitySpecRunRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_run</bpmn:incoming>
      <bpmn:outgoing>flow_run_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="endSearch" name="사양 목록 조회 완료">
      <bpmn:incoming>flow_search_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="endView" name="사양 상세 조회 완료">
