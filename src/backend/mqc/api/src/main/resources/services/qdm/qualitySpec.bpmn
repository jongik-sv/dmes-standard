    </bpmn:endEvent>
    <bpmn:endEvent id="endConfirm" name="사양 확정 완료">
      <bpmn:incoming>flow_confirm_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="endSend" name="OMS 전송 완료">
      <bpmn:incoming>flow_send_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="endHistory" name="변경·전송 이력 조회 완료">
