<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_tagManagement" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-tool" exporterVersion="1.3.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.15.0">
  <bpmn:process id="tagManagement" name="Tag관리" isExecutable="true">
    <bpmn:documentation>tagManagement — TAG 발행 규칙 편집 목업(계약 docs/mqc/demo/tag-contract.md). 편집은 화면이 하고 서버는 문서 본문(불투명한 JSON)·상태(적용본·초안·승인 대기)·승인 버전 기록·이력을 저장한다. 승인 대기 중 저장 거부, 승인 시 버전 올림, 시연 초기화.

action=search -&gt; searchTask (tagManagement.search) 문서·버전·이력 조회
action=save -&gt; saveTask (tagManagement.save) 문서 저장(INIT·DRAFT·REQUEST·UNREQUEST·DISCARD)
action=approve -&gt; approveTask (tagManagement.approve) 승인(버전 올림)
action=reset -&gt; resetTask (tagManagement.reset) 시연 초기화</bpmn:documentation>
    <bpmn:startEvent id="start" name="시작">
      <bpmn:outgoing>flow_to_gw</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="actionGateway" name="action 분기">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="input" value="action" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_to_gw</bpmn:incoming>
      <bpmn:outgoing>flow_search</bpmn:outgoing>
      <bpmn:outgoing>flow_save</bpmn:outgoing>
      <bpmn:outgoing>flow_approve</bpmn:outgoing>
      <bpmn:outgoing>flow_reset</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="searchTask" name="문서·버전·이력 조회" camunda:class="tagManagement">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="search" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mqc.qpr.tagManagement.dto.TagManagementRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_search</bpmn:incoming>
      <bpmn:outgoing>flow_search_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="saveTask" name="문서 저장(INIT·DRAFT·REQUEST·UNREQUEST·DISCARD)" camunda:class="tagManagement">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="save" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mqc.qpr.tagManagement.dto.TagManagementRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_save</bpmn:incoming>
      <bpmn:outgoing>flow_save_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="approveTask" name="승인(버전 올림)" camunda:class="tagManagement">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="approve" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mqc.qpr.tagManagement.dto.TagManagementRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_approve</bpmn:incoming>
      <bpmn:outgoing>flow_approve_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="resetTask" name="시연 초기화" camunda:class="tagManagement">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="reset" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mqc.qpr.tagManagement.dto.TagManagementRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_reset</bpmn:incoming>
      <bpmn:outgoing>flow_reset_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="endSearch" name="문서·버전·이력 조회 완료">
      <bpmn:incoming>flow_search_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="endSave" name="문서 저장(INIT·DRAFT·REQUEST·UNREQUEST·DISCARD) 완료">
      <bpmn:incoming>flow_save_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="endApprove" name="승인(버전 올림) 완료">
      <bpmn:incoming>flow_approve_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="endReset" name="시연 초기화 완료">
      <bpmn:incoming>flow_reset_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_to_gw" sourceRef="start" targetRef="actionGateway" />
    <bpmn:sequenceFlow id="flow_search" name="search" sourceRef="actionGateway" targetRef="searchTask" />
    <bpmn:sequenceFlow id="flow_save" name="save" sourceRef="actionGateway" targetRef="saveTask" />
    <bpmn:sequenceFlow id="flow_approve" name="approve" sourceRef="actionGateway" targetRef="approveTask" />
    <bpmn:sequenceFlow id="flow_reset" name="reset" sourceRef="actionGateway" targetRef="resetTask" />
    <bpmn:sequenceFlow id="flow_search_end" sourceRef="searchTask" targetRef="endSearch" />
    <bpmn:sequenceFlow id="flow_save_end" sourceRef="saveTask" targetRef="endSave" />
    <bpmn:sequenceFlow id="flow_approve_end" sourceRef="approveTask" targetRef="endApprove" />
    <bpmn:sequenceFlow id="flow_reset_end" sourceRef="resetTask" targetRef="endReset" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="tagManagement">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="152" y="262" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="actionGateway_di" bpmnElement="actionGateway" isMarkerVisible="true">
        <dc:Bounds x="245" y="255" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="searchTask_di" bpmnElement="searchTask">
        <dc:Bounds x="380" y="60" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endSearch_di" bpmnElement="endSearch">
        <dc:Bounds x="560" y="82" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="saveTask_di" bpmnElement="saveTask">
        <dc:Bounds x="380" y="180" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endSave_di" bpmnElement="endSave">
        <dc:Bounds x="560" y="202" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="approveTask_di" bpmnElement="approveTask">
        <dc:Bounds x="380" y="300" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endApprove_di" bpmnElement="endApprove">
        <dc:Bounds x="560" y="322" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="resetTask_di" bpmnElement="resetTask">
        <dc:Bounds x="380" y="420" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endReset_di" bpmnElement="endReset">
        <dc:Bounds x="560" y="442" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_to_gw_di" bpmnElement="flow_to_gw">
        <di:waypoint x="188" y="280" />
        <di:waypoint x="245" y="280" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_search_di" bpmnElement="flow_search">
        <di:waypoint x="270" y="255" />
        <di:waypoint x="270" y="100" />
        <di:waypoint x="380" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_search_end_di" bpmnElement="flow_search_end">
        <di:waypoint x="480" y="100" />
        <di:waypoint x="560" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_save_di" bpmnElement="flow_save">
        <di:waypoint x="270" y="255" />
        <di:waypoint x="270" y="220" />
        <di:waypoint x="380" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_save_end_di" bpmnElement="flow_save_end">
        <di:waypoint x="480" y="220" />
        <di:waypoint x="560" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_approve_di" bpmnElement="flow_approve">
        <di:waypoint x="270" y="305" />
        <di:waypoint x="270" y="340" />
        <di:waypoint x="380" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_approve_end_di" bpmnElement="flow_approve_end">
        <di:waypoint x="480" y="340" />
        <di:waypoint x="560" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_reset_di" bpmnElement="flow_reset">
        <di:waypoint x="270" y="305" />
        <di:waypoint x="270" y="460" />
        <di:waypoint x="380" y="460" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_reset_end_di" bpmnElement="flow_reset_end">
        <di:waypoint x="480" y="460" />
        <di:waypoint x="560" y="460" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
