        <di:waypoint x="560" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_issue_di" bpmnElement="flow_issue">
        <di:waypoint x="270" y="375" />
        <di:waypoint x="270" y="340" />
        <di:waypoint x="380" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_issue_end_di" bpmnElement="flow_issue_end">
        <di:waypoint x="480" y="340" />
        <di:waypoint x="560" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_reissue_di" bpmnElement="flow_reissue">
        <di:waypoint x="270" y="425" />
        <di:waypoint x="270" y="460" />
        <di:waypoint x="380" y="460" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_reissue_end_di" bpmnElement="flow_reissue_end">
        <di:waypoint x="480" y="460" />
        <di:waypoint x="560" y="460" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_cancel_di" bpmnElement="flow_cancel">
        <di:waypoint x="270" y="425" />
        <di:waypoint x="270" y="580" />
        <di:waypoint x="380" y="580" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_cancel_end_di" bpmnElement="flow_cancel_end">
        <di:waypoint x="480" y="580" />
        <di:waypoint x="560" y="580" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_history_di" bpmnElement="flow_history">
        <di:waypoint x="270" y="425" />
        <di:waypoint x="270" y="700" />
        <di:waypoint x="380" y="700" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_history_end_di" bpmnElement="flow_history_end">
        <di:waypoint x="480" y="700" />
        <di:waypoint x="560" y="700" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
