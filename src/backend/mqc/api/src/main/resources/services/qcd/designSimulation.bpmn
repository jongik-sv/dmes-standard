<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_designSimulation" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-tool" exporterVersion="1.3.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.15.0">
  <bpmn:process id="designSimulation" name="품질설계 시뮬레이션" isExecutable="true">
    <bpmn:documentation>designSimulation — 주문 하나를 품질설계 파이프라인 6단계로 돌려 기대값(pin)·단계 판정 기대·골든 스냅샷과 맞춰 보는 회귀 케이스. 표 TB_MQC_SIM_CASE.

action=search -&gt; searchTask (designSimulation.search) 케이스 목록 조회
action=view -&gt; viewTask (designSimulation.view) 케이스 상세
action=run -&gt; runTask (designSimulation.run) 케이스 실행
action=save -&gt; saveTask (designSimulation.save) 케이스 저장
action=apply -&gt; applyTask (designSimulation.apply) 골든 채택
action=delete -&gt; deleteTask (designSimulation.delete) 케이스 삭제</bpmn:documentation>
    <bpmn:startEvent id="start" name="시작">
      <bpmn:outgoing>flow_to_gw</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="actionGateway" name="action 분기">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="input" value="action" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_to_gw</bpmn:incoming>
      <bpmn:outgoing>flow_search</bpmn:outgoing>
      <bpmn:outgoing>flow_view</bpmn:outgoing>
      <bpmn:outgoing>flow_run</bpmn:outgoing>
      <bpmn:outgoing>flow_save</bpmn:outgoing>
      <bpmn:outgoing>flow_apply</bpmn:outgoing>
      <bpmn:outgoing>flow_delete</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="searchTask" name="케이스 목록 조회" camunda:class="designSimulation">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="search" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mqc.qcd.designSimulation.dto.DesignSimulationSearchRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_search</bpmn:incoming>
      <bpmn:outgoing>flow_search_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="viewTask" name="케이스 상세" camunda:class="designSimulation">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="view" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mqc.qcd.designSimulation.dto.DesignSimulationKeyRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_view</bpmn:incoming>
      <bpmn:outgoing>flow_view_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="runTask" name="케이스 실행" camunda:class="designSimulation">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="run" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mqc.qcd.designSimulation.dto.DesignSimulationKeyRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_run</bpmn:incoming>
      <bpmn:outgoing>flow_run_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="saveTask" name="케이스 저장" camunda:class="designSimulation">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="save" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mqc.qcd.designSimulation.dto.DesignSimulationSaveRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_save</bpmn:incoming>
      <bpmn:outgoing>flow_save_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="applyTask" name="골든 채택" camunda:class="designSimulation">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="apply" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mqc.qcd.designSimulation.dto.DesignSimulationKeyRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_apply</bpmn:incoming>
      <bpmn:outgoing>flow_apply_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="deleteTask" name="케이스 삭제" camunda:class="designSimulation">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="delete" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mqc.qcd.designSimulation.dto.DesignSimulationKeyRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_delete</bpmn:incoming>
      <bpmn:outgoing>flow_delete_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="endSearch" name="케이스 목록 조회 완료">
      <bpmn:incoming>flow_search_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="endView" name="케이스 상세 완료">
      <bpmn:incoming>flow_view_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="endRun" name="케이스 실행 완료">
      <bpmn:incoming>flow_run_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="endSave" name="케이스 저장 완료">
      <bpmn:incoming>flow_save_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="endApply" name="골든 채택 완료">
      <bpmn:incoming>flow_apply_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="endDelete" name="케이스 삭제 완료">
      <bpmn:incoming>flow_delete_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_to_gw" sourceRef="start" targetRef="actionGateway" />
    <bpmn:sequenceFlow id="flow_search" name="search" sourceRef="actionGateway" targetRef="searchTask" />
    <bpmn:sequenceFlow id="flow_view" name="view" sourceRef="actionGateway" targetRef="viewTask" />
    <bpmn:sequenceFlow id="flow_run" name="run" sourceRef="actionGateway" targetRef="runTask" />
    <bpmn:sequenceFlow id="flow_save" name="save" sourceRef="actionGateway" targetRef="saveTask" />
    <bpmn:sequenceFlow id="flow_apply" name="apply" sourceRef="actionGateway" targetRef="applyTask" />
    <bpmn:sequenceFlow id="flow_delete" name="delete" sourceRef="actionGateway" targetRef="deleteTask" />
    <bpmn:sequenceFlow id="flow_search_end" sourceRef="searchTask" targetRef="endSearch" />
    <bpmn:sequenceFlow id="flow_view_end" sourceRef="viewTask" targetRef="endView" />
    <bpmn:sequenceFlow id="flow_run_end" sourceRef="runTask" targetRef="endRun" />
    <bpmn:sequenceFlow id="flow_save_end" sourceRef="saveTask" targetRef="endSave" />
    <bpmn:sequenceFlow id="flow_apply_end" sourceRef="applyTask" targetRef="endApply" />
    <bpmn:sequenceFlow id="flow_delete_end" sourceRef="deleteTask" targetRef="endDelete" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="designSimulation">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="152" y="382" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="actionGateway_di" bpmnElement="actionGateway" isMarkerVisible="true">
        <dc:Bounds x="245" y="375" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="searchTask_di" bpmnElement="searchTask">
        <dc:Bounds x="380" y="60" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endSearch_di" bpmnElement="endSearch">
        <dc:Bounds x="560" y="82" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="viewTask_di" bpmnElement="viewTask">
        <dc:Bounds x="380" y="180" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endView_di" bpmnElement="endView">
        <dc:Bounds x="560" y="202" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="runTask_di" bpmnElement="runTask">
        <dc:Bounds x="380" y="300" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endRun_di" bpmnElement="endRun">
        <dc:Bounds x="560" y="322" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="saveTask_di" bpmnElement="saveTask">
        <dc:Bounds x="380" y="420" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endSave_di" bpmnElement="endSave">
        <dc:Bounds x="560" y="442" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="applyTask_di" bpmnElement="applyTask">
        <dc:Bounds x="380" y="540" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endApply_di" bpmnElement="endApply">
        <dc:Bounds x="560" y="562" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="deleteTask_di" bpmnElement="deleteTask">
        <dc:Bounds x="380" y="660" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endDelete_di" bpmnElement="endDelete">
        <dc:Bounds x="560" y="682" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_to_gw_di" bpmnElement="flow_to_gw">
        <di:waypoint x="188" y="400" />
        <di:waypoint x="245" y="400" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_search_di" bpmnElement="flow_search">
        <di:waypoint x="270" y="375" />
        <di:waypoint x="270" y="100" />
        <di:waypoint x="380" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_search_end_di" bpmnElement="flow_search_end">
        <di:waypoint x="480" y="100" />
        <di:waypoint x="560" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_view_di" bpmnElement="flow_view">
        <di:waypoint x="270" y="375" />
        <di:waypoint x="270" y="220" />
        <di:waypoint x="380" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_view_end_di" bpmnElement="flow_view_end">
        <di:waypoint x="480" y="220" />
        <di:waypoint x="560" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_run_di" bpmnElement="flow_run">
        <di:waypoint x="270" y="375" />
        <di:waypoint x="270" y="340" />
        <di:waypoint x="380" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_run_end_di" bpmnElement="flow_run_end">
        <di:waypoint x="480" y="340" />
        <di:waypoint x="560" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_save_di" bpmnElement="flow_save">
        <di:waypoint x="270" y="425" />
        <di:waypoint x="270" y="460" />
        <di:waypoint x="380" y="460" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_save_end_di" bpmnElement="flow_save_end">
        <di:waypoint x="480" y="460" />
        <di:waypoint x="560" y="460" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_apply_di" bpmnElement="flow_apply">
        <di:waypoint x="270" y="425" />
        <di:waypoint x="270" y="580" />
        <di:waypoint x="380" y="580" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_apply_end_di" bpmnElement="flow_apply_end">
        <di:waypoint x="480" y="580" />
        <di:waypoint x="560" y="580" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_delete_di" bpmnElement="flow_delete">
        <di:waypoint x="270" y="425" />
        <di:waypoint x="270" y="700" />
        <di:waypoint x="380" y="700" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_delete_end_di" bpmnElement="flow_delete_end">
        <di:waypoint x="480" y="700" />
        <di:waypoint x="560" y="700" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
