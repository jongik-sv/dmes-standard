<?xml version="1.0" encoding="UTF-8"?>
<!-- OasisAopAnnotationCheckerTest 용 — 같은 빈을 빈 이름으로 부른다 (mixedByClass.bpmn 은 클래스 이름으로 부른다) -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  id="Definitions_mixedByName" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="mixedByName" isExecutable="true">
    <bpmn:startEvent id="start"/>
    <bpmn:serviceTask id="t1" name="빈 이름 참조" camunda:class="classTxService#search"/>
    <bpmn:endEvent id="end"/>
  </bpmn:process>
</bpmn:definitions>
