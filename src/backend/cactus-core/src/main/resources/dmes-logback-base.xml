<?xml version="1.0" encoding="UTF-8"?>
<!--
  DMES 공통 logback base (2026-07-10 analog 멀티모듈 로그 뷰어 설계 — docs/analog).

  사용법: 각 모듈의 logback-spring.xml 이 MODULE_ID property 를 정의한 뒤 include 한다.

    <configuration>
        <property name="MODULE_ID" value="mcm"/>
        <include resource="dmes-logback-base.xml"/>
    </configuration>

  파일 규약 (analog 검색 엔진이 그대로 읽는다):
    live    : ${LOG_ROOT}/{module}/dmes-{module}.log
    archive : ${LOG_ROOT}/{module}/dmes-{module}.yyyy-MM-dd.N.log   (비압축 — analog 는 gz 미지원)

  예약 작업 로그 (MDC serviceId 가 sch. 로 시작하는 줄 — 실행 중 SQL·bind 포함):
    이 base 를 include 하는 모든 모듈이 ${LOG_ROOT}/sch/dmes-sch.yyyy-MM-dd.0.log 한 파일에 같이 쓰고 업무 로그 파일에서는 뺀다.
    여러 JVM(로컬은 모듈별 프로세스, WildFly 는 WAR 별 logback 컨텍스트)이 한 파일을 쓰므로 prudent 모드(파일 잠금)를 쓴다.
    prudent 파일 잠금은 한 JVM 안의 컨텍스트끼리는 OverlappingFileLockException 으로 줄을 잃으므로
    JvmSharedRollingFileAppender 가 JVM 안의 쓰기를 먼저 직렬화한다.
    prudent 모드는 RollingFileAppender 의 file 속성을 무시해 날짜가 들어간 이름으로 바로 쓰며 크기 분할(%i)을 못 쓴다.
    그래서 하루 한 파일을 analog 가 아카이브 이름 규약(SEQ 0)으로 찾게 dmes-sch.날짜.0.log 로 짓는다 (live 이름 dmes-sch.log 는 없다).

  주의: springProperty/springProfile 은 logback 자동 reload(scan)와 호환되지 않으므로
        모듈 파일에 scan="true" 를 넣지 않는다.
-->
<included>
    <!-- 보관기간(일). 프로파일 yml(dmes.log.max-history) / -D 시스템 프로퍼티 / 환경변수로 조절 -->
    <springProperty scope="context" name="LOG_MAX_HISTORY" source="dmes.log.max-history" defaultValue="2"/>
    <!-- 로그 루트. 로컬 bootRun 기본값 ../logs = src/backend/logs 플랫 구조
         (모듈 workingDir=모듈루트, analog 기본 base_dir ../logs/{MODULE} 와 정합).
         WildFly 개발계는 standalone.conf 의 -Ddmes.log.root=D:/Middleware/was/logs (한 JVM 전 WAR 일괄 적용) -->
    <springProperty scope="context" name="LOG_ROOT" source="dmes.log.root" defaultValue="../logs"/>

    <property name="LOG_PATH" value="${LOG_ROOT}/${MODULE_ID}"/>
    <property name="LOG_FILE" value="dmes-${MODULE_ID}"/>
    <!-- 예약 작업 serviceId(sch.<모듈>.<클래스>.<메서드>)가 모듈을 읽는 값 — ScheduledJobLogContext 가 logback 컨텍스트에서 꺼낸다 -->
    <property scope="context" name="DMES_MODULE" value="${MODULE_ID}"/>
    <property name="SCH_LOG_PATH" value="${LOG_ROOT}/sch"/>
    <property name="SCH_LOG_FILE" value="dmes-sch"/>
    <!-- MDC service_tag/serviceId 는 OASIS 실행 스레드에서만 채워진다 (mpn 등 REST 모듈은 [] [] 로 출력).
         analog Service List 추출(lex_pattern)이 이 두 필드를 읽는다. -->
    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] [%X{service_tag}] [%X{serviceId}] %-5level %logger{36} - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <charset>UTF-8</charset>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/${LOG_FILE}.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/${LOG_FILE}.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>${LOG_MAX_HISTORY}</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>
        <!-- 예약 작업 줄은 SCH_FILE 로만 간다 -->
        <filter class="com.dongkuk.dmes.cactus.scheduling.ScheduledJobLogFilter">
            <onlyScheduled>false</onlyScheduled>
        </filter>
        <encoder>
            <charset>UTF-8</charset>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- 예약 작업 로그 — 전 모듈 공용 한 파일. 보관(maxHistory)·용량 상한은 업무 로그와 같다.
         prudent: 여러 JVM 이 같은 파일에 잠금을 잡고 쓴다(줄이 섞이지 않고 날짜 전환이 JVM 마다 같은 이름으로 일어난다). -->
    <appender name="SCH_FILE" class="com.dongkuk.dmes.cactus.scheduling.JvmSharedRollingFileAppender">
        <prudent>true</prudent>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${SCH_LOG_PATH}/${SCH_LOG_FILE}.%d{yyyy-MM-dd}.0.log</fileNamePattern>
            <maxHistory>${LOG_MAX_HISTORY}</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>
        <filter class="com.dongkuk.dmes.cactus.scheduling.ScheduledJobLogFilter">
            <onlyScheduled>true</onlyScheduled>
        </filter>
        <encoder>
            <charset>UTF-8</charset>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- 프로파일별 로그 정책 — 전 모듈 동일 (설계 D9).
         springProfile 은 와일드카드 미지원 → local* 계열은 콤마 열거.
         신규 local-* 프로파일 추가 시 아래 열거 및 fallback 부정식에 반드시 추가한다. -->
    <springProfile name="local, local-kp, local-ph">
        <!-- local 은 root DEBUG 를 따라 HikariCP housekeeper 가 풀 통계(Pool stats·Fill pool 등)를 30초마다 찍는다.
             요청 로그가 아니라 소음뿐이므로 com.zaxxer.hikari 만 INFO 로 낮춘다(SQL 바인딩 로그는 org.hibernate.* 로거라 무관). -->
        <logger name="com.zaxxer.hikari" level="INFO"/>
        <root level="DEBUG">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
            <appender-ref ref="SCH_FILE"/>
        </root>
    </springProfile>

    <springProfile name="dev">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
            <appender-ref ref="SCH_FILE"/>
        </root>
    </springProfile>

    <springProfile name="prod">
        <root level="WARN">
            <appender-ref ref="FILE"/>
            <appender-ref ref="SCH_FILE"/>
        </root>
    </springProfile>

    <!-- fallback: 열거되지 않은 프로파일(wildfly 단독 / test / mssql-validate / 미지정 등).
         이 블록이 없으면 해당 프로파일에서 root 에 appender 가 없어 로그가 통째로 유실된다. -->
    <springProfile name="!local &amp; !local-kp &amp; !local-ph &amp; !dev &amp; !prod">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
            <appender-ref ref="SCH_FILE"/>
        </root>
    </springProfile>
</included>
