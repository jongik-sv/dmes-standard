{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dongkuk.com/dmes/mdm/contract/layout/layout-snapshot.schema.json",
  "title": "MdmLayoutSnapshot",
  "description": "TSK-05-01 design.md 6.2 - 최상위 키는 6.1 record 필드와 1:1 대응한다. 샘플 인스턴스는 html 시안의 M201 전체 예시(187/130, N=2)를 쓴다(F12, D3).",
  "type": "object",
  "properties": {
    "layoutId": { "type": "integer" },
    "layoutName": { "type": "string" },
    "eaiCode": { "type": ["string", "null"] },
    "sndSystem": { "type": ["string", "null"] },
    "rcvSystem": { "type": ["string", "null"] },
    "encoding": { "type": ["string", "null"] },
    "padRule": { "type": ["string", "null"] },
    "layoutVersion": { "type": "integer" },
    "totalLength": { "type": "integer" },
    "headers": {
      "type": "array",
      "items": { "$ref": "#/$defs/MdmLayoutHeaderRef" }
    },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/MdmLayoutItemSnapshot" }
    }
  },
  "required": ["layoutId", "layoutName", "layoutVersion", "totalLength", "headers", "items"],
  "additionalProperties": false,
  "$defs": {
    "MdmLayoutHeaderRef": {
      "title": "MdmLayoutHeaderRef",
      "description": "적층 헤더 한 겹의 스냅샷(D4). offset은 메시지 전체 절대 위치, items[*].offset은 이 헤더 내부 상대 위치다(F23).",
      "type": "object",
      "properties": {
        "seq": { "type": "integer" },
        "headerLayoutId": { "type": "integer" },
        "headerLayoutName": { "type": "string" },
        "offset": { "type": "integer" },
        "totalLength": { "type": "integer" },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/MdmLayoutItemSnapshot" }
        }
      },
      "required": ["seq", "headerLayoutId", "headerLayoutName", "offset", "totalLength", "items"],
      "additionalProperties": false
    },
    "MdmLayoutItemSnapshot": {
      "title": "MdmLayoutItemSnapshot",
      "description": "전문 항목 스냅샷(F22). defaultValue(헤더 기본값)와 overrideValue(이 전문의 재정의 값)를 별도 필드로 담는다(불변 규칙 14). unitCode·scale 은 도메인 파생값(기준 단위·소수 자리) — 전송 단위 환산·소수점 문자 형식에 쓴다(TSK-05-03 D3).",
      "type": "object",
      "properties": {
        "seq": { "type": "integer" },
        "fillKind": { "type": "string", "enum": ["DATA", "CONST", "AUTO", "FILLER"] },
        "dataType": { "type": ["string", "null"], "enum": ["CHAR", "NUM", null] },
        "columnPhys": { "type": ["string", "null"] },
        "transUnit": { "type": ["string", "null"] },
        "unitItem": { "type": ["string", "null"] },
        "numFormat": {
          "anyOf": [
            { "$ref": "#/$defs/MdmLayoutNumFormat" },
            { "type": "null" }
          ]
        },
        "defaultValue": { "type": ["string", "null"] },
        "overrideValue": { "type": ["string", "null"] },
        "fillerLength": { "type": ["integer", "null"] },
        "offset": { "type": "integer" },
        "length": { "type": "integer" },
        "unitCode": { "type": ["string", "null"] },
        "scale": { "type": ["integer", "null"] }
      },
      "required": ["seq", "fillKind", "dataType", "columnPhys", "transUnit", "unitItem", "numFormat",
        "defaultValue", "overrideValue", "fillerLength", "offset", "length", "unitCode", "scale"],
      "additionalProperties": false
    },
    "MdmLayoutNumFormat": {
      "title": "MdmLayoutNumFormat",
      "description": "숫자 항목의 직렬화 형식(F22, html:560).",
      "type": "object",
      "properties": {
        "sign": { "type": "boolean" },
        "zeroPad": { "type": "boolean" },
        "impliedScale": { "type": "integer" }
      },
      "required": ["sign", "zeroPad", "impliedScale"],
      "additionalProperties": false
    }
  }
}
