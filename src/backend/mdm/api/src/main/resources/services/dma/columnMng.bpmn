<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_columnMng" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-tool" exporterVersion="1.3.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.15.0">
  <bpmn:process id="columnMng" name="컬럼 사전" isExecutable="true">
    <bpmn:documentation>columnMng — 컬럼 사전 (To-Be only 신규 화면. As-Is 레거시 없음).
정본: docs/mdm/tasks/TSK-04-04/design.md §6.1·§6.12·§6.14

action=search  -&gt; searchTask  (columnMngService.search)   READ
action=view    -&gt; viewTask    (columnMngService.view)     READ
action=compare -&gt; compareTask (columnMngService.compare)  READ — 분해·역분해·중복 검사·도메인 추천(D6)
action=save    -&gt; saveTask    (columnMngService.save)     EDIT — 서버가 MDM_STD_ADMIN 역할을 다시 본다(D1)</bpmn:documentation>
    <bpmn:startEvent id="start" name="시작">
      <bpmn:outgoing>flow_to_gw</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="actionGateway" name="action 분기">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="input" value="action" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_to_gw</bpmn:incoming>
      <bpmn:outgoing>flow_search</bpmn:outgoing>
      <bpmn:outgoing>flow_view</bpmn:outgoing>
      <bpmn:outgoing>flow_compare</bpmn:outgoing>
      <bpmn:outgoing>flow_save</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="searchTask" name="컬럼 목록 조회" camunda:class="columnMngService">
      <bpmn:documentation>design.md §6.1 — 검색어(논리명·표준 물리명·시스템 필드명)·도메인 필터. 응답 result.list/domains/systems.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="search" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mdm.dma.columnMng.dto.ColumnMngSearchRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_search</bpmn:incoming>
      <bpmn:outgoing>flow_search_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="endSearch" name="조회 완료">
      <bpmn:incoming>flow_search_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="viewTask" name="컬럼 상세 조회" camunda:class="columnMngService">
      <bpmn:documentation>design.md §6.1 — 컬럼·시스템 매핑·구성 용어. 응답 result.column/systems/terms.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="view" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mdm.dma.columnMng.dto.ColumnMngViewRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_view</bpmn:incoming>
      <bpmn:outgoing>flow_view_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="endView" name="상세 완료">
      <bpmn:incoming>flow_view_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="compareTask" name="컬럼명 분해·역분해" camunda:class="columnMngService">
      <bpmn:documentation>design.md §6.5~§6.7, D6 — READ 등급. 토큰·물리명·추천 도메인·중복 목록.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="compare" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mdm.dma.columnMng.dto.ColumnMngCompareRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_compare</bpmn:incoming>
      <bpmn:outgoing>flow_compare_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="endCompare" name="분해 완료">
      <bpmn:incoming>flow_compare_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="saveTask" name="컬럼 저장" camunda:class="columnMngService">
      <bpmn:documentation>design.md §6.12 — 표준 관리자만(MDM015). grids.systems·grids.terms 를 파라미터 이름으로 바인딩. 매핑은 차분 저장.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="save" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mdm.dma.columnMng.dto.ColumnMngSaveRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_save</bpmn:incoming>
      <bpmn:outgoing>flow_save_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="endSave" name="저장 완료">
      <bpmn:incoming>flow_save_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_to_gw" sourceRef="start" targetRef="actionGateway" />
    <bpmn:sequenceFlow id="flow_search" name="search" sourceRef="actionGateway" targetRef="searchTask" />
    <bpmn:sequenceFlow id="flow_search_end" sourceRef="searchTask" targetRef="endSearch" />
    <bpmn:sequenceFlow id="flow_view" name="view" sourceRef="actionGateway" targetRef="viewTask" />
    <bpmn:sequenceFlow id="flow_view_end" sourceRef="viewTask" targetRef="endView" />
    <bpmn:sequenceFlow id="flow_compare" name="compare" sourceRef="actionGateway" targetRef="compareTask" />
    <bpmn:sequenceFlow id="flow_compare_end" sourceRef="compareTask" targetRef="endCompare" />
    <bpmn:sequenceFlow id="flow_save" name="save" sourceRef="actionGateway" targetRef="saveTask" />
    <bpmn:sequenceFlow id="flow_save_end" sourceRef="saveTask" targetRef="endSave" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="columnMng">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="152" y="372" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="actionGateway_di" bpmnElement="actionGateway" isMarkerVisible="true">
        <dc:Bounds x="245" y="365" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="searchTask_di" bpmnElement="searchTask">
        <dc:Bounds x="380" y="60" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endSearch_di" bpmnElement="endSearch">
        <dc:Bounds x="560" y="82" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="viewTask_di" bpmnElement="viewTask">
        <dc:Bounds x="380" y="180" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endView_di" bpmnElement="endView">
        <dc:Bounds x="560" y="202" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="compareTask_di" bpmnElement="compareTask">
        <dc:Bounds x="380" y="300" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endCompare_di" bpmnElement="endCompare">
        <dc:Bounds x="560" y="322" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="saveTask_di" bpmnElement="saveTask">
        <dc:Bounds x="380" y="420" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endSave_di" bpmnElement="endSave">
        <dc:Bounds x="560" y="442" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_to_gw_di" bpmnElement="flow_to_gw">
        <di:waypoint x="188" y="390" />
        <di:waypoint x="245" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_search_di" bpmnElement="flow_search">
        <di:waypoint x="270" y="365" />
        <di:waypoint x="270" y="100" />
        <di:waypoint x="380" y="100" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="305" y="83" width="48" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_search_end_di" bpmnElement="flow_search_end">
        <di:waypoint x="480" y="100" />
        <di:waypoint x="560" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_view_di" bpmnElement="flow_view">
        <di:waypoint x="270" y="365" />
        <di:waypoint x="270" y="220" />
        <di:waypoint x="380" y="220" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="305" y="203" width="32" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_view_end_di" bpmnElement="flow_view_end">
        <di:waypoint x="480" y="220" />
        <di:waypoint x="560" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_compare_di" bpmnElement="flow_compare">
        <di:waypoint x="270" y="365" />
        <di:waypoint x="270" y="340" />
        <di:waypoint x="380" y="340" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="305" y="323" width="56" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_compare_end_di" bpmnElement="flow_compare_end">
        <di:waypoint x="480" y="340" />
        <di:waypoint x="560" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_save_di" bpmnElement="flow_save">
        <di:waypoint x="270" y="415" />
        <di:waypoint x="270" y="460" />
        <di:waypoint x="380" y="460" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="305" y="398" width="32" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_save_end_di" bpmnElement="flow_save_end">
        <di:waypoint x="480" y="460" />
        <di:waypoint x="560" y="460" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

