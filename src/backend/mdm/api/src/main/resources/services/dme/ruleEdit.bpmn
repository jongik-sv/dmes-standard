<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_ruleEdit" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-tool" exporterVersion="1.3.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.15.0">
  <bpmn:process id="ruleEdit" name="룰 화면" isExecutable="true">
    <bpmn:documentation>ruleEdit — 룰 내용 편집 (To-Be only 신규 화면, dme 업무기준).
정본: docs/mdm/screens/ruleEdit/ruleEdit_기능설계서.md, TSK-08-02 design.md §6.1, decisions.md D-105.

D-105 — 헤더·버전 관리는 ruleMng 화면으로 옮겨 갔다. 이 화면은 ③ 의사결정표·열 설정, ④⑤⑥ 값 테스트·테스트 결과·테스트
케이스, ⑧ 활용처 — 내용 편집만 한다. 액션이 11개에서 5개로 줄었다.
빠진 것: copy·delete·lock·unlock·handover, 그리고 save 의 part HEADER 와 hitPolicy 칸(둘 다 헤더·버전 화면이 한다).

버전 목록은 여전히 읽는다 — 어느 DRAFT 의 내용을 고를지 골라야 하기 때문이다. 다만 읽기 전용이고 관리 버튼은 없다.

action=search   -> searchTask  (ruleEditService.search)      READ  — target RULE(룰 고르기)·DOMAIN(값 타입 도메인 검색)
action=view     -> viewTask    (ruleEditService.view)        READ  — 선택 버전의 변수·행·열 사전·테스트 케이스·활용처
action=save     -> saveTask    (ruleEditService.save)        EDIT  — part TABLE(표)·COLUMNS(열 설정)·CASE(테스트 케이스)
action=validate -> validateTask(ruleEditService.parseExpr)   EDIT  — 식 입력 칸의 디바운스 파싱(서버 EvalEx 단일 진원, 불변 9)
action=execute  -> executeTask (ruleEditService.runTest)     EDIT  — 값 테스트. 원장에 쓰지 않는다(TSK-08-04 D3)

BPMN 의 action(RBAC 키)과 서비스의 method(자바 메서드명)는 별개다. 담당자 역할은 서버가 RuleStewardCheck 로 다시 본다(MDM013).</bpmn:documentation>
    <bpmn:startEvent id="start" name="시작">
      <bpmn:outgoing>flow_to_gw</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="actionGateway" name="action 분기">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="input" value="action" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_to_gw</bpmn:incoming>
      <bpmn:outgoing>flow_search</bpmn:outgoing>
      <bpmn:outgoing>flow_view</bpmn:outgoing>
      <bpmn:outgoing>flow_save</bpmn:outgoing>
      <bpmn:outgoing>flow_validate</bpmn:outgoing>
      <bpmn:outgoing>flow_execute</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="searchTask" name="룰 고르기" camunda:class="ruleEditService">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="search" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mdm.dme.ruleEdit.dto.RuleEditSearchRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_search</bpmn:incoming>
      <bpmn:outgoing>flow_search_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_search" name="룰 고르기 완료">
      <bpmn:incoming>flow_search_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="viewTask" name="룰·버전·정의 조회" camunda:class="ruleEditService">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="view" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mdm.dme.ruleEdit.dto.RuleEditViewRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_view</bpmn:incoming>
      <bpmn:outgoing>flow_view_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_view" name="룰·버전·정의 조회 완료">
      <bpmn:incoming>flow_view_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="saveTask" name="저장(part)" camunda:class="ruleEditService">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="save" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mdm.dme.ruleEdit.dto.RuleEditSaveRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_save</bpmn:incoming>
      <bpmn:outgoing>flow_save_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_save" name="저장(part) 완료">
      <bpmn:incoming>flow_save_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_to_gw" sourceRef="start" targetRef="actionGateway" />
    <bpmn:sequenceFlow id="flow_search" name="search" sourceRef="actionGateway" targetRef="searchTask" />
    <bpmn:sequenceFlow id="flow_search_end" sourceRef="searchTask" targetRef="end_search" />
    <bpmn:sequenceFlow id="flow_view" name="view" sourceRef="actionGateway" targetRef="viewTask" />
    <bpmn:sequenceFlow id="flow_view_end" sourceRef="viewTask" targetRef="end_view" />
    <bpmn:sequenceFlow id="flow_save" name="save" sourceRef="actionGateway" targetRef="saveTask" />
    <bpmn:sequenceFlow id="flow_save_end" sourceRef="saveTask" targetRef="end_save" />
    <bpmn:serviceTask id="validateTask" name="식 파싱" camunda:class="ruleEditService">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="parseExpr" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mdm.dme.ruleEdit.dto.RuleExprParseRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_validate</bpmn:incoming>
      <bpmn:outgoing>flow_validate_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_validate" name="식 파싱 완료">
      <bpmn:incoming>flow_validate_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_validate" name="validate" sourceRef="actionGateway" targetRef="validateTask" />
    <bpmn:sequenceFlow id="flow_validate_end" sourceRef="validateTask" targetRef="end_validate" />
    <bpmn:serviceTask id="executeTask" name="값 테스트" camunda:class="ruleEditService">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="runTest" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mdm.dme.ruleEdit.dto.RuleTestRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_execute</bpmn:incoming>
      <bpmn:outgoing>flow_execute_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_execute" name="값 테스트 완료">
      <bpmn:incoming>flow_execute_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_execute" name="execute" sourceRef="actionGateway" targetRef="executeTask" />
    <bpmn:sequenceFlow id="flow_execute_end" sourceRef="executeTask" targetRef="end_execute" />
  </bpmn:process>
