<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_codeCateEdit" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-tool" exporterVersion="1.3.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.15.0">
  <bpmn:process id="codeCateEdit" name="카테고리 편집" isExecutable="true">
    <bpmn:documentation>codeCateEdit — 카테고리 편집(REGEX·TABLE) (To-Be only 신규 화면. As-Is 레거시 없음).
정본: docs/mdm/tasks/TSK-06-04/design.md §1·§2

action=search   -&gt; searchTask   (codeCateEditService.search)    READ
action=view     -&gt; viewTask     (codeCateEditService.view)      READ
action=compare  -&gt; compareTask  (codeCateEditService.preview)   READ — REGEX 전용 미리보기(D2)
action=validate -&gt; validateTask (codeCateEditService.validate)  EDIT — categories·members 그리드 저장 검사
action=save     -&gt; saveTask     (codeCateEditService.save)      EDIT — 카테고리·TABLE 소속 저장(그리드 둘)
action=restore  -&gt; restoreTask  (codeCateEditService.revert)    EDIT — 카테고리·소속 되돌리기</bpmn:documentation>
    <bpmn:startEvent id="start" name="시작">
      <bpmn:outgoing>flow_to_gw</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="actionGateway" name="action 분기">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="input" value="action" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_to_gw</bpmn:incoming>
      <bpmn:outgoing>flow_search</bpmn:outgoing>
      <bpmn:outgoing>flow_view</bpmn:outgoing>
      <bpmn:outgoing>flow_compare</bpmn:outgoing>
      <bpmn:outgoing>flow_validate</bpmn:outgoing>
      <bpmn:outgoing>flow_save</bpmn:outgoing>
      <bpmn:outgoing>flow_restore</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="searchTask" name="마루 코드 목록 조회" camunda:class="codeCateEditService">
      <bpmn:documentation>design.md §2 — 마루 코드 목록(ID 순). READ.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="search" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mdm.dmc.codeCateEdit.dto.CodeCateSearchRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_search</bpmn:incoming>
      <bpmn:outgoing>flow_search_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="endSearch" name="조회 완료">
      <bpmn:incoming>flow_search_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="viewTask" name="버전 V 카테고리 모습 조회" camunda:class="codeCateEditService">
      <bpmn:documentation>design.md §2 — 헤더·버전·선택 버전·카테고리·코드 전체·소속. READ.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="view" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mdm.dmc.codeCateEdit.dto.CodeCateViewRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_view</bpmn:incoming>
      <bpmn:outgoing>flow_view_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="endView" name="모습 완료">
      <bpmn:incoming>flow_view_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="compareTask" name="REGEX 미리보기" camunda:class="codeCateEditService">
      <bpmn:documentation>design.md §1 — REGEX 전용, 후보 defExpr·defTarget 을 서버 Pattern 으로 재해석. READ.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="preview" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mdm.dmc.codeCateEdit.dto.CodeCatePreviewRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_compare</bpmn:incoming>
      <bpmn:outgoing>flow_compare_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="endCompare" name="미리보기 완료">
      <bpmn:incoming>flow_compare_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="validateTask" name="저장 검사" camunda:class="codeCateEditService">
      <bpmn:documentation>design.md §1.4 — categories·members 그리드 검사. grids.categories·grids.members.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="validate" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mdm.dmc.codeCateEdit.dto.CodeCateSaveRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_validate</bpmn:incoming>
      <bpmn:outgoing>flow_validate_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="endValidate" name="검사 완료">
      <bpmn:incoming>flow_validate_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="saveTask" name="카테고리·소속 저장" camunda:class="codeCateEditService">
      <bpmn:documentation>design.md §1.4 — 검사 → beginDraftWrite → categories(DELETED→CHANGED→ADDED) → members(DELETED→ADDED). grids.categories·grids.members 를 파라미터 이름으로 바인딩.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="save" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mdm.dmc.codeCateEdit.dto.CodeCateSaveRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_save</bpmn:incoming>
      <bpmn:outgoing>flow_save_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="endSave" name="저장 완료">
      <bpmn:incoming>flow_save_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="restoreTask" name="카테고리·소속 되돌리기" camunda:class="codeCateEditService">
      <bpmn:documentation>design.md §1 — beginDraftWrite → revert(CATE|CATE_ITEM).</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="revert" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mdm.dmc.codeCateEdit.dto.CodeCateRevertRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_restore</bpmn:incoming>
      <bpmn:outgoing>flow_restore_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="endRestore" name="되돌리기 완료">
      <bpmn:incoming>flow_restore_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_to_gw" sourceRef="start" targetRef="actionGateway" />
    <bpmn:sequenceFlow id="flow_search" name="search" sourceRef="actionGateway" targetRef="searchTask" />
    <bpmn:sequenceFlow id="flow_search_end" sourceRef="searchTask" targetRef="endSearch" />
    <bpmn:sequenceFlow id="flow_view" name="view" sourceRef="actionGateway" targetRef="viewTask" />
    <bpmn:sequenceFlow id="flow_view_end" sourceRef="viewTask" targetRef="endView" />
    <bpmn:sequenceFlow id="flow_compare" name="compare" sourceRef="actionGateway" targetRef="compareTask" />
    <bpmn:sequenceFlow id="flow_compare_end" sourceRef="compareTask" targetRef="endCompare" />
    <bpmn:sequenceFlow id="flow_validate" name="validate" sourceRef="actionGateway" targetRef="validateTask" />
    <bpmn:sequenceFlow id="flow_validate_end" sourceRef="validateTask" targetRef="endValidate" />
    <bpmn:sequenceFlow id="flow_save" name="save" sourceRef="actionGateway" targetRef="saveTask" />
    <bpmn:sequenceFlow id="flow_save_end" sourceRef="saveTask" targetRef="endSave" />
    <bpmn:sequenceFlow id="flow_restore" name="restore" sourceRef="actionGateway" targetRef="restoreTask" />
    <bpmn:sequenceFlow id="flow_restore_end" sourceRef="restoreTask" targetRef="endRestore" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="codeCateEdit">
