<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_dataCateEdit" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-tool" exporterVersion="1.3.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.15.0">
  <bpmn:process id="dataCateEdit" name="카테고리 편집" isExecutable="true">
    <bpmn:documentation>dataCateEdit — 마루 데이터 카테고리 편집(05 「화면」 카테고리 편집, TSK-07-02 design.md §1·§2).

action=search  -&gt; searchTask  (dataCateEditService.search)   — 카테고리 목록(R5)
action=view    -&gt; viewTask    (dataCateEditService.view)     — 카테고리 하나 상세(TABLE 이면 소속 후보·소속)
action=compare -&gt; compareTask (dataCateEditService.compare)  — REGEX 미리보기(저장 전)
action=reg     -&gt; regTask     (dataCateEditService.register) — 새 카테고리 등록
action=save    -&gt; saveTask    (dataCateEditService.save)     — REGEX 정의 수정 또는 TABLE 소속 일괄 적용(R12)
action=delete  -&gt; deleteTask  (dataCateEditService.close)    — 닫기(BASE 거부, R6). 소속 행에 연쇄하지 않는다(R4)
action=restore -&gt; restoreTask (dataCateEditService.reopen)   — 다시 열기

DataCategorySegmentCore 를 그대로 호출한다(reg·save-REGEX·delete·restore, R2′) — 이 서비스는 스스로 잠그지 않는다.
action(RBAC 키)은 MdmActions 16종 안에서만 고른다(D9). search·view·compare 는 READ, reg·save·delete·restore 는 EDIT.</bpmn:documentation>
    <bpmn:startEvent id="start" name="시작">
      <bpmn:outgoing>flow_to_gw</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="actionGateway" name="action 분기">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="input" value="action" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_to_gw</bpmn:incoming>
      <bpmn:outgoing>flow_search</bpmn:outgoing>
      <bpmn:outgoing>flow_view</bpmn:outgoing>
      <bpmn:outgoing>flow_compare</bpmn:outgoing>
      <bpmn:outgoing>flow_reg</bpmn:outgoing>
      <bpmn:outgoing>flow_save</bpmn:outgoing>
      <bpmn:outgoing>flow_delete</bpmn:outgoing>
      <bpmn:outgoing>flow_restore</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="searchTask" name="카테고리 목록 조회" camunda:class="dataCateEditService">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="search" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mdm.dmd.dataCateEdit.dto.CateSearchRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_search</bpmn:incoming>
      <bpmn:outgoing>flow_search_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_search" name="목록 조회 완료">
      <bpmn:incoming>flow_search_end</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:serviceTask id="viewTask" name="카테고리 상세 조회" camunda:class="dataCateEditService">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="view" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mdm.dmd.dataCateEdit.dto.CateViewRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_view</bpmn:incoming>
      <bpmn:outgoing>flow_view_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_view" name="상세 조회 완료">
      <bpmn:incoming>flow_view_end</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:serviceTask id="compareTask" name="REGEX 미리보기" camunda:class="dataCateEditService">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="compare" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mdm.dmd.dataCateEdit.dto.CateCompareRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_compare</bpmn:incoming>
      <bpmn:outgoing>flow_compare_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_compare" name="미리보기 완료">
      <bpmn:incoming>flow_compare_end</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:serviceTask id="regTask" name="카테고리 등록" camunda:class="dataCateEditService">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="register" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mdm.dmd.dataCateEdit.dto.CateRegRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_reg</bpmn:incoming>
      <bpmn:outgoing>flow_reg_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_reg" name="등록 완료">
      <bpmn:incoming>flow_reg_end</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:serviceTask id="saveTask" name="정의 수정 또는 소속 적용" camunda:class="dataCateEditService">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="save" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mdm.dmd.dataCateEdit.dto.CateSaveRequest" />
          <camunda:property name="opt" value="addCodes,removeCodes" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_save</bpmn:incoming>
      <bpmn:outgoing>flow_save_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_save" name="저장 완료">
      <bpmn:incoming>flow_save_end</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:serviceTask id="deleteTask" name="카테고리 닫기" camunda:class="dataCateEditService">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="close" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mdm.dmd.dataCateEdit.dto.CateViewRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_delete</bpmn:incoming>
      <bpmn:outgoing>flow_delete_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_delete" name="닫기 완료">
      <bpmn:incoming>flow_delete_end</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:serviceTask id="restoreTask" name="카테고리 다시 열기" camunda:class="dataCateEditService">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="reopen" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mdm.dmd.dataCateEdit.dto.CateViewRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_restore</bpmn:incoming>
      <bpmn:outgoing>flow_restore_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_restore" name="다시 열기 완료">
      <bpmn:incoming>flow_restore_end</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="flow_to_gw" sourceRef="start" targetRef="actionGateway" />
    <bpmn:sequenceFlow id="flow_search" name="search" sourceRef="actionGateway" targetRef="searchTask" />
    <bpmn:sequenceFlow id="flow_search_end" sourceRef="searchTask" targetRef="end_search" />
    <bpmn:sequenceFlow id="flow_view" name="view" sourceRef="actionGateway" targetRef="viewTask" />
    <bpmn:sequenceFlow id="flow_view_end" sourceRef="viewTask" targetRef="end_view" />
    <bpmn:sequenceFlow id="flow_compare" name="compare" sourceRef="actionGateway" targetRef="compareTask" />
    <bpmn:sequenceFlow id="flow_compare_end" sourceRef="compareTask" targetRef="end_compare" />
    <bpmn:sequenceFlow id="flow_reg" name="reg" sourceRef="actionGateway" targetRef="regTask" />
    <bpmn:sequenceFlow id="flow_reg_end" sourceRef="regTask" targetRef="end_reg" />
    <bpmn:sequenceFlow id="flow_save" name="save" sourceRef="actionGateway" targetRef="saveTask" />
    <bpmn:sequenceFlow id="flow_save_end" sourceRef="saveTask" targetRef="end_save" />
    <bpmn:sequenceFlow id="flow_delete" name="delete" sourceRef="actionGateway" targetRef="deleteTask" />
    <bpmn:sequenceFlow id="flow_delete_end" sourceRef="deleteTask" targetRef="end_delete" />
    <bpmn:sequenceFlow id="flow_restore" name="restore" sourceRef="actionGateway" targetRef="restoreTask" />
    <bpmn:sequenceFlow id="flow_restore_end" sourceRef="restoreTask" targetRef="end_restore" />
  </bpmn:process>
