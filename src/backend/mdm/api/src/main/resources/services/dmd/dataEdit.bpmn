<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_dataEdit" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-tool" exporterVersion="1.3.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.15.0">
  <bpmn:process id="dataEdit" name="마루 데이터 수정" isExecutable="true">
    <bpmn:documentation>dataEdit — 마루 데이터 수정(05 「화면」 마루 데이터 수정, TSK-07-02 design.md §1·§2).

action=view   -&gt; viewTask   (dataEditService.view)      — 머리·카테고리 요약 카드 조회(잠금 없음, 05 문서)
action=save   -&gt; saveTask   (dataEditService.save)      — 헤더+키 패턴+라벨+lvl_cnt 한 액션(D3). 자기 트랜잭션(R1′)
action=delete -&gt; deleteTask (dataEditService.deprecate) — 폐기. 자기 트랜잭션(R1′)

마루 데이터 선택 목록은 dataMng 의 search 를 호출한다(여기 분기를 두지 않는다, §1). action(RBAC 키)은 MdmActions
16종 안에서만 고른다(D9). save·delete 는 EDIT 세트라 담당자만 쓴다.</bpmn:documentation>
    <bpmn:startEvent id="start" name="시작">
      <bpmn:outgoing>flow_to_gw</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="actionGateway" name="action 분기">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="input" value="action" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_to_gw</bpmn:incoming>
      <bpmn:outgoing>flow_view</bpmn:outgoing>
      <bpmn:outgoing>flow_save</bpmn:outgoing>
      <bpmn:outgoing>flow_delete</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="viewTask" name="마루 데이터 수정 머리 조회" camunda:class="dataEditService">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="view" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mdm.dmd.dataEdit.dto.DataEditViewRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_view</bpmn:incoming>
      <bpmn:outgoing>flow_view_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_view" name="머리 조회 완료">
      <bpmn:incoming>flow_view_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="saveTask" name="마루 데이터 헤더 저장" camunda:class="dataEditService">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="save" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mdm.dmd.dataEdit.dto.DataEditHeaderSaveRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_save</bpmn:incoming>
      <bpmn:outgoing>flow_save_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_save" name="저장 완료">
      <bpmn:incoming>flow_save_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="deleteTask" name="마루 데이터 폐기" camunda:class="dataEditService">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="deprecate" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mdm.dmd.dataEdit.dto.DataEditDeprecateRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_delete</bpmn:incoming>
      <bpmn:outgoing>flow_delete_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_delete" name="폐기 완료">
      <bpmn:incoming>flow_delete_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_to_gw" sourceRef="start" targetRef="actionGateway" />
    <bpmn:sequenceFlow id="flow_view" name="view" sourceRef="actionGateway" targetRef="viewTask" />
    <bpmn:sequenceFlow id="flow_view_end" sourceRef="viewTask" targetRef="end_view" />
    <bpmn:sequenceFlow id="flow_save" name="save" sourceRef="actionGateway" targetRef="saveTask" />
    <bpmn:sequenceFlow id="flow_save_end" sourceRef="saveTask" targetRef="end_save" />
    <bpmn:sequenceFlow id="flow_delete" name="delete" sourceRef="actionGateway" targetRef="deleteTask" />
    <bpmn:sequenceFlow id="flow_delete_end" sourceRef="deleteTask" targetRef="end_delete" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="dataEdit">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="152" y="132" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="actionGateway_di" bpmnElement="actionGateway" isMarkerVisible="true">
        <dc:Bounds x="245" y="125" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="viewTask_di" bpmnElement="viewTask">
        <dc:Bounds x="380" y="60" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_view_di" bpmnElement="end_view">
        <dc:Bounds x="560" y="82" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="saveTask_di" bpmnElement="saveTask">
        <dc:Bounds x="380" y="180" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_save_di" bpmnElement="end_save">
        <dc:Bounds x="560" y="202" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="deleteTask_di" bpmnElement="deleteTask">
        <dc:Bounds x="380" y="300" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_delete_di" bpmnElement="end_delete">
        <dc:Bounds x="560" y="322" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_to_gw_di" bpmnElement="flow_to_gw">
        <di:waypoint x="188" y="150" />
        <di:waypoint x="245" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_view_di" bpmnElement="flow_view">
        <di:waypoint x="270" y="125" />
        <di:waypoint x="270" y="100" />
        <di:waypoint x="380" y="100" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="305" y="83" width="32" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_view_end_di" bpmnElement="flow_view_end">
        <di:waypoint x="480" y="100" />
        <di:waypoint x="560" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_save_di" bpmnElement="flow_save">
        <di:waypoint x="270" y="175" />
        <di:waypoint x="270" y="220" />
        <di:waypoint x="380" y="220" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="305" y="203" width="32" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_save_end_di" bpmnElement="flow_save_end">
        <di:waypoint x="480" y="220" />
        <di:waypoint x="560" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_delete_di" bpmnElement="flow_delete">
        <di:waypoint x="270" y="175" />
        <di:waypoint x="270" y="340" />
        <di:waypoint x="380" y="340" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="305" y="323" width="48" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_delete_end_di" bpmnElement="flow_delete_end">
        <di:waypoint x="480" y="340" />
        <di:waypoint x="560" y="340" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
