<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_ruleSetEdit" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-tool" exporterVersion="1.3.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.15.0">
  <bpmn:process id="ruleSetEdit" name="룰 세트 편집" isExecutable="true">
    <bpmn:documentation>ruleSetEdit — 룰 세트 편집 (To-Be only 신규 화면, dme 업무기준).
정본: docs/mdm/screens/ruleSetEdit/ruleSetEdit_기능설계서.md, TSK-08-06 design.md §6.6·§6.12.

action=search  -&gt; searchTask  (ruleSetEditService.search)  READ — target SET(세트 고르기)·RULE(룰 추가 후보 + 입출력)·GUIDE(구성 지침)
action=view    -&gt; viewTask    (ruleSetEditService.view)    READ — 세트·멤버 입출력·검사·editable·restorable (cases 포함)
action=save    -&gt; saveTask    (ruleSetEditService.save)    EDIT — 서버 재계산 검사 통과 시 세트명·설명·룰 목록 저장(거부 MDM024) (part=CASE 케이스 저장·caseDeleted 삭제)
action=delete  -&gt; deleteTask  (ruleSetEditService.delete)  EDIT — 폐기(INUSE -&gt; DEPRECATED)
action=restore -&gt; restoreTask (ruleSetEditService.restore) EDIT — 되살리기(검사 통과 시 DEPRECATED -&gt; INUSE)
action=validate -&gt; validateTask (ruleSetEditService.condIo)   EDIT — 편집 중 흐름의 IF 갈래 조건식 입력(params.flowJson, 원장에 쓰지 않음) (exprText 면 식 파싱)
action=execute  -&gt; executeTask  (ruleSetEditService.simulate) EDIT — 저장 전 흐름 기록 실행 = 디버거(params.flowJson·recordJson·evalTs, 엔진 스키마 RunTrace) (runCases 면 케이스 일괄 실행)

BPMN 의 action(RBAC 키)과 서비스의 method(자바 메서드명)는 별개다. search 의 갈래(target)는 Java 가 가른다(두 번째 게이트웨이 금지).
세트에는 버전·DRAFT·선점이 없고 ROW_VERSION(MDM001)으로만 동시 편집을 막는다. 담당자 역할은 서버가 RuleStewardCheck 로 다시 본다(MDM013).</bpmn:documentation>
    <bpmn:startEvent id="start" name="시작">
      <bpmn:outgoing>flow_to_gw</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="actionGateway" name="action 분기">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="input" value="action" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_to_gw</bpmn:incoming>
      <bpmn:outgoing>flow_search</bpmn:outgoing>
      <bpmn:outgoing>flow_view</bpmn:outgoing>
      <bpmn:outgoing>flow_save</bpmn:outgoing>
      <bpmn:outgoing>flow_delete</bpmn:outgoing>
      <bpmn:outgoing>flow_restore</bpmn:outgoing>
      <bpmn:outgoing>flow_validate</bpmn:outgoing>
      <bpmn:outgoing>flow_execute</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="searchTask" name="세트·룰 찾기·구성 지침" camunda:class="ruleSetEditService">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="search" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mdm.dme.ruleSetEdit.dto.RuleSetEditSearchRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_search</bpmn:incoming>
      <bpmn:outgoing>flow_search_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="viewTask" name="세트 조회" camunda:class="ruleSetEditService">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="view" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mdm.dme.ruleSetEdit.dto.RuleSetViewRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_view</bpmn:incoming>
      <bpmn:outgoing>flow_view_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="saveTask" name="세트 저장" camunda:class="ruleSetEditService">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="save" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mdm.dme.ruleSetEdit.dto.RuleSetSaveRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_save</bpmn:incoming>
      <bpmn:outgoing>flow_save_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="deleteTask" name="세트 폐기" camunda:class="ruleSetEditService">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="delete" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mdm.dme.ruleSetEdit.dto.RuleSetStatusRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_delete</bpmn:incoming>
      <bpmn:outgoing>flow_delete_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="restoreTask" name="세트 되살리기" camunda:class="ruleSetEditService">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="restore" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mdm.dme.ruleSetEdit.dto.RuleSetStatusRequest" />
