      </bpmn:extensionElements>
      <bpmn:incoming>flow_restore</bpmn:incoming>
      <bpmn:outgoing>flow_restore_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="endSearch" name="찾기 완료">
      <bpmn:incoming>flow_search_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="endView" name="조회 완료">
      <bpmn:incoming>flow_view_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="endSave" name="저장 완료">
      <bpmn:incoming>flow_save_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="endDelete" name="폐기 완료">
      <bpmn:incoming>flow_delete_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="endRestore" name="되살리기 완료">
      <bpmn:incoming>flow_restore_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_to_gw" sourceRef="start" targetRef="actionGateway" />
    <bpmn:sequenceFlow id="flow_search" name="search" sourceRef="actionGateway" targetRef="searchTask" />
    <bpmn:sequenceFlow id="flow_view" name="view" sourceRef="actionGateway" targetRef="viewTask" />
    <bpmn:sequenceFlow id="flow_save" name="save" sourceRef="actionGateway" targetRef="saveTask" />
    <bpmn:sequenceFlow id="flow_delete" name="delete" sourceRef="actionGateway" targetRef="deleteTask" />
    <bpmn:sequenceFlow id="flow_restore" name="restore" sourceRef="actionGateway" targetRef="restoreTask" />
    <bpmn:sequenceFlow id="flow_search_end" sourceRef="searchTask" targetRef="endSearch" />
    <bpmn:sequenceFlow id="flow_view_end" sourceRef="viewTask" targetRef="endView" />
    <bpmn:sequenceFlow id="flow_save_end" sourceRef="saveTask" targetRef="endSave" />
    <bpmn:sequenceFlow id="flow_delete_end" sourceRef="deleteTask" targetRef="endDelete" />
    <bpmn:sequenceFlow id="flow_restore_end" sourceRef="restoreTask" targetRef="endRestore" />
    <bpmn:serviceTask id="validateTask" name="조건식 IO" camunda:class="ruleSetEditService">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="condIo" />
