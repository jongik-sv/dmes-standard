<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_dataCsvUploadPop" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-tool" exporterVersion="1.3.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.15.0">
  <bpmn:process id="dataCsvUploadPop" name="CSV 업로드" isExecutable="true">
    <bpmn:documentation>dataCsvUploadPop — CSV 업로드(05 「CSV 업로드」, TSK-07-04 design.md B2). 독립 화면이 아니라
dataItemMng 화면이 여는 팝업이다(D2, page.tsx·메뉴 leaf 없음).

action=validate -&gt; validateTask (dataCsvUploadPopService.validate) — dryRun 검증, 아무 것도 쓰지 않는다
action=save     -&gt; saveTask     (dataCsvUploadPopService.save)     — 실제 저장, 오류 0건일 때만 한 트랜잭션

action(RBAC 키)은 MdmActions 안에서만 고른다(D9 와 같은 원칙). validate 는 dataItemMng.bpmn 의 view·search 같은
읽기 취급이 아니라 save 와 함께 EDIT 세트로 묶는다 — 팝업 진입 자체가 "CSV 업로드" 버튼(EDIT 권한 가드, 화면
design.md 「수정」 pages/dmd/dataItemMng/page.tsx)을 통해서만 열리므로 validate 만 따로 READ 권한으로 열 수 있게
두지 않는다(MdmPermissions.READ_ACTIONS 는 search·view·export·compare 뿐이고 이 작업은 건드리지 않는다).</bpmn:documentation>
    <bpmn:startEvent id="start" name="시작">
      <bpmn:outgoing>flow_to_gw</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="actionGateway" name="action 분기">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="input" value="action" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_to_gw</bpmn:incoming>
      <bpmn:outgoing>flow_validate</bpmn:outgoing>
      <bpmn:outgoing>flow_save</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="validateTask" name="CSV 검증" camunda:class="dataCsvUploadPopService">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="validate" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mdm.dmd.dataCsvUploadPop.dto.DataCsvValidateRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_validate</bpmn:incoming>
      <bpmn:outgoing>flow_validate_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_validate" name="검증 완료">
      <bpmn:incoming>flow_validate_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="saveTask" name="CSV 저장" camunda:class="dataCsvUploadPopService">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="save" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mdm.dmd.dataCsvUploadPop.dto.DataCsvSaveRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_save</bpmn:incoming>
      <bpmn:outgoing>flow_save_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_save" name="저장 완료">
      <bpmn:incoming>flow_save_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_to_gw" sourceRef="start" targetRef="actionGateway" />
    <bpmn:sequenceFlow id="flow_validate" name="validate" sourceRef="actionGateway" targetRef="validateTask" />
    <bpmn:sequenceFlow id="flow_validate_end" sourceRef="validateTask" targetRef="end_validate" />
    <bpmn:sequenceFlow id="flow_save" name="save" sourceRef="actionGateway" targetRef="saveTask" />
    <bpmn:sequenceFlow id="flow_save_end" sourceRef="saveTask" targetRef="end_save" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="dataCsvUploadPop">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="152" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="actionGateway_di" bpmnElement="actionGateway" isMarkerVisible="true">
        <dc:Bounds x="245" y="175" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="validateTask_di" bpmnElement="validateTask">
        <dc:Bounds x="380" y="60" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_validate_di" bpmnElement="end_validate">
        <dc:Bounds x="560" y="82" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="saveTask_di" bpmnElement="saveTask">
        <dc:Bounds x="380" y="180" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_save_di" bpmnElement="end_save">
        <dc:Bounds x="560" y="202" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_to_gw_di" bpmnElement="flow_to_gw">
        <di:waypoint x="188" y="200" />
        <di:waypoint x="245" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_validate_di" bpmnElement="flow_validate">
        <di:waypoint x="270" y="175" />
        <di:waypoint x="270" y="100" />
        <di:waypoint x="380" y="100" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="305" y="83" width="40" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_validate_end_di" bpmnElement="flow_validate_end">
        <di:waypoint x="480" y="100" />
        <di:waypoint x="560" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_save_di" bpmnElement="flow_save">
        <di:waypoint x="270" y="225" />
        <di:waypoint x="270" y="220" />
        <di:waypoint x="380" y="220" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="305" y="203" width="24" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_save_end_di" bpmnElement="flow_save_end">
        <di:waypoint x="480" y="220" />
        <di:waypoint x="560" y="220" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
