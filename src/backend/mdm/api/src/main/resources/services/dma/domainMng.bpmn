        <di:waypoint x="500" y="520" />
        <di:waypoint x="600" y="520" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_execute_di" bpmnElement="flow_execute">
        <di:waypoint x="270" y="545" />
        <di:waypoint x="270" y="700" />
        <di:waypoint x="400" y="700" />
