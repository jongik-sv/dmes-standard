<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_domainMng" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-tool" exporterVersion="1.3.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.15.0">
  <bpmn:process id="domainMng" name="도메인 관리" isExecutable="true">
    <bpmn:documentation>domainMng — 도메인 관리 (To-Be only 신규 화면).
정본: docs/mdm/screens/domainMng/domainMng_기능설계서.md, docs/mdm/tasks/TSK-04-03/design.md §3.1

action=search|view|validate|execute|save -&gt; {action}Task (domainMngService.{action}). 쓰기는 save 만.</bpmn:documentation>
    <bpmn:startEvent id="start" name="시작">
      <bpmn:outgoing>flow_to_gw</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="actionGateway" name="action 분기">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="input" value="action" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_to_gw</bpmn:incoming>
      <bpmn:outgoing>flow_search</bpmn:outgoing>
      <bpmn:outgoing>flow_view</bpmn:outgoing>
      <bpmn:outgoing>flow_validate</bpmn:outgoing>
      <bpmn:outgoing>flow_execute</bpmn:outgoing>
      <bpmn:outgoing>flow_save</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="searchTask" name="도메인 트리 조회" camunda:class="domainMngService">
      <bpmn:documentation>기능설계서 §3 S-001·S-002 — 일치 행과 그 조상을 DFS 순서로. 응답 result.domains.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="search" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mdm.dma.domainMng.dto.DomainMngSearchRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_search</bpmn:incoming>
      <bpmn:outgoing>flow_search_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_search" name="도메인 트리 조회 완료">
      <bpmn:incoming>flow_search_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="viewTask" name="도메인 상세·영향도" camunda:class="domainMngService">
      <bpmn:documentation>기능설계서 §5.2 행 선택 — 상세·요구 변수·영향도(03·06 은 SPI 집계). 응답 result.domain·requiredVars·impact.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="view" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mdm.dma.domainMng.dto.DomainMngViewRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_view</bpmn:incoming>
      <bpmn:outgoing>flow_view_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_view" name="도메인 상세·영향도 완료">
      <bpmn:incoming>flow_view_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="validateTask" name="도메인검증" camunda:class="domainMngService">
      <bpmn:documentation>기능설계서 B-004 — 거부 조건 R01~R10·S01~S06 전부 수집 + 테스트 케이스 실행 + 분류·diff·영향도. 쓰기 없음. grids testCases·examples.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="validate" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mdm.dma.domainMng.dto.DomainDraftRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_validate</bpmn:incoming>
      <bpmn:outgoing>flow_validate_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_validate" name="도메인검증 완료">
      <bpmn:incoming>flow_validate_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="executeTask" name="서버 미리보기" camunda:class="domainMngService">
      <bpmn:documentation>기능설계서 §5.1 자동 서버 미리보기 — 초안 식으로 value·vars 한 번 판정. 쓰기 없음. grids vars.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="execute" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mdm.dma.domainMng.dto.DomainPreviewRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_execute</bpmn:incoming>
      <bpmn:outgoing>flow_execute_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_execute" name="서버 미리보기 완료">
      <bpmn:incoming>flow_execute_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="saveTask" name="도메인 저장" camunda:class="domainMngService">
      <bpmn:documentation>기능설계서 B-005 — 검사 후 TB_MDM_DOMAIN 1행 saveAndFlush, 값 정의 변경이면 같은 트랜잭션에서 하위 도메인 재검사 후 실패 시 예외로 전체 롤백.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="save" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mdm.dma.domainMng.dto.DomainDraftRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_save</bpmn:incoming>
      <bpmn:outgoing>flow_save_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_save" name="도메인 저장 완료">
      <bpmn:incoming>flow_save_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_to_gw" sourceRef="start" targetRef="actionGateway" />
    <bpmn:sequenceFlow id="flow_search" name="search" sourceRef="actionGateway" targetRef="searchTask" />
    <bpmn:sequenceFlow id="flow_search_end" sourceRef="searchTask" targetRef="end_search" />
    <bpmn:sequenceFlow id="flow_view" name="view" sourceRef="actionGateway" targetRef="viewTask" />
    <bpmn:sequenceFlow id="flow_view_end" sourceRef="viewTask" targetRef="end_view" />
    <bpmn:sequenceFlow id="flow_validate" name="validate" sourceRef="actionGateway" targetRef="validateTask" />
    <bpmn:sequenceFlow id="flow_validate_end" sourceRef="validateTask" targetRef="end_validate" />
    <bpmn:sequenceFlow id="flow_execute" name="execute" sourceRef="actionGateway" targetRef="executeTask" />
    <bpmn:sequenceFlow id="flow_execute_end" sourceRef="executeTask" targetRef="end_execute" />
    <bpmn:sequenceFlow id="flow_save" name="save" sourceRef="actionGateway" targetRef="saveTask" />
    <bpmn:sequenceFlow id="flow_save_end" sourceRef="saveTask" targetRef="end_save" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="domainMng">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="152" y="502" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="actionGateway_di" bpmnElement="actionGateway" isMarkerVisible="true">
        <dc:Bounds x="245" y="495" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="searchTask_di" bpmnElement="searchTask">
        <dc:Bounds x="400" y="120" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_search_di" bpmnElement="end_search">
        <dc:Bounds x="600" y="142" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="viewTask_di" bpmnElement="viewTask">
        <dc:Bounds x="400" y="300" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_view_di" bpmnElement="end_view">
        <dc:Bounds x="600" y="322" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="validateTask_di" bpmnElement="validateTask">
        <dc:Bounds x="400" y="480" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_validate_di" bpmnElement="end_validate">
        <dc:Bounds x="600" y="502" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="executeTask_di" bpmnElement="executeTask">
        <dc:Bounds x="400" y="660" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_execute_di" bpmnElement="end_execute">
        <dc:Bounds x="600" y="682" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="saveTask_di" bpmnElement="saveTask">
        <dc:Bounds x="400" y="840" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_save_di" bpmnElement="end_save">
        <dc:Bounds x="600" y="862" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_to_gw_di" bpmnElement="flow_to_gw">
        <di:waypoint x="188" y="520" />
        <di:waypoint x="245" y="520" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_search_di" bpmnElement="flow_search">
