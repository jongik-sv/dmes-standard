<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_ruleSetMng" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-tool" exporterVersion="1.3.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.15.0">
  <bpmn:process id="ruleSetMng" name="룰 세트" isExecutable="true">
    <bpmn:documentation>ruleSetMng — 룰 세트 조회·등록 (To-Be only 신규 화면, dme 업무기준).
정본: docs/mdm/screens/ruleSetMng/ruleSetMng_기능설계서.md, TSK-08-06 design.md §6.7·§6.12.

action=search -&gt; searchTask (ruleSetMngService.search)   READ — 조건 넷(세트·담은 룰·결과 변수·상태)·서버 페이징, 계산 칸(최종 결과 변수·입력 변수 수·거부·경고 수) 포함
action=reg    -&gt; regTask    (ruleSetMngService.register) EDIT — 빈 세트 등록(TB_MDM_RULE_SET 한 행, INUSE·룰 없음·row_version 0)

BPMN 의 action(RBAC 키)과 서비스의 method(자바 메서드명)는 별개다. 담당자 역할은 서버가 RuleStewardCheck 로 다시 본다(MDM013).</bpmn:documentation>
    <bpmn:startEvent id="start" name="시작">
      <bpmn:outgoing>flow_to_gw</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="actionGateway" name="action 분기">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="input" value="action" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_to_gw</bpmn:incoming>
      <bpmn:outgoing>flow_search</bpmn:outgoing>
      <bpmn:outgoing>flow_reg</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="searchTask" name="룰 세트 목록 조회" camunda:class="ruleSetMngService">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="search" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mdm.dme.ruleSetMng.dto.RuleSetSearchRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_search</bpmn:incoming>
      <bpmn:outgoing>flow_search_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="regTask" name="룰 세트 등록" camunda:class="ruleSetMngService">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="register" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mdm.dme.ruleSetMng.dto.RuleSetRegRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_reg</bpmn:incoming>
      <bpmn:outgoing>flow_reg_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="endSearch" name="조회 완료">
      <bpmn:incoming>flow_search_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="endReg" name="등록 완료">
      <bpmn:incoming>flow_reg_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_to_gw" sourceRef="start" targetRef="actionGateway" />
    <bpmn:sequenceFlow id="flow_search" name="search" sourceRef="actionGateway" targetRef="searchTask" />
    <bpmn:sequenceFlow id="flow_reg" name="reg" sourceRef="actionGateway" targetRef="regTask" />
    <bpmn:sequenceFlow id="flow_search_end" sourceRef="searchTask" targetRef="endSearch" />
    <bpmn:sequenceFlow id="flow_reg_end" sourceRef="regTask" targetRef="endReg" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="ruleSetMng">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="150" y="200" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="actionGateway_di" bpmnElement="actionGateway" isMarkerVisible="true">
        <dc:Bounds x="250" y="200" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="searchTask_di" bpmnElement="searchTask">
        <dc:Bounds x="400" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="regTask_di" bpmnElement="regTask">
        <dc:Bounds x="400" y="300" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endSearch_di" bpmnElement="endSearch">
        <dc:Bounds x="600" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endReg_di" bpmnElement="endReg">
        <dc:Bounds x="600" y="300" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_to_gw_di" bpmnElement="flow_to_gw">
        <di:waypoint x="186" y="218" />
        <di:waypoint x="250" y="225" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_search_di" bpmnElement="flow_search">
        <di:waypoint x="275" y="200" />
        <di:waypoint x="275" y="140" />
        <di:waypoint x="400" y="140" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="317.5" y="123" width="48" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_reg_di" bpmnElement="flow_reg">
        <di:waypoint x="275" y="250" />
        <di:waypoint x="275" y="340" />
        <di:waypoint x="400" y="340" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="317.5" y="233" width="24" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_search_end_di" bpmnElement="flow_search_end">
        <di:waypoint x="500" y="140" />
        <di:waypoint x="600" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_reg_end_di" bpmnElement="flow_reg_end">
        <di:waypoint x="500" y="340" />
        <di:waypoint x="600" y="318" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

