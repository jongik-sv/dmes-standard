<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_codeEdit" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-tool" exporterVersion="1.3.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.15.0">
  <bpmn:process id="codeEdit" name="마루 코드 수정" isExecutable="true">
    <bpmn:documentation>codeEdit — 마루 코드 수정(헤더·라벨·폐기·버전) (To-Be only 신규 화면. As-Is 레거시 없음).
정본: docs/mdm/screens/codeEdit/codeEdit_기능설계서.md, TSK-06-02 design.md §6.1·§6.8.

action=search  -&gt; searchTask  (codeEditService.searchCodes) — 코드 선택 목록
action=view    -&gt; viewTask    (codeEditService.view)        — 헤더·버전 목록·버튼 판정값
action=save    -&gt; saveTask    (codeEditService.saveHeader)  — 헤더 경미 수정(I19)
action=execute -&gt; executeTask (codeEditService.deprecate)   — DEPRECATED 전이(I13)
action=reg      -&gt; regTask      (codeEditService.createVersion)  — 빈 새 버전(I1~I5·I11)
action=restore  -&gt; restoreTask  (codeEditService.restoreVersion) — 복원 새 버전(I15)
action=delete   -&gt; deleteTask   (codeEditService.delete)         — target 없음: DRAFT 삭제(선분 복구 I14, deleteDraft)
                                                                  target=CODE: RELEASED 된 적 없는 마루 코드 통째 삭제(2026-09-28)
action=lock     -&gt; lockTask     (codeEditService.acquire)        — DRAFT 선점
action=unlock   -&gt; unlockTask   (codeEditService.release)        — DRAFT 해제
action=handover -&gt; handoverTask (codeEditService.handover)       — DRAFT 넘기기
lock·unlock·handover 는 ADR-0003 D5 권장 이름을 문자열로만 쓴다. BFF 권한(MdmActions·PERM_MDM_EDIT)은 TSK-08-02 머지 뒤 연결(D-075).

BPMN 의 action(RBAC 키)과 서비스의 method(자바 메서드명)는 별개다.</bpmn:documentation>
    <bpmn:startEvent id="start" name="시작">
      <bpmn:outgoing>flow_to_gw</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="actionGateway" name="action 분기">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="input" value="action" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_to_gw</bpmn:incoming>
      <bpmn:outgoing>flow_search</bpmn:outgoing>
      <bpmn:outgoing>flow_view</bpmn:outgoing>
      <bpmn:outgoing>flow_save</bpmn:outgoing>
      <bpmn:outgoing>flow_execute</bpmn:outgoing>
      <bpmn:outgoing>flow_reg</bpmn:outgoing>
      <bpmn:outgoing>flow_restore</bpmn:outgoing>
      <bpmn:outgoing>flow_delete</bpmn:outgoing>
      <bpmn:outgoing>flow_lock</bpmn:outgoing>
      <bpmn:outgoing>flow_unlock</bpmn:outgoing>
      <bpmn:outgoing>flow_handover</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="searchTask" name="마루 코드 선택 목록" camunda:class="codeEditService">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="searchCodes" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mdm.dmc.codeEdit.dto.CodeEditSearchRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_search</bpmn:incoming>
      <bpmn:outgoing>flow_search_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_search" name="조회 완료">
      <bpmn:incoming>flow_search_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="viewTask" name="마루 코드 상세 조회" camunda:class="codeEditService">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="view" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mdm.dmc.codeEdit.dto.CodeEditViewRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_view</bpmn:incoming>
      <bpmn:outgoing>flow_view_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_view" name="상세 완료">
      <bpmn:incoming>flow_view_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="saveTask" name="헤더 경미 수정" camunda:class="codeEditService">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="saveHeader" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mdm.dmc.codeEdit.dto.CodeHeaderSaveRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_save</bpmn:incoming>
      <bpmn:outgoing>flow_save_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_save" name="저장 완료">
      <bpmn:incoming>flow_save_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="executeTask" name="마루 코드 폐기" camunda:class="codeEditService">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="deprecate" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mdm.dmc.codeEdit.dto.CodeDeprecateRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_execute</bpmn:incoming>
      <bpmn:outgoing>flow_execute_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_execute" name="폐기 완료">
      <bpmn:incoming>flow_execute_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="regTask" name="새 버전(빈)" camunda:class="codeEditService">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="createVersion" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mdm.dmc.codeEdit.dto.CodeVersionCreateRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_reg</bpmn:incoming>
      <bpmn:outgoing>flow_reg_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_reg" name="새 버전 완료">
      <bpmn:incoming>flow_reg_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="restoreTask" name="새 버전(복원)" camunda:class="codeEditService">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="restoreVersion" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mdm.dmc.codeEdit.dto.CodeVersionRestoreRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_restore</bpmn:incoming>
      <bpmn:outgoing>flow_restore_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_restore" name="복원 완료">
      <bpmn:incoming>flow_restore_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="deleteTask" name="DRAFT·마루 코드 삭제" camunda:class="codeEditService">
      <bpmn:documentation>params.target 으로 메서드 안에서 가른다(조건 흐름을 두지 않는다 — RuleEditService.delete 선례). 비면 DRAFT 삭제, CODE 면 마루 코드 삭제.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="delete" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mdm.dmc.codeEdit.dto.CodeDraftRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_delete</bpmn:incoming>
      <bpmn:outgoing>flow_delete_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_delete" name="삭제 완료">
      <bpmn:incoming>flow_delete_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="lockTask" name="DRAFT 선점" camunda:class="codeEditService">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="acquire" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mdm.dmc.codeEdit.dto.CodeDraftRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_lock</bpmn:incoming>
      <bpmn:outgoing>flow_lock_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_lock" name="선점 완료">
      <bpmn:incoming>flow_lock_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="unlockTask" name="DRAFT 해제" camunda:class="codeEditService">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="release" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mdm.dmc.codeEdit.dto.CodeDraftRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_unlock</bpmn:incoming>
      <bpmn:outgoing>flow_unlock_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_unlock" name="해제 완료">
      <bpmn:incoming>flow_unlock_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="handoverTask" name="DRAFT 넘기기" camunda:class="codeEditService">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="method" value="handover" />
          <camunda:property name="output" value="result" />
          <camunda:property name="dto" value="com.dongkuk.dmes.mdm.dmc.codeEdit.dto.CodeDraftRequest" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_handover</bpmn:incoming>
      <bpmn:outgoing>flow_handover_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_handover" name="넘기기 완료">
      <bpmn:incoming>flow_handover_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_to_gw" sourceRef="start" targetRef="actionGateway" />
    <bpmn:sequenceFlow id="flow_search" name="search" sourceRef="actionGateway" targetRef="searchTask" />
    <bpmn:sequenceFlow id="flow_search_end" sourceRef="searchTask" targetRef="end_search" />
    <bpmn:sequenceFlow id="flow_view" name="view" sourceRef="actionGateway" targetRef="viewTask" />
    <bpmn:sequenceFlow id="flow_view_end" sourceRef="viewTask" targetRef="end_view" />
    <bpmn:sequenceFlow id="flow_save" name="save" sourceRef="actionGateway" targetRef="saveTask" />
    <bpmn:sequenceFlow id="flow_save_end" sourceRef="saveTask" targetRef="end_save" />
    <bpmn:sequenceFlow id="flow_execute" name="execute" sourceRef="actionGateway" targetRef="executeTask" />
    <bpmn:sequenceFlow id="flow_execute_end" sourceRef="executeTask" targetRef="end_execute" />
    <bpmn:sequenceFlow id="flow_reg" name="reg" sourceRef="actionGateway" targetRef="regTask" />
    <bpmn:sequenceFlow id="flow_reg_end" sourceRef="regTask" targetRef="end_reg" />
    <bpmn:sequenceFlow id="flow_restore" name="restore" sourceRef="actionGateway" targetRef="restoreTask" />
    <bpmn:sequenceFlow id="flow_restore_end" sourceRef="restoreTask" targetRef="end_restore" />
    <bpmn:sequenceFlow id="flow_delete" name="delete" sourceRef="actionGateway" targetRef="deleteTask" />
    <bpmn:sequenceFlow id="flow_delete_end" sourceRef="deleteTask" targetRef="end_delete" />
    <bpmn:sequenceFlow id="flow_lock" name="lock" sourceRef="actionGateway" targetRef="lockTask" />
    <bpmn:sequenceFlow id="flow_lock_end" sourceRef="lockTask" targetRef="end_lock" />
    <bpmn:sequenceFlow id="flow_unlock" name="unlock" sourceRef="actionGateway" targetRef="unlockTask" />
    <bpmn:sequenceFlow id="flow_unlock_end" sourceRef="unlockTask" targetRef="end_unlock" />
    <bpmn:sequenceFlow id="flow_handover" name="handover" sourceRef="actionGateway" targetRef="handoverTask" />
    <bpmn:sequenceFlow id="flow_handover_end" sourceRef="handoverTask" targetRef="end_handover" />
  </bpmn:process>
