// ============================================================================
// mcm 공지사항 스키마 (DBML): noticeMgmt(관리) · noticeBoard(홈 공지 위젯·긴급 공지 띠)
//
//   붙여넣는 곳: https://dbdiagram.io/d  (좌측 편집기에 전문 붙여넣기)
//   작성일: 2026-10-07
//   근거:  mcm/lib 엔티티 com.dongkuk.dmes.mcm.notice.entity.{Notice,NoticeTarget}
//          + mls V2·V3·V4 마이그레이션을 합친 최종형(DEC-001 「재검토 → 이전」)
//
// ── 읽기 전 주의 2가지 ───────────────────────────────────────────────────────
//
// 1) 여기의 Ref 는 논리 참조다. DB 에 FK 제약을 두지 않는다(JPA 연관관계 금지 정책).
//    역할을 지워도 공지 저장이 막히지 않아야 하므로 TB_MCM_NOTICE_TARGET.ROLE_ID 에도 FK 가 없다.
//
// 2) audit 9 컬럼은 아래 표에서 뺐다. cactus-core CactusAuditEntity 가 자동 적용한다:
//      C_USR_ID varchar(100) / C_AT timestamp / C_SVC_ID varchar(100) / C_PGM_ID varchar(100)
//      U_USR_ID varchar(100) / U_AT timestamp / U_SVC_ID varchar(100) / U_PGM_ID varchar(100)
//      VER bigint
// ============================================================================

Project mcm_notice {
  database_type: 'PostgreSQL'
  Note: '''
    mcm 모듈의 공지사항 스키마. 2026-10-07 에 mls(TB_MLS_NOTICE·TB_MLS_NOTICE_TARGET)에서 mcm 으로 옮겼다.

    화면 ID 와 메뉴 폴더는 lsh/noticeMgmt 를 그대로 쓴다(즐겨찾기·componentPath 보존).
    운영 스키마는 MCMAPUSER. 로컬은 SQLite(mcm.db) 단일 스키마이고 ddl-auto update 가 테이블을 만든다.
  '''
}

Table TB_MCM_NOTICE {
  NOTICE_ID       varchar(30)   [pk, note: '공지번호. 서버 채번 NT + yyyyMMdd + 4자리']
  TITLE           varchar(200)  [not null, note: '제목. 필수·200자 이하']
  CONTENT         text          [note: '본문. DB 길이 제한 없음(서비스가 20만 자 상한 검증). Oracle CLOB · PostgreSQL TEXT']
  CONTENT_FORMAT  varchar(10)   [not null, default: 'TEXT', note: '본문 형식 TEXT(일반 글) · MD(마크다운) · HTML(서버 소독 HTML)']
  NOTICE_CATEGORY varchar(10)   [not null, default: 'NORMAL', note: '분류 NORMAL(일반) · MAINT(점검) · URGENT(긴급)']
  PIN_YN          varchar(1)    [not null, default: 'N', note: '홈 목록 상단 고정 Y/N']
  TARGET_SCOPE    varchar(10)   [not null, default: 'ALL', note: '게시 대상 ALL(전체 사용자) · ROLE(TB_MCM_NOTICE_TARGET 의 역할만)']
  NOTICE_STATUS   varchar(10)   [not null, note: '게시상태 DRAFT(작성중) · POSTED(게시중) · STOPPED(게시중지)']
  POST_START_DT   date          [note: '게시시작일']
  POST_END_DT     date          [note: '게시종료일']

  indexes {
    NOTICE_STATUS [name: 'IX_TB_MCM_NOTICE_STATUS', note: '조회조건 게시상태와 목록 기본 정렬']
  }

  Note: '''
    공지사항 본체. 소유 화면: noticeMgmt(관리), 읽기 전용 호출: noticeBoard(홈 공지 위젯·긴급 공지 띠).
    audit 9 컬럼은 CactusAuditEntity 가 소유한다.
  '''
}

Table TB_MCM_NOTICE_TARGET {
  NOTICE_ID varchar(30)  [note: '→ TB_MCM_NOTICE.NOTICE_ID']
  ROLE_ID   varchar(100) [note: '→ TB_MCM_SEC_ROLE.ROLE_ID ("ROLE_" 접두 없이 저장)']

  indexes {
    (NOTICE_ID, ROLE_ID) [pk]
    ROLE_ID [name: 'IX_TB_MCM_NOTICE_TARGET_ROLE', note: '홈 조회의 「사용자 역할이 대상에 있는가」 EXISTS']
  }

  Note: '''
    TARGET_SCOPE='ROLE' 인 공지가 어느 역할에게 보이는지 적는다. 요청 시점에 아는 사용자 정보가 역할 ID 목록뿐이라
    역할 그룹이 아니라 역할 단위다. audit 9 컬럼은 CactusAuditEntity 가 소유한다.
  '''
}

// 논리 참조 (FK 제약 없음)
Ref: TB_MCM_NOTICE_TARGET.NOTICE_ID > TB_MCM_NOTICE.NOTICE_ID
Ref: TB_MCM_NOTICE_TARGET.ROLE_ID   > TB_MCM_SEC_ROLE.ROLE_ID

// 참조 대상 (csa-menu.dbml 에 컬럼 정의가 있다)
Table TB_MCM_SEC_ROLE {
  ROLE_ID varchar(30) [pk]
  Note: '역할. 정의는 csa-menu.dbml'
}

TableGroup "공지" {
  TB_MCM_NOTICE
  TB_MCM_NOTICE_TARGET
}
