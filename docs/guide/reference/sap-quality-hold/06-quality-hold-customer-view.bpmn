<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_QualityHoldCustomerView" targetNamespace="urn:sap-quality-hold-reference" exporter="Camunda Modeler" exporterVersion="5.46.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.15.0">
  <bpmn:collaboration id="Collaboration_QualityHoldCustomerView">
    <bpmn:participant id="Participant_QE" name="고객사 품질 · 기술 책임자" processRef="Process_QE" />
    <bpmn:participant id="Participant_S4" name="기준 · 오더 · 재고 관리 (SAP S/4HANA)" processRef="Process_S4" />
    <bpmn:participant id="Participant_PPDS" name="자재 · 설비 · 일정 재계획 (SAP PP/DS)" processRef="Process_PPDS" />
    <bpmn:participant id="Participant_DM" name="현장 시스템 실행 제어 (SAP Digital Manufacturing)" processRef="Process_DM" />
    <bpmn:participant id="Participant_PC" name="생산관리 · 현장 작업자" processRef="Process_PC" />
    <bpmn:messageFlow id="MF_PC_DM_ActualStatus" name="실제 작업 · 자재투입 상태" sourceRef="PC_VerifyActualStatus" targetRef="DM_TraceAffectedWork" />
    <bpmn:messageFlow id="MF_S4_QE_Containment" name="격리 범위와 고객 영향" sourceRef="S4_ContainAffectedScope" targetRef="QE_AssessBusinessImpact" />
    <bpmn:messageFlow id="MF_QE_S4_Revision" name="승인된 새 생산기준" sourceRef="QE_PublishNewStandard" targetRef="S4_RegisterNewStandard" />
    <bpmn:messageFlow id="MF_S4_PPDS_Standard" name="새 자재목록 · 작업순서" sourceRef="S4_PublishPlanningStandard" targetRef="PPDS_PrepareNewPlanningStandard" />
    <bpmn:messageFlow id="MF_S4_PPDS_PlannedOrders" name="미착수 계획오더" sourceRef="S4_RequestPlannedOrderReplan" targetRef="PPDS_RecreatePlannedOrders" />
    <bpmn:messageFlow id="MF_S4_PPDS_ProductionOrders" name="변경 · 대체 생산오더" sourceRef="S4_SendChangedOrders" targetRef="PPDS_AdoptChangedOrders" />
    <bpmn:messageFlow id="MF_S4_DM_OrderChange" name="현장 적용용 변경오더" sourceRef="S4_SendChangedOrders" targetRef="DM_WaitChangedOrder" />
    <bpmn:messageFlow id="MF_PPDS_S4_Plan" name="자재부족 · 납기 영향" sourceRef="PPDS_SendPlanningResult" targetRef="S4_ReceivePlanningResult" />
    <bpmn:messageFlow id="MF_PPDS_DM_Schedule" name="현장에서 실행할 일정" sourceRef="PPDS_SendExecutableSchedule" targetRef="DM_WaitExecutableSchedule" />
    <bpmn:messageFlow id="MF_S4_QE_Readiness" name="오더 · 자재 조치 완료" sourceRef="S4_AdjustParentOrders" targetRef="QE_ReviewReadiness" />
    <bpmn:messageFlow id="MF_QE_DM_Release" name="생산 재개 승인" sourceRef="QE_ApproveResume" targetRef="DM_WaitQualityApproval" />
    <bpmn:messageFlow id="MF_DM_PC_Resume" name="현장 작업 재개 지시" sourceRef="DM_ReleaseChangedWork" targetRef="PC_WaitRelease" />
    <bpmn:textAnnotation id="PC_AnnoPhysicalControl">
      <bpmn:text>시스템 Hold만으로는 현장 격리가 끝나지 않는다.
라벨, 구역, 용기 등으로 의심 자재와 재공품을 물리적으로 구분한다.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="DM_AnnoHold">
      <bpmn:text>SFC는 현장의 개별 작업단위다.
SFC Hold는 해당 작업의 시작과 완료를 막아 실제 생산을 멈춘다.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="QE_AnnoScope">
      <bpmn:text>품질문제는 생산 전 검사, 생산 중 이상, 생산 후 검사,
고객 불만 중 어느 단계에서든 시작할 수 있다.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="QE_AssocScope" sourceRef="QE_ReceiveIssue" targetRef="QE_AnnoScope" />
    <bpmn:textAnnotation id="QE_AnnoStandard">
      <bpmn:text>생산기준 = 무엇을 쓰고(BOM), 어떤 순서로 만들며(Routing),
어느 조합을 적용할지(Production Version) 정한 정보</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="QE_AssocStandard" sourceRef="QE_PublishNewStandard" targetRef="QE_AnnoStandard" />
    <bpmn:textAnnotation id="S4_AnnoStarted">
      <bpmn:text>‘생산 시작’은 오더 Release 여부가 아니라
작업실적, 자재투입, 생산입고, 현장 작업이력으로 판단한다.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="S4_AssocStarted" sourceRef="S4_StartedOrderGate" targetRef="S4_AnnoStarted" />
    <bpmn:textAnnotation id="S4_AnnoComponents">
      <bpmn:text>이미 투입된 자재는 자동으로 되돌리지 않는다.
미투입분은 새로 예약하고, 의심 배치는 격리해 별도 판정한다.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="S4_AssocComponents" sourceRef="S4_HandleComponents" targetRef="S4_AnnoComponents" />
    <bpmn:textAnnotation id="S4_AnnoSAPTerms">
      <bpmn:text>SAP 용어: 자재목록=BOM, 작업순서=Routing,
적용조합=Production Version, 오더에 다시 읽기=Read PP Master Data</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="S4_AssocTerms" sourceRef="S4_RereadNewStandard" targetRef="S4_AnnoSAPTerms" />
    <bpmn:textAnnotation id="PPDS_AnnoRole">
      <bpmn:text>PP/DS는 오더를 자동으로 품질중단시키는 시스템이 아니다.
중단된 공급을 반영해 자재, 설비, 순서와 납기를 다시 계산한다.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="PPDS_AnnoPegging">
      <bpmn:text>SAP의 연결관계(Pegging)는 어떤 자재 공급이
어느 상위제품이나 고객수요에 쓰이는지 보여준다.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="PPDS_AssocPegging" sourceRef="PPDS_TraceDependencies" targetRef="PPDS_AnnoPegging" />
    <bpmn:textAnnotation id="PPDS_AnnoPDS">
      <bpmn:text>계획용 구조(PDS)는 새 자재목록, 작업순서와 생산자원을
PP/DS가 일정계획에 사용할 수 있게 변환한 정보다.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="PPDS_AssocPDS" sourceRef="PPDS_PrepareNewPlanningStandard" targetRef="PPDS_AnnoPDS" />
    <bpmn:textAnnotation id="DM_AnnoVersionPolicy">
      <bpmn:text>한 오더에 생산 중 작업과 미착수 작업이 섞여 있으면
생산 중 작업은 기존 기준, 미착수 작업만 새 기준을 적용한다.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="DM_AssocVersion" sourceRef="DM_MixedWorkGate" targetRef="DM_AnnoVersionPolicy" />
    <bpmn:textAnnotation id="DM_AnnoReleaseRule">
      <bpmn:text>변경오더 + 실행가능 일정 + 품질승인
세 가지가 모두 있어야 현장 작업을 재개한다.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="DM_AssocRelease" sourceRef="DM_WaitQualityApproval" targetRef="DM_AnnoReleaseRule" />
    <bpmn:association id="PC_AssocPhysicalControl" sourceRef="PC_SegregateMaterials" targetRef="PC_AnnoPhysicalControl" />
    <bpmn:association id="DM_AssocHold" sourceRef="DM_HoldAffectedWork" targetRef="DM_AnnoHold" />
    <bpmn:association id="PPDS_AssocRole" sourceRef="PPDS_ReplanCurrentStandard" targetRef="PPDS_AnnoRole" />
  </bpmn:collaboration>
  <bpmn:process id="Process_QE" name="품질문제 판단과 생산 재개 승인" isExecutable="false">
    <bpmn:documentation>생산 전, 생산 중, 생산 후 또는 고객 불만에서 접수된 품질문제의 사업 영향을 판단한다. 생산방법이나 필요 자재를 바꿔야 할 때 새 생산기준을 승인하고, 자재·일정·현장 준비가 끝난 뒤 생산 재개를 승인한다.</bpmn:documentation>
    <bpmn:startEvent id="QE_Start" name="품질문제 발생">
      <bpmn:outgoing>QE_F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="QE_ReceiveIssue" name="문제 접수&#10;전 · 중 · 후 · 고객불만">
      <bpmn:incoming>QE_F01</bpmn:incoming>
      <bpmn:outgoing>QE_F02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="QE_AssessBusinessImpact" name="안전 · 고객 · 납기&#10;영향 확인">
      <bpmn:incoming>QE_F02</bpmn:incoming>
      <bpmn:outgoing>QE_F03</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="QE_ChangeRequiredGate" name="생산기준을&#10;바꿔야 하나?" default="QE_F05">
      <bpmn:incoming>QE_F03</bpmn:incoming>
      <bpmn:outgoing>QE_F04</bpmn:outgoing>
      <bpmn:outgoing>QE_F05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="QE_ApproveDispositionOnly" name="현재 기준으로 재작업 ·&#10;조건부사용 · 폐기 결정">
      <bpmn:incoming>QE_F05</bpmn:incoming>
      <bpmn:outgoing>QE_F06</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="QE_EndNoChange" name="현재 기준 유지">
      <bpmn:incoming>QE_F06</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="QE_DesignNewStandard" name="새 자재목록 · 작업순서&#10;설계">
      <bpmn:incoming>QE_F04</bpmn:incoming>
      <bpmn:outgoing>QE_F07</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="QE_ApproveNewStandard" name="변경안과 적용시점&#10;승인">
      <bpmn:incoming>QE_F07</bpmn:incoming>
      <bpmn:outgoing>QE_F08</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="QE_PublishNewStandard" name="새 생산기준 배포&#10;기존 기준도 보존">
      <bpmn:incoming>QE_F08</bpmn:incoming>
      <bpmn:outgoing>QE_F09</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="QE_ReviewReadiness" name="자재 · 일정 · 현장준비&#10;최종 확인">
      <bpmn:incoming>QE_F09</bpmn:incoming>
      <bpmn:incoming>QE_F13</bpmn:incoming>
      <bpmn:outgoing>QE_F10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="QE_ReadinessGate" name="모두&#10;준비됐나?" default="QE_F12">
      <bpmn:incoming>QE_F10</bpmn:incoming>
      <bpmn:outgoing>QE_F11</bpmn:outgoing>
      <bpmn:outgoing>QE_F12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="QE_CloseReadinessGaps" name="부족 자재 · 일정 · 문서&#10;보완">
      <bpmn:incoming>QE_F12</bpmn:incoming>
      <bpmn:outgoing>QE_F13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="QE_ApproveResume" name="생산 재개 승인">
      <bpmn:incoming>QE_F11</bpmn:incoming>
      <bpmn:outgoing>QE_F14</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="QE_EndChanged" name="새 기준 적용 승인">
      <bpmn:incoming>QE_F14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="QE_F01" sourceRef="QE_Start" targetRef="QE_ReceiveIssue" />
    <bpmn:sequenceFlow id="QE_F02" sourceRef="QE_ReceiveIssue" targetRef="QE_AssessBusinessImpact" />
    <bpmn:sequenceFlow id="QE_F03" sourceRef="QE_AssessBusinessImpact" targetRef="QE_ChangeRequiredGate" />
    <bpmn:sequenceFlow id="QE_F04" name="변경 필요" sourceRef="QE_ChangeRequiredGate" targetRef="QE_DesignNewStandard">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${productionStandardChangeRequired == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="QE_F05" name="변경 불필요" sourceRef="QE_ChangeRequiredGate" targetRef="QE_ApproveDispositionOnly" />
    <bpmn:sequenceFlow id="QE_F06" sourceRef="QE_ApproveDispositionOnly" targetRef="QE_EndNoChange" />
    <bpmn:sequenceFlow id="QE_F07" sourceRef="QE_DesignNewStandard" targetRef="QE_ApproveNewStandard" />
    <bpmn:sequenceFlow id="QE_F08" sourceRef="QE_ApproveNewStandard" targetRef="QE_PublishNewStandard" />
    <bpmn:sequenceFlow id="QE_F09" sourceRef="QE_PublishNewStandard" targetRef="QE_ReviewReadiness" />
    <bpmn:sequenceFlow id="QE_F13" sourceRef="QE_CloseReadinessGaps" targetRef="QE_ReviewReadiness" />
    <bpmn:sequenceFlow id="QE_F10" sourceRef="QE_ReviewReadiness" targetRef="QE_ReadinessGate" />
    <bpmn:sequenceFlow id="QE_F11" name="준비 완료" sourceRef="QE_ReadinessGate" targetRef="QE_ApproveResume">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${resumeReady == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="QE_F12" name="보완 필요" sourceRef="QE_ReadinessGate" targetRef="QE_CloseReadinessGaps" />
    <bpmn:sequenceFlow id="QE_F14" sourceRef="QE_ApproveResume" targetRef="QE_EndChanged" />
  </bpmn:process>
  <bpmn:process id="Process_S4" name="품질 격리와 생산오더 변경" isExecutable="false">
    <bpmn:documentation>SAP S/4HANA에서 문제 재고와 배치를 격리하고 관련 생산오더의 실제 착수 여부를 판정한다. 이미 생산을 시작한 오더는 기존 생산기준으로 처분하며, 완전히 미착수한 계획오더와 생산오더만 새 생산기준 적용 대상으로 처리한다.</bpmn:documentation>
    <bpmn:startEvent id="S4_Start" name="품질중단 요청">
      <bpmn:outgoing>S4_F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="S4_ContainAffectedScope" name="문제 제품 · 재고 · 배치&#10;우선 격리">
      <bpmn:incoming>S4_F01</bpmn:incoming>
      <bpmn:outgoing>S4_F02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="S4_CollectOrderFacts" name="관련 오더와 실제 작업 ·&#10;자재투입 상태 확인">
      <bpmn:incoming>S4_F02</bpmn:incoming>
      <bpmn:outgoing>S4_F03</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="S4_StartedOrderGate" name="이미 생산을&#10;시작했나?" default="S4_F05">
      <bpmn:incoming>S4_F03</bpmn:incoming>
      <bpmn:outgoing>S4_F04</bpmn:outgoing>
      <bpmn:outgoing>S4_F05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="S4_KeepExistingStandard" name="생산 중 오더는&#10;기존 기준 유지">
      <bpmn:incoming>S4_F05</bpmn:incoming>
      <bpmn:outgoing>S4_F06</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="S4_DisposeStartedOrder" name="재작업 · 조건부사용 ·&#10;폐기 처리">
      <bpmn:incoming>S4_F06</bpmn:incoming>
      <bpmn:outgoing>S4_F07</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="S4_EndStartedOrder" name="생산 중 오더 처리 완료">
      <bpmn:incoming>S4_F07</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="S4_SelectUnstartedOrders" name="완전히 미착수한&#10;오더만 선택">
      <bpmn:incoming>S4_F04</bpmn:incoming>
      <bpmn:outgoing>S4_F08</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="S4_ChangeApprovedGate" name="새 생산기준&#10;승인됐나?" default="S4_F10">
      <bpmn:incoming>S4_F08</bpmn:incoming>
      <bpmn:outgoing>S4_F09</bpmn:outgoing>
      <bpmn:outgoing>S4_F10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="S4_AdjustWithoutChange" name="현재 기준으로 처분 ·&#10;일정만 조정">
      <bpmn:incoming>S4_F10</bpmn:incoming>
      <bpmn:outgoing>S4_F11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="S4_EndWithoutChange" name="현재 기준으로 계속">
      <bpmn:incoming>S4_F11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="S4_RegisterNewStandard" name="새 자재목록 · 작업순서 ·&#10;적용조합 등록">
      <bpmn:incoming>S4_F09</bpmn:incoming>
      <bpmn:outgoing>S4_F12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="S4_PublishPlanningStandard" name="새 생산기준을&#10;계획시스템에 전달">
      <bpmn:incoming>S4_F12</bpmn:incoming>
      <bpmn:outgoing>S4_F13</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="S4_OrderTypeGate" name="계획만 있는가,&#10;생산오더인가?" default="S4_F15">
      <bpmn:incoming>S4_F13</bpmn:incoming>
      <bpmn:outgoing>S4_F14</bpmn:outgoing>
      <bpmn:outgoing>S4_F15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="S4_RequestPlannedOrderReplan" name="계획오더를 새 기준으로&#10;다시 만들도록 요청">
      <bpmn:incoming>S4_F14</bpmn:incoming>
      <bpmn:outgoing>S4_F16</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="S4_OrderChangeSafeGate" name="기존 생산오더를&#10;안전하게 바꿀 수 있나?" default="S4_F18">
      <bpmn:incoming>S4_F15</bpmn:incoming>
      <bpmn:outgoing>S4_F17</bpmn:outgoing>
      <bpmn:outgoing>S4_F18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="S4_RereadNewStandard" name="생산오더에 새 기준&#10;다시 읽기">
      <bpmn:incoming>S4_F17</bpmn:incoming>
      <bpmn:outgoing>S4_F19</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="S4_ValidateChangedOrder" name="자재 · 공정 · 원가 ·&#10;가능일 재확인">
      <bpmn:incoming>S4_F19</bpmn:incoming>
      <bpmn:outgoing>S4_F20</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="S4_CreateReplacementOrder" name="미착수 잔량으로&#10;새 생산오더 생성">
      <bpmn:incoming>S4_F18</bpmn:incoming>
      <bpmn:outgoing>S4_F21</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="S4_RetireOldOrder" name="기존 오더의 잔량 ·&#10;예약 정리">
      <bpmn:incoming>S4_F21</bpmn:incoming>
      <bpmn:outgoing>S4_F22</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="S4_MergeOrderChange" name="오더변경&#10;합류">
      <bpmn:incoming>S4_F16</bpmn:incoming>
      <bpmn:incoming>S4_F20</bpmn:incoming>
      <bpmn:incoming>S4_F22</bpmn:incoming>
      <bpmn:outgoing>S4_F23</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="S4_HandleComponents" name="투입 · 미투입 · 의심자재를&#10;나눠 처리">
      <bpmn:incoming>S4_F23</bpmn:incoming>
      <bpmn:outgoing>S4_F24</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="S4_SendChangedOrders" name="변경된 오더를&#10;계획 · 현장에 전달">
      <bpmn:incoming>S4_F24</bpmn:incoming>
      <bpmn:outgoing>S4_F25</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="S4_ReceivePlanningResult" name="새 일정과 부족결과&#10;수신">
      <bpmn:incoming>S4_F25</bpmn:incoming>
      <bpmn:outgoing>S4_F26</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="S4_AdjustParentOrders" name="영향받는 상위제품&#10;오더만 조정">
      <bpmn:incoming>S4_F26</bpmn:incoming>
      <bpmn:outgoing>S4_F27</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="S4_EndChanged" name="오더 · 재고 조치 완료">
      <bpmn:incoming>S4_F27</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="S4_F01" sourceRef="S4_Start" targetRef="S4_ContainAffectedScope" />
    <bpmn:sequenceFlow id="S4_F02" sourceRef="S4_ContainAffectedScope" targetRef="S4_CollectOrderFacts" />
    <bpmn:sequenceFlow id="S4_F03" sourceRef="S4_CollectOrderFacts" targetRef="S4_StartedOrderGate" />
    <bpmn:sequenceFlow id="S4_F04" name="완전 미착수" sourceRef="S4_StartedOrderGate" targetRef="S4_SelectUnstartedOrders">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${orderStarted == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="S4_F05" name="착수 또는 불명확" sourceRef="S4_StartedOrderGate" targetRef="S4_KeepExistingStandard" />
    <bpmn:sequenceFlow id="S4_F06" sourceRef="S4_KeepExistingStandard" targetRef="S4_DisposeStartedOrder" />
    <bpmn:sequenceFlow id="S4_F07" sourceRef="S4_DisposeStartedOrder" targetRef="S4_EndStartedOrder" />
    <bpmn:sequenceFlow id="S4_F08" sourceRef="S4_SelectUnstartedOrders" targetRef="S4_ChangeApprovedGate" />
    <bpmn:sequenceFlow id="S4_F09" name="승인됨" sourceRef="S4_ChangeApprovedGate" targetRef="S4_RegisterNewStandard">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${newStandardApproved == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="S4_F10" name="변경 없음" sourceRef="S4_ChangeApprovedGate" targetRef="S4_AdjustWithoutChange" />
    <bpmn:sequenceFlow id="S4_F11" sourceRef="S4_AdjustWithoutChange" targetRef="S4_EndWithoutChange" />
    <bpmn:sequenceFlow id="S4_F12" sourceRef="S4_RegisterNewStandard" targetRef="S4_PublishPlanningStandard" />
    <bpmn:sequenceFlow id="S4_F13" sourceRef="S4_PublishPlanningStandard" targetRef="S4_OrderTypeGate" />
    <bpmn:sequenceFlow id="S4_F14" name="계획오더" sourceRef="S4_OrderTypeGate" targetRef="S4_RequestPlannedOrderReplan">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${plannedOrder == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="S4_F15" name="생산오더" sourceRef="S4_OrderTypeGate" targetRef="S4_OrderChangeSafeGate" />
    <bpmn:sequenceFlow id="S4_F16" sourceRef="S4_RequestPlannedOrderReplan" targetRef="S4_MergeOrderChange" />
    <bpmn:sequenceFlow id="S4_F17" name="변경 가능" sourceRef="S4_OrderChangeSafeGate" targetRef="S4_RereadNewStandard">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${safeToReread == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="S4_F18" name="새 오더 필요" sourceRef="S4_OrderChangeSafeGate" targetRef="S4_CreateReplacementOrder" />
    <bpmn:sequenceFlow id="S4_F19" sourceRef="S4_RereadNewStandard" targetRef="S4_ValidateChangedOrder" />
    <bpmn:sequenceFlow id="S4_F20" sourceRef="S4_ValidateChangedOrder" targetRef="S4_MergeOrderChange" />
    <bpmn:sequenceFlow id="S4_F21" sourceRef="S4_CreateReplacementOrder" targetRef="S4_RetireOldOrder" />
    <bpmn:sequenceFlow id="S4_F22" sourceRef="S4_RetireOldOrder" targetRef="S4_MergeOrderChange" />
    <bpmn:sequenceFlow id="S4_F23" sourceRef="S4_MergeOrderChange" targetRef="S4_HandleComponents" />
    <bpmn:sequenceFlow id="S4_F24" sourceRef="S4_HandleComponents" targetRef="S4_SendChangedOrders" />
    <bpmn:sequenceFlow id="S4_F25" sourceRef="S4_SendChangedOrders" targetRef="S4_ReceivePlanningResult" />
    <bpmn:sequenceFlow id="S4_F26" sourceRef="S4_ReceivePlanningResult" targetRef="S4_AdjustParentOrders" />
    <bpmn:sequenceFlow id="S4_F27" sourceRef="S4_AdjustParentOrders" targetRef="S4_EndChanged" />
  </bpmn:process>
  <bpmn:process id="Process_PPDS" name="종속자재 · 상위제품 · 생산일정 재계획" isExecutable="false">
    <bpmn:documentation>SAP PP/DS에서 품질보류로 사용할 수 없거나 늦어진 공급을 반영하고, 종속자재와 상위제품 오더의 연결관계를 추적한다. 새 생산기준과 변경오더를 반영해 자재부족, 설비능력, 생산순서, 고객 납기 영향을 다시 계산한다.</bpmn:documentation>
    <bpmn:startEvent id="PPDS_Start" name="생산중단 정보">
      <bpmn:outgoing>PPDS_F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="PPDS_TraceDependencies" name="하위 자재와 상위제품&#10;영향 찾기">
      <bpmn:incoming>PPDS_F01</bpmn:incoming>
      <bpmn:outgoing>PPDS_F02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="PPDS_AdjustHeldSupply" name="보류 제품의 사용가능일 ·&#10;수량 조정">
      <bpmn:incoming>PPDS_F02</bpmn:incoming>
      <bpmn:outgoing>PPDS_F03</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="PPDS_ChangeRequiredGate" name="생산기준&#10;변경?" default="PPDS_F05">
      <bpmn:incoming>PPDS_F03</bpmn:incoming>
      <bpmn:outgoing>PPDS_F04</bpmn:outgoing>
      <bpmn:outgoing>PPDS_F05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="PPDS_PrepareNewPlanningStandard" name="새 생산기준을&#10;계획용 구조로 변환">
      <bpmn:incoming>PPDS_F04</bpmn:incoming>
      <bpmn:outgoing>PPDS_F07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:inclusiveGateway id="PPDS_OrderScopeGate" name="변경 대상&#10;오더">
      <bpmn:incoming>PPDS_F07</bpmn:incoming>
      <bpmn:outgoing>PPDS_F08</bpmn:outgoing>
      <bpmn:outgoing>PPDS_F09</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:serviceTask id="PPDS_AdoptChangedOrders" name="변경 · 대체 생산오더의&#10;새 자재와 공정 반영">
      <bpmn:incoming>PPDS_F09</bpmn:incoming>
      <bpmn:outgoing>PPDS_F11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:inclusiveGateway id="PPDS_MergeOrders" name="재계획&#10;합류">
      <bpmn:incoming>PPDS_F06</bpmn:incoming>
      <bpmn:incoming>PPDS_F10</bpmn:incoming>
      <bpmn:incoming>PPDS_F11</bpmn:incoming>
      <bpmn:outgoing>PPDS_F12</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:serviceTask id="PPDS_Reschedule" name="생산순서와 설비일정&#10;다시 계산">
      <bpmn:incoming>PPDS_F12</bpmn:incoming>
      <bpmn:outgoing>PPDS_F13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="PPDS_CheckMaterialsCapacity" name="자재부족 · 설비능력&#10;확인">
      <bpmn:incoming>PPDS_F13</bpmn:incoming>
      <bpmn:outgoing>PPDS_F14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="PPDS_AssessParentImpact" name="상위제품과 고객납기&#10;영향 계산">
      <bpmn:incoming>PPDS_F14</bpmn:incoming>
      <bpmn:outgoing>PPDS_F15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="PPDS_SendPlanningResult" name="조정 결과를&#10;S/4HANA에 전달">
      <bpmn:incoming>PPDS_F15</bpmn:incoming>
      <bpmn:outgoing>PPDS_F16</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="PPDS_SendExecutableSchedule" name="실행할 일정을&#10;현장시스템에 전달">
      <bpmn:incoming>PPDS_F16</bpmn:incoming>
      <bpmn:outgoing>PPDS_F17</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="PPDS_End" name="재계획 완료">
      <bpmn:incoming>PPDS_F17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="PPDS_F01" sourceRef="PPDS_Start" targetRef="PPDS_TraceDependencies" />
    <bpmn:sequenceFlow id="PPDS_F02" sourceRef="PPDS_TraceDependencies" targetRef="PPDS_AdjustHeldSupply" />
    <bpmn:sequenceFlow id="PPDS_F03" sourceRef="PPDS_AdjustHeldSupply" targetRef="PPDS_ChangeRequiredGate" />
    <bpmn:sequenceFlow id="PPDS_F04" name="변경됨" sourceRef="PPDS_ChangeRequiredGate" targetRef="PPDS_PrepareNewPlanningStandard">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${planningStandardChanged == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="PPDS_F05" name="변경 없음" sourceRef="PPDS_ChangeRequiredGate" targetRef="PPDS_ReplanCurrentStandard" />
    <bpmn:sequenceFlow id="PPDS_F06" sourceRef="PPDS_ReplanCurrentStandard" targetRef="PPDS_MergeOrders" />
    <bpmn:sequenceFlow id="PPDS_F07" sourceRef="PPDS_PrepareNewPlanningStandard" targetRef="PPDS_OrderScopeGate" />
    <bpmn:sequenceFlow id="PPDS_F08" name="계획오더" sourceRef="PPDS_OrderScopeGate" targetRef="PPDS_RecreatePlannedOrders">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${hasPlannedOrders == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="PPDS_F09" name="생산오더" sourceRef="PPDS_OrderScopeGate" targetRef="PPDS_AdoptChangedOrders">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${hasProductionOrders == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="PPDS_F10" sourceRef="PPDS_RecreatePlannedOrders" targetRef="PPDS_MergeOrders" />
    <bpmn:sequenceFlow id="PPDS_F11" sourceRef="PPDS_AdoptChangedOrders" targetRef="PPDS_MergeOrders" />
    <bpmn:sequenceFlow id="PPDS_F12" sourceRef="PPDS_MergeOrders" targetRef="PPDS_Reschedule" />
    <bpmn:sequenceFlow id="PPDS_F13" sourceRef="PPDS_Reschedule" targetRef="PPDS_CheckMaterialsCapacity" />
    <bpmn:sequenceFlow id="PPDS_F14" sourceRef="PPDS_CheckMaterialsCapacity" targetRef="PPDS_AssessParentImpact" />
    <bpmn:sequenceFlow id="PPDS_F15" sourceRef="PPDS_AssessParentImpact" targetRef="PPDS_SendPlanningResult" />
    <bpmn:sequenceFlow id="PPDS_F16" sourceRef="PPDS_SendPlanningResult" targetRef="PPDS_SendExecutableSchedule" />
    <bpmn:sequenceFlow id="PPDS_F17" sourceRef="PPDS_SendExecutableSchedule" targetRef="PPDS_End" />
    <bpmn:serviceTask id="PPDS_ReplanCurrentStandard" name="현재 기준으로&#10;일정 다시 계산">
      <bpmn:incoming>PPDS_F05</bpmn:incoming>
      <bpmn:outgoing>PPDS_F06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="PPDS_RecreatePlannedOrders" name="미착수 계획오더를&#10;새 기준으로 다시 만들기">
      <bpmn:incoming>PPDS_F08</bpmn:incoming>
      <bpmn:outgoing>PPDS_F10</bpmn:outgoing>
    </bpmn:serviceTask>
  </bpmn:process>
  <bpmn:process id="Process_DM" name="현장 작업 중단과 새 생산기준 적용" isExecutable="false">
    <bpmn:documentation>SAP Digital Manufacturing에서 문제 작업단위와 관련 WIP를 즉시 Hold한다. 이미 생산을 시작한 작업단위는 기존 생산기준으로 처분하고, 미착수 작업단위만 새 생산기준을 적용한다. 변경오더, 실행일정, 품질 승인 세 가지가 모두 준비될 때까지 Hold를 유지한다.</bpmn:documentation>
    <bpmn:startEvent id="DM_Start" name="현장 품질이상">
      <bpmn:outgoing>DM_F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="DM_RecordIssue" name="문제내용과&#10;검사결과 기록">
      <bpmn:incoming>DM_F01</bpmn:incoming>
      <bpmn:outgoing>DM_F02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="DM_HoldAffectedWork" name="관련 작업 즉시 중단&#10;(SFC Hold)">
      <bpmn:incoming>DM_F02</bpmn:incoming>
      <bpmn:outgoing>DM_F03</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="DM_TraceAffectedWork" name="작업이력 · 배치 ·&#10;투입자재 추적">
      <bpmn:incoming>DM_F03</bpmn:incoming>
      <bpmn:outgoing>DM_F04</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="DM_StartedWorkGate" name="해당 작업을&#10;이미 시작했나?" default="DM_F06">
      <bpmn:incoming>DM_F04</bpmn:incoming>
      <bpmn:outgoing>DM_F05</bpmn:outgoing>
      <bpmn:outgoing>DM_F06</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="DM_KeepExistingStandard" name="생산 중 작업은&#10;기존 기준 유지">
      <bpmn:incoming>DM_F06</bpmn:incoming>
      <bpmn:outgoing>DM_F07</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="DM_DisposeStartedWork" name="재작업 · 조건부사용 ·&#10;폐기 실행">
      <bpmn:incoming>DM_F07</bpmn:incoming>
      <bpmn:outgoing>DM_F08</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="DM_ReleaseStartedWork" name="승인된 기존 기준으로&#10;Hold 해제">
      <bpmn:incoming>DM_F08</bpmn:incoming>
      <bpmn:outgoing>DM_F09</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="DM_EndStartedWork" name="생산 중 작업 처리 완료">
      <bpmn:incoming>DM_F09</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="DM_ChangeApprovedGate" name="새 생산기준&#10;승인?" default="DM_F11">
      <bpmn:incoming>DM_F05</bpmn:incoming>
      <bpmn:outgoing>DM_F10</bpmn:outgoing>
      <bpmn:outgoing>DM_F11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="DM_ResumeWithoutChange" name="현재 기준으로 조치 후&#10;Hold 해제">
      <bpmn:incoming>DM_F11</bpmn:incoming>
      <bpmn:outgoing>DM_F12</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="DM_EndWithoutChange" name="현재 기준으로 재개">
      <bpmn:incoming>DM_F12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:receiveTask id="DM_WaitChangedOrder" name="변경된 생산오더&#10;수신">
      <bpmn:incoming>DM_F10</bpmn:incoming>
      <bpmn:outgoing>DM_F13</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:serviceTask id="DM_ApplyNewStandard" name="새 자재목록 · 작업순서&#10;현장오더에 적용">
      <bpmn:incoming>DM_F13</bpmn:incoming>
      <bpmn:outgoing>DM_F14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="DM_MixedWorkGate" name="같은 오더에&#10;생산 중 작업도 있나?" default="DM_F16">
      <bpmn:incoming>DM_F14</bpmn:incoming>
      <bpmn:outgoing>DM_F15</bpmn:outgoing>
      <bpmn:outgoing>DM_F16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="DM_ApplyAllUnstartedWork" name="미착수 작업 전체에&#10;새 기준 적용">
      <bpmn:incoming>DM_F16</bpmn:incoming>
      <bpmn:outgoing>DM_F17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="DM_ApplySelectedWork" name="미착수 작업만 선택하거나&#10;오더 분리">
      <bpmn:incoming>DM_F15</bpmn:incoming>
      <bpmn:outgoing>DM_F18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="DM_MergeStandardAssignment" name="새 기준&#10;적용 합류">
      <bpmn:incoming>DM_F17</bpmn:incoming>
      <bpmn:incoming>DM_F18</bpmn:incoming>
      <bpmn:outgoing>DM_F19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="DM_KeepHoldUntilReady" name="준비 완료까지&#10;중단상태 유지">
      <bpmn:incoming>DM_F19</bpmn:incoming>
      <bpmn:outgoing>DM_F20</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:receiveTask id="DM_WaitExecutableSchedule" name="실행할 일정&#10;수신">
      <bpmn:incoming>DM_F20</bpmn:incoming>
      <bpmn:outgoing>DM_F21</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:receiveTask id="DM_WaitQualityApproval" name="품질 · 기술의&#10;재개 승인 대기">
      <bpmn:incoming>DM_F21</bpmn:incoming>
      <bpmn:outgoing>DM_F22</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:sendTask id="DM_ReleaseChangedWork" name="새 기준 작업&#10;Hold 해제 · 배정">
      <bpmn:incoming>DM_F22</bpmn:incoming>
      <bpmn:outgoing>DM_F23</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="DM_EndChanged" name="새 기준 생산 준비">
      <bpmn:incoming>DM_F23</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="DM_F01" sourceRef="DM_Start" targetRef="DM_RecordIssue" />
    <bpmn:sequenceFlow id="DM_F02" sourceRef="DM_RecordIssue" targetRef="DM_HoldAffectedWork" />
    <bpmn:sequenceFlow id="DM_F03" sourceRef="DM_HoldAffectedWork" targetRef="DM_TraceAffectedWork" />
    <bpmn:sequenceFlow id="DM_F04" sourceRef="DM_TraceAffectedWork" targetRef="DM_StartedWorkGate" />
    <bpmn:sequenceFlow id="DM_F05" name="완전 미착수" sourceRef="DM_StartedWorkGate" targetRef="DM_ChangeApprovedGate">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${workStarted == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="DM_F06" name="착수 또는 불명확" sourceRef="DM_StartedWorkGate" targetRef="DM_KeepExistingStandard" />
    <bpmn:sequenceFlow id="DM_F07" sourceRef="DM_KeepExistingStandard" targetRef="DM_DisposeStartedWork" />
    <bpmn:sequenceFlow id="DM_F08" sourceRef="DM_DisposeStartedWork" targetRef="DM_ReleaseStartedWork" />
    <bpmn:sequenceFlow id="DM_F09" sourceRef="DM_ReleaseStartedWork" targetRef="DM_EndStartedWork" />
    <bpmn:sequenceFlow id="DM_F10" name="승인됨" sourceRef="DM_ChangeApprovedGate" targetRef="DM_WaitChangedOrder">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${newStandardApproved == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="DM_F11" name="변경 없음" sourceRef="DM_ChangeApprovedGate" targetRef="DM_ResumeWithoutChange" />
    <bpmn:sequenceFlow id="DM_F12" sourceRef="DM_ResumeWithoutChange" targetRef="DM_EndWithoutChange" />
    <bpmn:sequenceFlow id="DM_F13" sourceRef="DM_WaitChangedOrder" targetRef="DM_ApplyNewStandard" />
    <bpmn:sequenceFlow id="DM_F14" sourceRef="DM_ApplyNewStandard" targetRef="DM_MixedWorkGate" />
    <bpmn:sequenceFlow id="DM_F15" name="혼재" sourceRef="DM_MixedWorkGate" targetRef="DM_ApplySelectedWork">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${mixedStartedWork == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="DM_F16" name="모두 미착수" sourceRef="DM_MixedWorkGate" targetRef="DM_ApplyAllUnstartedWork" />
    <bpmn:sequenceFlow id="DM_F17" sourceRef="DM_ApplyAllUnstartedWork" targetRef="DM_MergeStandardAssignment" />
    <bpmn:sequenceFlow id="DM_F18" sourceRef="DM_ApplySelectedWork" targetRef="DM_MergeStandardAssignment" />
    <bpmn:sequenceFlow id="DM_F19" sourceRef="DM_MergeStandardAssignment" targetRef="DM_KeepHoldUntilReady" />
    <bpmn:sequenceFlow id="DM_F20" sourceRef="DM_KeepHoldUntilReady" targetRef="DM_WaitExecutableSchedule" />
    <bpmn:sequenceFlow id="DM_F21" sourceRef="DM_WaitExecutableSchedule" targetRef="DM_WaitQualityApproval" />
    <bpmn:sequenceFlow id="DM_F22" sourceRef="DM_WaitQualityApproval" targetRef="DM_ReleaseChangedWork" />
    <bpmn:sequenceFlow id="DM_F23" sourceRef="DM_ReleaseChangedWork" targetRef="DM_EndChanged" />
  </bpmn:process>
  <bpmn:process id="Process_PC" name="현장 안전정지와 생산 재개" isExecutable="false">
    <bpmn:documentation>생산관리자와 현장 작업자가 설비와 재공품을 안전하게 정지하고, 투입·미투입·의심 자재를 물리적으로 구분한다. 실제 상태를 시스템에 보고하고 승인된 작업지시와 생산기준을 확인한 후 생산을 재개한다.</bpmn:documentation>
    <bpmn:startEvent id="PC_Start" name="중단 지시">
      <bpmn:outgoing>PC_F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:manualTask id="PC_StopSafely" name="설비 · 재공품&#10;안전 정지">
      <bpmn:incoming>PC_F01</bpmn:incoming>
      <bpmn:outgoing>PC_F02</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="PC_SegregateMaterials" name="투입 · 미투입 · 의심자재&#10;표시하고 격리">
      <bpmn:incoming>PC_F02</bpmn:incoming>
      <bpmn:outgoing>PC_F03</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="PC_VerifyActualStatus" name="실제 작업 · 자재투입&#10;상태 확인">
      <bpmn:incoming>PC_F03</bpmn:incoming>
      <bpmn:outgoing>PC_F04</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="PC_ReportActualStatus" name="확인된 현장상태&#10;시스템에 보고">
      <bpmn:incoming>PC_F04</bpmn:incoming>
      <bpmn:outgoing>PC_F05</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="PC_WaitRelease" name="승인된 재개 지시&#10;대기">
      <bpmn:incoming>PC_F05</bpmn:incoming>
      <bpmn:outgoing>PC_F06</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="PC_CheckInstructions" name="새 작업지시 · 자재 ·&#10;생산기준 확인">
      <bpmn:incoming>PC_F06</bpmn:incoming>
      <bpmn:outgoing>PC_F07</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="PC_ResumeProduction" name="승인된 기준으로&#10;생산 재개">
      <bpmn:incoming>PC_F07</bpmn:incoming>
      <bpmn:outgoing>PC_F08</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="PC_End" name="현장 재개 완료">
      <bpmn:incoming>PC_F08</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="PC_F01" sourceRef="PC_Start" targetRef="PC_StopSafely" />
    <bpmn:sequenceFlow id="PC_F02" sourceRef="PC_StopSafely" targetRef="PC_SegregateMaterials" />
    <bpmn:sequenceFlow id="PC_F03" sourceRef="PC_SegregateMaterials" targetRef="PC_VerifyActualStatus" />
    <bpmn:sequenceFlow id="PC_F04" sourceRef="PC_VerifyActualStatus" targetRef="PC_ReportActualStatus" />
    <bpmn:sequenceFlow id="PC_F05" sourceRef="PC_ReportActualStatus" targetRef="PC_WaitRelease" />
    <bpmn:sequenceFlow id="PC_F06" sourceRef="PC_WaitRelease" targetRef="PC_CheckInstructions" />
    <bpmn:sequenceFlow id="PC_F07" sourceRef="PC_CheckInstructions" targetRef="PC_ResumeProduction" />
    <bpmn:sequenceFlow id="PC_F08" sourceRef="PC_ResumeProduction" targetRef="PC_End" />
  </bpmn:process>
