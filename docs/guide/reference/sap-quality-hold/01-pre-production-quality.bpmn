<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PreProductionQuality" targetNamespace="urn:sap-quality-hold-reference" exporter="bpmn-tool" exporterVersion="1.3.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.15.0">
  <bpmn:collaboration id="Collaboration_PreProductionQuality">
    <bpmn:participant id="Participant_PreProductionQuality" name="생산 전 품질 (SAP S/4HANA QM · SAP Digital Manufacturing)" processRef="PreProductionQuality" />
  </bpmn:collaboration>
  <bpmn:process id="PreProductionQuality" name="생산 전 품질 — 계획·승인·출시 관문" isExecutable="false">
    <bpmn:documentation>신규/변경 품목, 공급자, BOM/라우팅에 대해 S/4HANA QM 품질계획, 공급자 품질승인, Source Inspection, SAP Digital Manufacturing 실행 준비를 검증하고 미충족 대상을 생산 투입 전에 보류한다.</bpmn:documentation>
    <bpmn:startEvent id="PRE_Start" name="신규·변경 품목/공급자/공정">
      <bpmn:outgoing>PRE_F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="PRE_QualityPlan" name="[S/4 QM]&#10;검사계획·MIC·샘플링·검사유형 설정">
      <bpmn:incoming>PRE_F01</bpmn:incoming>
      <bpmn:outgoing>PRE_F02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="PRE_SupplierQuality" name="[S/4 QM]&#10;Q-Info·공급자 Release·Source Inspection 설정">
      <bpmn:incoming>PRE_F02</bpmn:incoming>
      <bpmn:outgoing>PRE_F03</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="PRE_QualificationPlanning" name="[S/4 QM]&#10;검사계획 Release·Source Inspection 준비">
      <bpmn:incoming>PRE_F03</bpmn:incoming>
      <bpmn:outgoing>PRE_F04</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="PRE_DMSync" name="[SAP DM]&#10;Material·Routing·검사항목·Buyoff 동기화">
      <bpmn:incoming>PRE_F04</bpmn:incoming>
      <bpmn:incoming>PRE_F09</bpmn:incoming>
      <bpmn:outgoing>PRE_F05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="PRE_ReadinessGateway" name="출시 전제 충족?" default="PRE_F07">
      <bpmn:incoming>PRE_F05</bpmn:incoming>
      <bpmn:outgoing>PRE_F06</bpmn:outgoing>
      <bpmn:outgoing>PRE_F07</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="PRE_ReadinessHold" name="사전 품질 보류 적용&#10;공급자/Q-Info Block 또는&#10;DM Material·Routing·Operation Hold">
      <bpmn:incoming>PRE_F07</bpmn:incoming>
      <bpmn:outgoing>PRE_F08</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="PRE_CloseGap" name="누락 기준·승인·교육·문서 보완">
      <bpmn:incoming>PRE_F08</bpmn:incoming>
      <bpmn:outgoing>PRE_F09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="PRE_InspectionRequired" name="Source Inspection/&#10;Qualification 필요?" default="PRE_F11">
      <bpmn:incoming>PRE_F06</bpmn:incoming>
      <bpmn:outgoing>PRE_F10</bpmn:outgoing>
      <bpmn:outgoing>PRE_F11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="PRE_ExecuteQualification" name="Source Inspection·Qualification Run 실행">
      <bpmn:incoming>PRE_F10</bpmn:incoming>
      <bpmn:incoming>PRE_F17</bpmn:incoming>
      <bpmn:outgoing>PRE_F12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="PRE_RecordQualification" name="검사결과·결함·증빙 기록">
      <bpmn:incoming>PRE_F12</bpmn:incoming>
      <bpmn:outgoing>PRE_F13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="PRE_QualificationGateway" name="승인 가능?" default="PRE_F15">
      <bpmn:incoming>PRE_F13</bpmn:incoming>
      <bpmn:outgoing>PRE_F14</bpmn:outgoing>
      <bpmn:outgoing>PRE_F15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="PRE_QualificationBlock" name="공급자·품목·라우팅 출시 차단&#10;품질이슈/CAPA 발행">
      <bpmn:incoming>PRE_F15</bpmn:incoming>
      <bpmn:outgoing>PRE_F16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="PRE_Requalify" name="시정조치·재자격 평가 준비">
      <bpmn:incoming>PRE_F16</bpmn:incoming>
      <bpmn:outgoing>PRE_F17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="PRE_Release" name="품질 출시 승인&#10;공급·생산 Release 허용">
      <bpmn:incoming>PRE_F11</bpmn:incoming>
      <bpmn:incoming>PRE_F14</bpmn:incoming>
      <bpmn:outgoing>PRE_F18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="PRE_End" name="생산 투입 가능">
      <bpmn:incoming>PRE_F18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="PRE_F01" sourceRef="PRE_Start" targetRef="PRE_QualityPlan" />
    <bpmn:sequenceFlow id="PRE_F02" sourceRef="PRE_QualityPlan" targetRef="PRE_SupplierQuality" />
    <bpmn:sequenceFlow id="PRE_F03" sourceRef="PRE_SupplierQuality" targetRef="PRE_QualificationPlanning" />
    <bpmn:sequenceFlow id="PRE_F04" sourceRef="PRE_QualificationPlanning" targetRef="PRE_DMSync" />
    <bpmn:sequenceFlow id="PRE_F05" sourceRef="PRE_DMSync" targetRef="PRE_ReadinessGateway" />
    <bpmn:sequenceFlow id="PRE_F06" name="충족" sourceRef="PRE_ReadinessGateway" targetRef="PRE_InspectionRequired">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${preProductionReady == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="PRE_F07" name="미충족" sourceRef="PRE_ReadinessGateway" targetRef="PRE_ReadinessHold" />
    <bpmn:sequenceFlow id="PRE_F08" sourceRef="PRE_ReadinessHold" targetRef="PRE_CloseGap" />
    <bpmn:sequenceFlow id="PRE_F09" name="재검증" sourceRef="PRE_CloseGap" targetRef="PRE_DMSync" />
    <bpmn:sequenceFlow id="PRE_F10" name="필요" sourceRef="PRE_InspectionRequired" targetRef="PRE_ExecuteQualification">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${qualificationInspectionRequired == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="PRE_F11" name="불필요" sourceRef="PRE_InspectionRequired" targetRef="PRE_Release" />
    <bpmn:sequenceFlow id="PRE_F12" sourceRef="PRE_ExecuteQualification" targetRef="PRE_RecordQualification" />
    <bpmn:sequenceFlow id="PRE_F13" sourceRef="PRE_RecordQualification" targetRef="PRE_QualificationGateway" />
    <bpmn:sequenceFlow id="PRE_F14" name="합격·승인" sourceRef="PRE_QualificationGateway" targetRef="PRE_Release">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${qualificationAccepted == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="PRE_F15" name="불합격·보류" sourceRef="PRE_QualificationGateway" targetRef="PRE_QualificationBlock" />
    <bpmn:sequenceFlow id="PRE_F16" sourceRef="PRE_QualificationBlock" targetRef="PRE_Requalify" />
    <bpmn:sequenceFlow id="PRE_F17" name="재검사" sourceRef="PRE_Requalify" targetRef="PRE_ExecuteQualification" />
    <bpmn:sequenceFlow id="PRE_F18" sourceRef="PRE_Release" targetRef="PRE_End" />
    <bpmn:textAnnotation id="PRE_Annotation">
      <bpmn:text>사전 보류는 아직 생성되지 않은 재고가 아니라 공급관계·마스터·라우팅·작업 Release를 차단하는 예방적 관문이다.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="PRE_Association" sourceRef="PRE_ReadinessHold" targetRef="PRE_Annotation" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_PreProductionQuality">
      <bpmndi:BPMNShape id="Participant_PreProductionQuality_di" bpmnElement="Participant_PreProductionQuality" isHorizontal="true">
        <dc:Bounds x="30" y="30" width="1786" height="580" />
