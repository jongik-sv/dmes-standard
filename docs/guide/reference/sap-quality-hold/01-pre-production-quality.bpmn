      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PRE_Requalify_di" bpmnElement="PRE_Requalify">
        <dc:Bounds x="1680" y="500" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PRE_Release_di" bpmnElement="PRE_Release">
        <dc:Bounds x="1570" y="230" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PRE_End_di" bpmnElement="PRE_End">
        <dc:Bounds x="1750" y="252" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PRE_Annotation_di" bpmnElement="PRE_Annotation">
        <dc:Bounds x="430" y="70" width="470" height="55" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="PRE_F01_di" bpmnElement="PRE_F01">
        <di:waypoint x="116" y="270" />
        <di:waypoint x="170" y="270" />
      </bpmndi:BPMNEdge>
