      {
        "id": "MF_DM_PC_ResumeChanged",
        "name": "승인된 SFC Release",
        "source": "DM_ReleaseChangedSFC",
        "target": "PC_WaitRelease"
      }
    ]
  },
  "processes": [
    {
      "id": "Process_QE",
      "name": "품질 · 기술변경 의사결정",
      "isExecutable": false,
      "documentation": "품질이상의 기술적 처분과 Engineering Change를 승인한다. 생산 중 오더는 기존 개정을 유지하고 미착수 오더만 신규 BOM, Routing, Production Version 적용 대상으로 승인한다.",
      "nodes": [
        {
          "id": "QE_Start",
          "type": "bpmn:StartEvent",
          "name": "품질이상 접수",
          "x": 100,
          "y": 172
        },
        {
          "id": "QE_AssessChangeNeed",
          "type": "bpmn:UserTask",
          "name": "NCR · Q3 · 페깅 영향\n기술검토",
          "x": 260,
          "y": 150
        },
        {
          "id": "QE_RevisionRequiredGate",
          "type": "bpmn:ExclusiveGateway",
          "name": "BOM 또는\nRouting 개정?",
          "x": 440,
          "y": 165
        },
        {
          "id": "QE_ApproveDispositionOnly",
          "type": "bpmn:UserTask",
          "name": "기존 개정 기준\n재작업 · 특채 · 폐기 승인",
          "x": 610,
          "y": 70
        },
        {
          "id": "QE_EndNoRevision",
          "type": "bpmn:EndEvent",
          "name": "마스터 변경 없음",
          "x": 800,
          "y": 92
        },
        {
          "id": "QE_CreateEngineeringChange",
          "type": "bpmn:UserTask",
          "name": "Change Number · Revision\n유효일 생성",
          "x": 610,
          "y": 220
        },
        {
          "id": "QE_ApproveRevision",
          "type": "bpmn:UserTask",
          "name": "신규 BOM · Routing ·\n생산버전 승인",
          "x": 790,
          "y": 220
        },
        {
          "id": "QE_PublishRevision",
          "type": "bpmn:SendTask",
          "name": "개정판 Publish\n기존판 WIP용 유지",
          "x": 1140,
          "y": 220
        },
        {
          "id": "QE_ReviewReadiness",
          "type": "bpmn:UserTask",
          "name": "계획 · 오더 · 구성품 ·\n실행준비 통합검토",
          "x": 4150,
          "y": 150
        },
        {
          "id": "QE_ReadinessGate",
          "type": "bpmn:ExclusiveGateway",
          "name": "재개 준비\n완료?",
          "x": 4340,
          "y": 165
        },
        {
          "id": "QE_CloseReadinessGaps",
          "type": "bpmn:UserTask",
          "name": "계획 · 자재 · 문서\n미비사항 보완",
          "x": 4510,
          "y": 270
        },
        {
          "id": "QE_ApproveProductionResume",
          "type": "bpmn:SendTask",
          "name": "신규 개정 생산\n재개 승인",
          "x": 4700,
          "y": 140
        },
        {
          "id": "QE_EndChanged",
          "type": "bpmn:EndEvent",
          "name": "개정 적용 승인 완료",
          "x": 4890,
          "y": 162
        }
      ],
      "flows": [
        {
          "id": "QE_F01",
          "source": "QE_Start",
          "target": "QE_AssessChangeNeed"
        },
        {
          "id": "QE_F02",
          "source": "QE_AssessChangeNeed",
          "target": "QE_RevisionRequiredGate"
        },
        {
          "id": "QE_F03",
          "source": "QE_RevisionRequiredGate",
          "target": "QE_CreateEngineeringChange",
          "name": "개정 필요",
          "condition": "${masterRevisionRequired == true}"
        },
        {
          "id": "QE_F04",
          "source": "QE_RevisionRequiredGate",
          "target": "QE_ApproveDispositionOnly",
          "name": "개정 불필요",
          "isDefault": true
        },
        {
          "id": "QE_F05",
          "source": "QE_ApproveDispositionOnly",
          "target": "QE_EndNoRevision"
        },
        {
          "id": "QE_F06",
          "source": "QE_CreateEngineeringChange",
          "target": "QE_ApproveRevision"
        },
        {
          "id": "QE_F07",
          "source": "QE_ApproveRevision",
          "target": "QE_PublishRevision"
        },
        {
          "id": "QE_F08",
          "source": "QE_PublishRevision",
          "target": "QE_ReviewReadiness"
        },
        {
          "id": "QE_F09",
          "source": "QE_ReviewReadiness",
          "target": "QE_ReadinessGate"
        },
        {
          "id": "QE_F10",
          "source": "QE_ReadinessGate",
          "target": "QE_ApproveProductionResume",
          "name": "완료",
          "condition": "${revisionReady == true}"
        },
        {
          "id": "QE_F11",
          "source": "QE_ReadinessGate",
          "target": "QE_CloseReadinessGaps",
          "name": "미완료",
          "isDefault": true
        },
        {
          "id": "QE_F12",
          "source": "QE_CloseReadinessGaps",
          "target": "QE_ReviewReadiness"
        },
        {
          "id": "QE_F13",
          "source": "QE_ApproveProductionResume",
          "target": "QE_EndChanged"
        }
      ],
      "annotations": [
        {
          "id": "QE_AnnoVersionPolicy",
          "text": "기존 생산버전을 덮어쓰거나 삭제하지 않는다.\n생산 중 WIP는 기존 개정, 미착수분은 신규 개정을 사용한다.",
          "x": 1250,
          "y": 70,
          "width": 360,
          "height": 70
        }
      ],
      "associations": [
        {
          "id": "QE_AssocVersionPolicy",
          "source": "QE_PublishRevision",
          "target": "QE_AnnoVersionPolicy"
        }
      ]
    },
    {
      "id": "Process_S4",
      "name": "S/4HANA 품질 · 생산오더 변경",
      "isExecutable": false,
      "documentation": "S/4HANA QM과 PP에서 품질 봉쇄, 생산오더 실제실적 판정, 개정 마스터 반영, 미착수 생산오더의 PP Master Data 재읽기 또는 대체오더 생성, 구성품과 부모오더 조치를 수행한다.",
      "nodes": [
        {
          "id": "S4_Start",
          "type": "bpmn:StartEvent",
          "name": "품질 Hold 신호 수신",
          "x": 100,
          "y": 622
        },
        {
          "id": "S4_ContainQualityScope",
          "type": "bpmn:UserTask",
          "name": "Q3 · 검사 Lot · Batch\n재고 봉쇄",
          "x": 250,
          "y": 600
        },
        {
          "id": "S4_CollectOrderFacts",
          "type": "bpmn:ServiceTask",
          "name": "생산오더 · 확정 · GI · GR ·\n외주 · 검사 Lot 상태 수집",
          "x": 430,
          "y": 600
        },
        {
          "id": "S4_StartedOrderGate",
          "type": "bpmn:ExclusiveGateway",
          "name": "생산 착수\n발생?",
          "x": 620,
          "y": 615
        },
        {
          "id": "S4_KeepExistingRevision",
          "type": "bpmn:UserTask",
          "name": "기존 Order BOM · Routing 유지\n개정 적용대상 제외",
          "x": 790,
          "y": 760
        },
        {
          "id": "S4_ProcessExistingDisposition",
          "type": "bpmn:UserTask",
          "name": "기존 개정 기준\n재작업 · 특채 · 폐기 처리",
          "x": 970,
          "y": 760
        },
        {
          "id": "S4_EndExistingRevision",
          "type": "bpmn:EndEvent",
          "name": "생산 중 오더 기존 개정 유지",
          "x": 1170,
          "y": 782
        },
        {
          "id": "S4_SelectUnstartedCandidates",
          "type": "bpmn:UserTask",
          "name": "미착수 오더 선별\nREL 상태만으로 판단 금지",
          "x": 790,
          "y": 560
        },
        {
          "id": "S4_RevisionDecisionGate",
          "type": "bpmn:ExclusiveGateway",
          "name": "마스터 개정\n승인?",
          "x": 970,
          "y": 575
        },
        {
          "id": "S4_ApplyDispositionWithoutRevision",
          "type": "bpmn:UserTask",
          "name": "마스터 변경 없이\n품질처분 · 일정조정",
          "x": 1280,
          "y": 480
        },
        {
          "id": "S4_EndNoRevision",
          "type": "bpmn:EndEvent",
          "name": "기존 마스터로 계속",
          "x": 1470,
          "y": 502
        },
        {
          "id": "S4_UpdateBOMRoutingPV",
          "type": "bpmn:UserTask",
          "name": "Change Number 기준\nBOM · Routing · PV 반영",
          "x": 1140,
          "y": 610
        },
        {
          "id": "S4_PublishProductionVersion",
          "type": "bpmn:SendTask",
          "name": "신규 생산버전\nPP/DS 변경전송",
          "x": 1320,
          "y": 610
        },
        {
          "id": "S4_DocumentTypeGate",
          "type": "bpmn:ExclusiveGateway",
          "name": "계획오더 또는\n생산오더?",
          "x": 1500,
          "y": 625
        },
        {
          "id": "S4_SendPlannedOrderCandidates",
          "type": "bpmn:SendTask",
          "name": "미착수 계획오더\nPP/DS 재전개 요청",
          "x": 1670,
          "y": 490
        },
        {
          "id": "S4_RereadEligibilityGate",
          "type": "bpmn:ExclusiveGateway",
          "name": "Read PP Master Data\n허용?",
          "x": 1760,
          "y": 700
        },
        {
          "id": "S4_ReadPPMasterData",
          "type": "bpmn:UserTask",
          "name": "CO02 Read PP Master Data\n신규 PV · Revision · Explosion Date",
          "x": 1860,
          "y": 610
        },
        {
          "id": "S4_RecheckOrder",
          "type": "bpmn:UserTask",
          "name": "구성품 · 공정 · 원가 ·\n가용성 재검증",
          "x": 2050,
          "y": 610
        },
        {
          "id": "S4_RereleaseOrder",
          "type": "bpmn:UserTask",
          "name": "오더 재스케줄 ·\n재릴리즈",
          "x": 2240,
          "y": 610
        },
        {
          "id": "S4_CreateReplacementOrder",
          "type": "bpmn:UserTask",
          "name": "재읽기 제한 시\n미착수 잔량 대체오더 생성",
          "x": 1860,
          "y": 790
        },
        {
          "id": "S4_RetireOldOrder",
          "type": "bpmn:UserTask",
          "name": "기존 오더 잔량 · 예약 ·\n페깅 정리",
          "x": 2050,
          "y": 790
        },
        {
          "id": "S4_MergeOrderUpdate",
          "type": "bpmn:ExclusiveGateway",
          "name": "오더변경\n합류",
          "x": 2470,
          "y": 625
        },
        {
          "id": "S4_ApplyComponentRules",
          "type": "bpmn:UserTask",
          "name": "구성품 처리\n투입분 유지 · 미투입분 재예약\n의심 Batch 격리",
          "x": 2640,
          "y": 600
        },
        {
          "id": "S4_SendChangedOrders",
          "type": "bpmn:SendTask",
          "name": "변경 오더 · Order BOM ·\nRouting 배포",
          "x": 2830,
          "y": 600
        },
        {
          "id": "S4_ReceivePlanningImpact",
          "type": "bpmn:ReceiveTask",
          "name": "PP/DS 재계획 결과 수신",
          "x": 3960,
          "y": 600
        },
        {
          "id": "S4_ApplyParentOrderActions",
          "type": "bpmn:UserTask",
          "name": "영향 부모오더만\n지연 · Hold · 대체공급 반영",
          "x": 4150,
          "y": 600
        },
        {
          "id": "S4_EndChanged",
          "type": "bpmn:EndEvent",
          "name": "S/4 변경 완료",
          "x": 4340,
          "y": 622
        }
      ],
      "flows": [
        {
          "id": "S4_F01",
          "source": "S4_Start",
          "target": "S4_ContainQualityScope"
        },
        {
          "id": "S4_F02",
          "source": "S4_ContainQualityScope",
          "target": "S4_CollectOrderFacts"
        },
        {
          "id": "S4_F03",
          "source": "S4_CollectOrderFacts",
          "target": "S4_StartedOrderGate"
        },
        {
          "id": "S4_F04",
          "source": "S4_StartedOrderGate",
          "target": "S4_SelectUnstartedCandidates",
          "name": "미착수 증명",
          "condition": "${orderStarted == false}"
        },
        {
          "id": "S4_F05",
          "source": "S4_StartedOrderGate",
          "target": "S4_KeepExistingRevision",
          "name": "착수 또는 불명확",
          "isDefault": true
        },
        {
          "id": "S4_F06",
          "source": "S4_KeepExistingRevision",
          "target": "S4_ProcessExistingDisposition"
        },
        {
          "id": "S4_F07",
          "source": "S4_ProcessExistingDisposition",
          "target": "S4_EndExistingRevision"
        },
        {
          "id": "S4_F08",
          "source": "S4_SelectUnstartedCandidates",
          "target": "S4_RevisionDecisionGate"
        },
        {
          "id": "S4_F09",
          "source": "S4_RevisionDecisionGate",
          "target": "S4_UpdateBOMRoutingPV",
          "name": "승인됨",
          "condition": "${masterRevisionApproved == true}"
        },
        {
          "id": "S4_F10",
          "source": "S4_RevisionDecisionGate",
          "target": "S4_ApplyDispositionWithoutRevision",
          "name": "개정 없음",
          "isDefault": true
        },
        {
          "id": "S4_F11",
          "source": "S4_ApplyDispositionWithoutRevision",
          "target": "S4_EndNoRevision"
        },
        {
          "id": "S4_F12",
          "source": "S4_UpdateBOMRoutingPV",
          "target": "S4_PublishProductionVersion"
        },
        {
          "id": "S4_F13",
          "source": "S4_PublishProductionVersion",
          "target": "S4_DocumentTypeGate"
        },
        {
          "id": "S4_F14",
          "source": "S4_DocumentTypeGate",
          "target": "S4_SendPlannedOrderCandidates",
          "name": "PP/DS 계획오더",
          "condition": "${hasPlannedOrders == true}"
        },
        {
          "id": "S4_F15",
          "source": "S4_DocumentTypeGate",
          "target": "S4_RereadEligibilityGate",
          "name": "S/4 생산오더",
          "isDefault": true
        },
        {
          "id": "S4_F16",
          "source": "S4_SendPlannedOrderCandidates",
          "target": "S4_MergeOrderUpdate"
        },
        {
          "id": "S4_F17",
          "source": "S4_RereadEligibilityGate",
          "target": "S4_ReadPPMasterData",
          "name": "허용",
          "condition": "${rereadAllowed == true}"
        },
        {
          "id": "S4_F18",
          "source": "S4_RereadEligibilityGate",
          "target": "S4_CreateReplacementOrder",
          "name": "확정 · GI · 검사 Lot 등 존재",
          "isDefault": true
        },
        {
          "id": "S4_F19",
          "source": "S4_ReadPPMasterData",
          "target": "S4_RecheckOrder"
        },
        {
          "id": "S4_F20",
          "source": "S4_RecheckOrder",
          "target": "S4_RereleaseOrder"
        },
        {
          "id": "S4_F21",
          "source": "S4_RereleaseOrder",
          "target": "S4_MergeOrderUpdate"
        },
        {
          "id": "S4_F22",
          "source": "S4_CreateReplacementOrder",
          "target": "S4_RetireOldOrder"
        },
        {
          "id": "S4_F23",
          "source": "S4_RetireOldOrder",
          "target": "S4_MergeOrderUpdate"
        },
        {
          "id": "S4_F24",
          "source": "S4_MergeOrderUpdate",
          "target": "S4_ApplyComponentRules"
        },
        {
