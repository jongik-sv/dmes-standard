      {
        "id": "MF_S4_DM_OrderChange",
        "name": "Order BOM · Routing · 일정",
        "source": "S4_SendChangedOrders",
        "target": "DM_WaitChangedOrder",
        "waypoints": [
          [2880, 680],
          [3000, 960],
          [3000, 1570],
          [3010, 1570]
        ]
      },
      {
        "id": "MF_PPDS_S4_Plan",
        "name": "자재 · 능력 · 부모오더 영향",
        "source": "PPDS_SendS4Plan",
        "target": "S4_ReceivePlanningImpact"
      },
      {
        "id": "MF_PPDS_DM_Schedule",
        "name": "확정 실행일정",
        "source": "PPDS_SendDMSchedule",
        "target": "DM_WaitExecutableSchedule"
      },
      {
        "id": "MF_S4_QE_Readiness",
        "name": "계획 · 오더 · 구성품 조치 완료",
