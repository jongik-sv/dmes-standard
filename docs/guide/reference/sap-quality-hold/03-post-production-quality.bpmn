      <bpmndi:BPMNShape id="POST_RejectHold_di" bpmnElement="POST_RejectHold">
        <dc:Bounds x="920" y="480" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="POST_MRB_di" bpmnElement="POST_MRB">
        <dc:Bounds x="1080" y="480" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="POST_DispositionGateway_di" bpmnElement="POST_DispositionGateway" isMarkerVisible="true">
        <dc:Bounds x="1250" y="495" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="POST_UseAsIs_di" bpmnElement="POST_UseAsIs">
        <dc:Bounds x="1400" y="380" width="100" height="80" />
      </bpmndi:BPMNShape>
