<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PostProductionQuality" targetNamespace="urn:sap-quality-hold-reference" exporter="bpmn-tool" exporterVersion="1.3.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.15.0">
  <bpmn:collaboration id="Collaboration_PostProductionQuality">
    <bpmn:participant id="Participant_PostProductionQuality" name="생산 후 품질 (SAP S/4HANA QM · SAP Digital Manufacturing)" processRef="PostProductionQuality" />
  </bpmn:collaboration>
  <bpmn:process id="PostProductionQuality" name="생산 후 품질 — 최종검사·UD·재고해제" isExecutable="false">
    <bpmn:documentation>생산입고 시 S/4HANA QM 검사 lot(원산지 04)과 Quality Inspection Stock을 사용한다. 결과 및 결함 기록 후 Usage Decision과 재고전기를 통해 출하 가능, 제한, 재작업, 폐기를 결정한다.</bpmn:documentation>
    <bpmn:startEvent id="POST_Start" name="최종공정 완료·생산입고">
      <bpmn:outgoing>POST_F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="POST_CreateLot04" name="[S/4 QM]&#10;GR from Production lot 04 생성&#10;Quality Inspection Stock 보류">
      <bpmn:incoming>POST_F01</bpmn:incoming>
      <bpmn:outgoing>POST_F02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="POST_Reconcile" name="DM 실적·Batch/Serial·Genealogy 정합">
      <bpmn:incoming>POST_F02</bpmn:incoming>
      <bpmn:outgoing>POST_F03</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="POST_FinalInspection" name="최종·포장·출하검사&#10;성적서/인증서 확인">
      <bpmn:incoming>POST_F03</bpmn:incoming>
      <bpmn:incoming>POST_F11</bpmn:incoming>
      <bpmn:incoming>POST_F19</bpmn:incoming>
      <bpmn:outgoing>POST_F04</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="POST_RecordResults" name="검사결과·결함·검사완료 기록">
      <bpmn:incoming>POST_F04</bpmn:incoming>
      <bpmn:outgoing>POST_F05</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="POST_AcceptGateway" name="최종 적합?" default="POST_F07">
      <bpmn:incoming>POST_F05</bpmn:incoming>
      <bpmn:outgoing>POST_F06</bpmn:outgoing>
      <bpmn:outgoing>POST_F07</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="POST_AcceptUD" name="Usage Decision: Accept&#10;Unrestricted/허용 재고로 전기">
      <bpmn:incoming>POST_F06</bpmn:incoming>
      <bpmn:incoming>POST_F16</bpmn:incoming>
      <bpmn:outgoing>POST_F08</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="POST_RecurringGateway" name="반복검사/새 품질신호?" default="POST_F09">
      <bpmn:incoming>POST_F08</bpmn:incoming>
      <bpmn:outgoing>POST_F09</bpmn:outgoing>
      <bpmn:outgoing>POST_F10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="POST_RecurringHold" name="Batch Restricted 또는 재고 보류&#10;반복검사 lot 09 생성">
      <bpmn:incoming>POST_F10</bpmn:incoming>
      <bpmn:outgoing>POST_F11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="POST_ShippingRelease" name="Batch/재고 출하 승인">
      <bpmn:incoming>POST_F09</bpmn:incoming>
      <bpmn:outgoing>POST_F12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="POST_EndReleased" name="출하 가능">
      <bpmn:incoming>POST_F12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="POST_RejectHold" name="결함/NCR 발행&#10;QI 유지 또는 Blocked Stock 전기">
      <bpmn:incoming>POST_F07</bpmn:incoming>
      <bpmn:outgoing>POST_F13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="POST_MRB" name="기술검토·MRB 처분 승인">
      <bpmn:incoming>POST_F13</bpmn:incoming>
      <bpmn:outgoing>POST_F14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="POST_DispositionGateway" name="처분?" default="POST_F17">
      <bpmn:incoming>POST_F14</bpmn:incoming>
      <bpmn:outgoing>POST_F15</bpmn:outgoing>
      <bpmn:outgoing>POST_F17</bpmn:outgoing>
      <bpmn:outgoing>POST_F20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="POST_UseAsIs" name="특채·부분수량 Release 승인">
      <bpmn:incoming>POST_F15</bpmn:incoming>
      <bpmn:outgoing>POST_F16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="POST_ReworkOrder" name="재작업 전기/오더 생성">
      <bpmn:incoming>POST_F17</bpmn:incoming>
      <bpmn:outgoing>POST_F18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="POST_ExecuteRework" name="재작업 수행">
      <bpmn:incoming>POST_F18</bpmn:incoming>
      <bpmn:outgoing>POST_F19</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="POST_ScrapUD" name="Usage Decision: Reject&#10;Scrap 전기·비용 반영">
      <bpmn:incoming>POST_F20</bpmn:incoming>
      <bpmn:outgoing>POST_F21</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="POST_EndScrap" name="폐기 종결">
      <bpmn:incoming>POST_F21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="POST_F01" sourceRef="POST_Start" targetRef="POST_CreateLot04" />
    <bpmn:sequenceFlow id="POST_F02" sourceRef="POST_CreateLot04" targetRef="POST_Reconcile" />
    <bpmn:sequenceFlow id="POST_F03" sourceRef="POST_Reconcile" targetRef="POST_FinalInspection" />
    <bpmn:sequenceFlow id="POST_F04" sourceRef="POST_FinalInspection" targetRef="POST_RecordResults" />
    <bpmn:sequenceFlow id="POST_F05" sourceRef="POST_RecordResults" targetRef="POST_AcceptGateway" />
    <bpmn:sequenceFlow id="POST_F06" name="합격" sourceRef="POST_AcceptGateway" targetRef="POST_AcceptUD">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${finalAccepted == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="POST_F07" name="불합격/미결" sourceRef="POST_AcceptGateway" targetRef="POST_RejectHold" />
    <bpmn:sequenceFlow id="POST_F08" sourceRef="POST_AcceptUD" targetRef="POST_RecurringGateway" />
    <bpmn:sequenceFlow id="POST_F09" name="없음" sourceRef="POST_RecurringGateway" targetRef="POST_ShippingRelease" />
    <bpmn:sequenceFlow id="POST_F10" name="유효기간/시장신호/주기 도래" sourceRef="POST_RecurringGateway" targetRef="POST_RecurringHold">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${recurringInspectionRequired == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="POST_F11" name="재검사" sourceRef="POST_RecurringHold" targetRef="POST_FinalInspection" />
    <bpmn:sequenceFlow id="POST_F12" sourceRef="POST_ShippingRelease" targetRef="POST_EndReleased" />
    <bpmn:sequenceFlow id="POST_F13" sourceRef="POST_RejectHold" targetRef="POST_MRB" />
    <bpmn:sequenceFlow id="POST_F14" sourceRef="POST_MRB" targetRef="POST_DispositionGateway" />
    <bpmn:sequenceFlow id="POST_F15" name="특채/부분 Release" sourceRef="POST_DispositionGateway" targetRef="POST_UseAsIs">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${postDisposition == 'USE_AS_IS'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="POST_F16" sourceRef="POST_UseAsIs" targetRef="POST_AcceptUD" />
    <bpmn:sequenceFlow id="POST_F17" name="재작업" sourceRef="POST_DispositionGateway" targetRef="POST_ReworkOrder" />
    <bpmn:sequenceFlow id="POST_F18" sourceRef="POST_ReworkOrder" targetRef="POST_ExecuteRework" />
    <bpmn:sequenceFlow id="POST_F19" name="재검사" sourceRef="POST_ExecuteRework" targetRef="POST_FinalInspection" />
    <bpmn:sequenceFlow id="POST_F20" name="폐기" sourceRef="POST_DispositionGateway" targetRef="POST_ScrapUD">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${postDisposition == 'SCRAP'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="POST_F21" sourceRef="POST_ScrapUD" targetRef="POST_EndScrap" />
    <bpmn:textAnnotation id="POST_Annotation">
      <bpmn:text>Quality Inspection Stock에서의 출고는 QM Usage Decision/재고전기를 통해서만 수행한다. Batch Restricted는 별도 사용가능성 축이다.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="POST_Association" sourceRef="POST_CreateLot04" targetRef="POST_Annotation" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_PostProductionQuality">
      <bpmndi:BPMNShape id="Participant_PostProductionQuality_di" bpmnElement="Participant_PostProductionQuality" isHorizontal="true">
        <dc:Bounds x="20" y="40" width="1670" height="760" />
