<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_CustomerComplaintQuality" targetNamespace="urn:sap-quality-hold-reference" exporter="bpmn-tool" exporterVersion="1.3.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.15.0">
  <bpmn:collaboration id="Collaboration_CustomerComplaintQuality">
    <bpmn:participant id="Participant_CustomerComplaintQuality" name="고객 불만 (SAP S/4HANA QM · SAP DM · SD/ARM · EWM)" processRef="CustomerComplaintQuality" />
  </bpmn:collaboration>
  <bpmn:process id="CustomerComplaintQuality" name="고객 불만 — 봉쇄·RMA·원인분석·CAPA" isExecutable="false">
    <bpmn:documentation>S/4HANA QM 고객불만 품질통지 Q1을 중심으로 고객응답과 내부 봉쇄를 병렬 실행하고, 필요 시 반품검사 lot를 생성한다. 처분, 근본원인, CAPA, 효과검증을 마친 뒤 영향범위별 보류를 해제한다.</bpmn:documentation>
    <bpmn:startEvent id="CC_Start" name="고객 불만 수신">
      <bpmn:outgoing>CC_F01</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:userTask id="CC_CreateQ1" name="[S/4 QM]&#10;고객불만 Quality Notification Q1 생성&#10;고객·자재·Batch·Delivery·Serial 연결">
      <bpmn:incoming>CC_F01</bpmn:incoming>
      <bpmn:outgoing>CC_F02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="CC_ParallelSplit" name="즉시대응 병렬">
      <bpmn:incoming>CC_F02</bpmn:incoming>
      <bpmn:outgoing>CC_F03</bpmn:outgoing>
      <bpmn:outgoing>CC_F04</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="CC_Containment" name="영향 Lot/Batch/Serial 추적·봉쇄&#10;S/4 재고/Batch 제한 + DM 관련 SFC Hold">
      <bpmn:incoming>CC_F03</bpmn:incoming>
      <bpmn:outgoing>CC_F05</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="CC_CustomerResponse" name="고객 접수 회신·위험도 평가&#10;RMA/대체/현장조치 판단">
      <bpmn:incoming>CC_F04</bpmn:incoming>
      <bpmn:outgoing>CC_F06</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="CC_ParallelJoin" name="초기 봉쇄 완료">
      <bpmn:incoming>CC_F05</bpmn:incoming>
      <bpmn:incoming>CC_F06</bpmn:incoming>
      <bpmn:outgoing>CC_F07</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="CC_ReturnGateway" name="실물 반품 필요?" default="CC_F09">
      <bpmn:incoming>CC_F07</bpmn:incoming>
      <bpmn:outgoing>CC_F08</bpmn:outgoing>
      <bpmn:outgoing>CC_F09</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="CC_CreateReturn" name="ARM/RMA 반품오더·Return Delivery 생성">
      <bpmn:incoming>CC_F08</bpmn:incoming>
      <bpmn:outgoing>CC_F10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="CC_ReturnReceipt" name="반품 입고&#10;Blocked Returns/Inspection Stock&#10;lot 06 또는 05 생성">
      <bpmn:incoming>CC_F10</bpmn:incoming>
      <bpmn:outgoing>CC_F11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="CC_ReturnInspection" name="기술검사·결함·검사결과 기록">
      <bpmn:incoming>CC_F11</bpmn:incoming>
      <bpmn:outgoing>CC_F12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="CC_EvidenceReview" name="사진·샘플·생산/검사 이력 검토">
      <bpmn:incoming>CC_F09</bpmn:incoming>
      <bpmn:outgoing>CC_F13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="CC_EvidenceMerge" name="조사자료 통합">
      <bpmn:incoming>CC_F12</bpmn:incoming>
      <bpmn:incoming>CC_F13</bpmn:incoming>
      <bpmn:outgoing>CC_F14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="CC_RootCause" name="결함 Item·Cause 기록&#10;5Why/4M 근본원인 분석">
      <bpmn:incoming>CC_F14</bpmn:incoming>
      <bpmn:incoming>CC_F30</bpmn:incoming>
      <bpmn:outgoing>CC_F15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="CC_CAPAPlan" name="Correction·CAPA Task 수립&#10;책임자·기한 지정">
      <bpmn:incoming>CC_F15</bpmn:incoming>
      <bpmn:outgoing>CC_F16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="CC_DispositionGateway" name="고객품 처분?" default="CC_F18">
      <bpmn:incoming>CC_F16</bpmn:incoming>
      <bpmn:outgoing>CC_F17</bpmn:outgoing>
      <bpmn:outgoing>CC_F18</bpmn:outgoing>
      <bpmn:outgoing>CC_F19</bpmn:outgoing>
      <bpmn:outgoing>CC_F20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="CC_Repair" name="수리·재작업 후 반환">
      <bpmn:incoming>CC_F17</bpmn:incoming>
      <bpmn:outgoing>CC_F21</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="CC_Replace" name="대체품·환불·Credit 처리">
      <bpmn:incoming>CC_F18</bpmn:incoming>
      <bpmn:outgoing>CC_F22</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="CC_NoFault" name="No Fault Found&#10;그대로 반환/설명">
      <bpmn:incoming>CC_F19</bpmn:incoming>
      <bpmn:outgoing>CC_F23</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="CC_ScrapField" name="폐기·선별·현장조치/Recall">
      <bpmn:incoming>CC_F20</bpmn:incoming>
      <bpmn:outgoing>CC_F24</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="CC_DispositionMerge" name="처분 완료">
      <bpmn:incoming>CC_F21</bpmn:incoming>
      <bpmn:incoming>CC_F22</bpmn:incoming>
      <bpmn:incoming>CC_F23</bpmn:incoming>
      <bpmn:incoming>CC_F24</bpmn:incoming>
      <bpmn:outgoing>CC_F25</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="CC_ImplementCAPA" name="내부 시정·예방조치 실행&#10;공정·검사계획·공급자 기준 개정">
      <bpmn:incoming>CC_F25</bpmn:incoming>
      <bpmn:outgoing>CC_F26</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="CC_VerifyEffectiveness" name="효과검증·재발 모니터링">
      <bpmn:incoming>CC_F26</bpmn:incoming>
      <bpmn:outgoing>CC_F27</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="CC_EffectiveGateway" name="효과 확인?" default="CC_F29">
      <bpmn:incoming>CC_F27</bpmn:incoming>
      <bpmn:outgoing>CC_F28</bpmn:outgoing>
      <bpmn:outgoing>CC_F29</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="CC_Refine" name="원인/조치 재수립">
      <bpmn:incoming>CC_F29</bpmn:incoming>
      <bpmn:outgoing>CC_F30</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="CC_ReleaseContainment" name="QA 승인으로 영향범위별 보류 해제&#10;미해결 Lot/Batch/SFC는 유지">
      <bpmn:incoming>CC_F28</bpmn:incoming>
      <bpmn:outgoing>CC_F31</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="CC_FinalResponse" name="고객 최종 회신·8D/증빙 전달">
      <bpmn:incoming>CC_F31</bpmn:incoming>
      <bpmn:outgoing>CC_F32</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="CC_CompleteQ1" name="Q1 Task/Activity 완료·통지 종결">
      <bpmn:incoming>CC_F32</bpmn:incoming>
      <bpmn:outgoing>CC_F33</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="CC_End" name="불만 종결·기준 환류">
      <bpmn:incoming>CC_F33</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="CC_F01" sourceRef="CC_Start" targetRef="CC_CreateQ1" />
    <bpmn:sequenceFlow id="CC_F02" sourceRef="CC_CreateQ1" targetRef="CC_ParallelSplit" />
    <bpmn:sequenceFlow id="CC_F03" sourceRef="CC_ParallelSplit" targetRef="CC_Containment" />
    <bpmn:sequenceFlow id="CC_F04" sourceRef="CC_ParallelSplit" targetRef="CC_CustomerResponse" />
    <bpmn:sequenceFlow id="CC_F05" sourceRef="CC_Containment" targetRef="CC_ParallelJoin" />
    <bpmn:sequenceFlow id="CC_F06" sourceRef="CC_CustomerResponse" targetRef="CC_ParallelJoin" />
    <bpmn:sequenceFlow id="CC_F07" sourceRef="CC_ParallelJoin" targetRef="CC_ReturnGateway" />
    <bpmn:sequenceFlow id="CC_F08" name="예" sourceRef="CC_ReturnGateway" targetRef="CC_CreateReturn">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${physicalReturnRequired == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="CC_F09" name="아니오" sourceRef="CC_ReturnGateway" targetRef="CC_EvidenceReview" />
    <bpmn:sequenceFlow id="CC_F10" sourceRef="CC_CreateReturn" targetRef="CC_ReturnReceipt" />
    <bpmn:sequenceFlow id="CC_F11" sourceRef="CC_ReturnReceipt" targetRef="CC_ReturnInspection" />
    <bpmn:sequenceFlow id="CC_F12" sourceRef="CC_ReturnInspection" targetRef="CC_EvidenceMerge" />
    <bpmn:sequenceFlow id="CC_F13" sourceRef="CC_EvidenceReview" targetRef="CC_EvidenceMerge" />
    <bpmn:sequenceFlow id="CC_F14" sourceRef="CC_EvidenceMerge" targetRef="CC_RootCause" />
    <bpmn:sequenceFlow id="CC_F15" sourceRef="CC_RootCause" targetRef="CC_CAPAPlan" />
    <bpmn:sequenceFlow id="CC_F16" sourceRef="CC_CAPAPlan" targetRef="CC_DispositionGateway" />
    <bpmn:sequenceFlow id="CC_F17" name="수리/재작업" sourceRef="CC_DispositionGateway" targetRef="CC_Repair">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${customerDisposition == 'REPAIR'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="CC_F18" name="대체/환불" sourceRef="CC_DispositionGateway" targetRef="CC_Replace" />
    <bpmn:sequenceFlow id="CC_F19" name="정상/NFF" sourceRef="CC_DispositionGateway" targetRef="CC_NoFault">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${customerDisposition == 'NO_FAULT'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="CC_F20" name="폐기/현장조치" sourceRef="CC_DispositionGateway" targetRef="CC_ScrapField">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${customerDisposition == 'SCRAP_OR_FIELD_ACTION'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="CC_F21" sourceRef="CC_Repair" targetRef="CC_DispositionMerge" />
    <bpmn:sequenceFlow id="CC_F22" sourceRef="CC_Replace" targetRef="CC_DispositionMerge" />
    <bpmn:sequenceFlow id="CC_F23" sourceRef="CC_NoFault" targetRef="CC_DispositionMerge" />
    <bpmn:sequenceFlow id="CC_F24" sourceRef="CC_ScrapField" targetRef="CC_DispositionMerge" />
    <bpmn:sequenceFlow id="CC_F25" sourceRef="CC_DispositionMerge" targetRef="CC_ImplementCAPA" />
    <bpmn:sequenceFlow id="CC_F26" sourceRef="CC_ImplementCAPA" targetRef="CC_VerifyEffectiveness" />
    <bpmn:sequenceFlow id="CC_F27" sourceRef="CC_VerifyEffectiveness" targetRef="CC_EffectiveGateway" />
    <bpmn:sequenceFlow id="CC_F28" name="예" sourceRef="CC_EffectiveGateway" targetRef="CC_ReleaseContainment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${capaEffective == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="CC_F29" name="아니오/재발" sourceRef="CC_EffectiveGateway" targetRef="CC_Refine" />
    <bpmn:sequenceFlow id="CC_F30" name="재분석" sourceRef="CC_Refine" targetRef="CC_RootCause" />
    <bpmn:sequenceFlow id="CC_F31" sourceRef="CC_ReleaseContainment" targetRef="CC_FinalResponse" />
    <bpmn:sequenceFlow id="CC_F32" sourceRef="CC_FinalResponse" targetRef="CC_CompleteQ1" />
    <bpmn:sequenceFlow id="CC_F33" sourceRef="CC_CompleteQ1" targetRef="CC_End" />
    <bpmn:textAnnotation id="CC_Annotation">
      <bpmn:text>보류는 전량 일괄 해제하지 않는다. Lot·Batch·Serial·SFC별 조사/처분/효과검증 상태에 따라 품질 승인자가 선택 해제한다.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="CC_Association" sourceRef="CC_ReleaseContainment" targetRef="CC_Annotation" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_CustomerComplaintQuality">
