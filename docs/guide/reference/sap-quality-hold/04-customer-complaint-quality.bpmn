      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="CC_F03_di" bpmnElement="CC_F03">
        <di:waypoint x="355" y="315" />
        <di:waypoint x="355" y="190" />
        <di:waypoint x="440" y="190" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="CC_F04_di" bpmnElement="CC_F04">
        <di:waypoint x="355" y="365" />
        <di:waypoint x="355" y="510" />
        <di:waypoint x="440" y="510" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="CC_F05_di" bpmnElement="CC_F05">
        <di:waypoint x="540" y="190" />
