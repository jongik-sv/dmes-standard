    "exporter": "bpmn-tool",
    "exporterVersion": "1.3.0",
    "modeler": {
      "executionPlatform": "Camunda Platform",
      "executionPlatformVersion": "7.15.0"
    }
  },
  "collaboration": {
    "id": "Collaboration_QualityHoldCustomerView",
    "participants": [
      {
        "id": "Participant_QE",
        "name": "고객사 품질 · 기술 책임자",
        "processRef": "Process_QE",
        "x": 40,
        "y": 40,
        "width": 6200,
        "height": 360
      },
      {
        "id": "Participant_S4",
        "name": "기준 · 오더 · 재고 관리 (SAP S/4HANA)",
        "processRef": "Process_S4",
        "x": 40,
        "y": 440,
        "width": 6200,
        "height": 500
      },
      {
        "id": "Participant_PPDS",
        "name": "자재 · 설비 · 일정 재계획 (SAP PP/DS)",
        "processRef": "Process_PPDS",
        "x": 40,
        "y": 980,
        "width": 6200,
        "height": 420
      },
      {
        "id": "Participant_DM",
        "name": "현장 시스템 실행 제어 (SAP Digital Manufacturing)",
        "processRef": "Process_DM",
        "x": 40,
        "y": 1440,
        "width": 6200,
        "height": 460
      },
      {
        "id": "Participant_PC",
        "name": "생산관리 · 현장 작업자",
        "processRef": "Process_PC",
        "x": 40,
        "y": 1940,
        "width": 6200,
        "height": 300
      }
    ],
    "messageFlows": [
      {
        "id": "MF_PC_DM_ActualStatus",
        "name": "실제 작업 · 자재투입 상태",
        "source": "PC_VerifyActualStatus",
        "target": "DM_TraceAffectedWork"
      },
      {
        "id": "MF_S4_QE_Containment",
        "name": "격리 범위와 고객 영향",
        "source": "S4_ContainAffectedScope",
        "target": "QE_AssessBusinessImpact"
      },
      {
        "id": "MF_QE_S4_Revision",
        "name": "승인된 새 생산기준",
        "source": "QE_PublishNewStandard",
        "target": "S4_RegisterNewStandard",
        "waypoints": [
          [1740, 260],
          [1740, 580],
          [1640, 580]
        ]
      },
      {
        "id": "MF_S4_PPDS_Standard",
        "name": "새 자재목록 · 작업순서",
        "source": "S4_PublishPlanningStandard",
        "target": "PPDS_PrepareNewPlanningStandard"
      },
      {
        "id": "MF_S4_PPDS_PlannedOrders",
        "name": "미착수 계획오더",
        "source": "S4_RequestPlannedOrderReplan",
        "target": "PPDS_RecreatePlannedOrders"
      },
      {
        "id": "MF_S4_PPDS_ProductionOrders",
        "name": "변경 · 대체 생산오더",
        "source": "S4_SendChangedOrders",
        "target": "PPDS_AdoptChangedOrders"
      },
      {
        "id": "MF_S4_DM_OrderChange",
        "name": "현장 적용용 변경오더",
        "source": "S4_SendChangedOrders",
        "target": "DM_WaitChangedOrder",
        "waypoints": [
          [3600, 680],
          [3680, 960],
          [3680, 1570]
        ]
      },
      {
        "id": "MF_PPDS_S4_Plan",
        "name": "자재부족 · 납기 영향",
        "source": "PPDS_SendPlanningResult",
        "target": "S4_ReceivePlanningResult"
      },
      {
        "id": "MF_PPDS_DM_Schedule",
        "name": "현장에서 실행할 일정",
        "source": "PPDS_SendExecutableSchedule",
        "target": "DM_WaitExecutableSchedule"
      },
      {
        "id": "MF_S4_QE_Readiness",
        "name": "오더 · 자재 조치 완료",
        "source": "S4_AdjustParentOrders",
        "target": "QE_ReviewReadiness"
      },
      {
        "id": "MF_QE_DM_Release",
        "name": "생산 재개 승인",
        "source": "QE_ApproveResume",
        "target": "DM_WaitQualityApproval"
      },
      {
        "id": "MF_DM_PC_Resume",
        "name": "현장 작업 재개 지시",
        "source": "DM_ReleaseChangedWork",
        "target": "PC_WaitRelease"
      }
    ]
  },
  "processes": [
    {
      "id": "Process_QE",
      "name": "품질문제 판단과 생산 재개 승인",
      "isExecutable": false,
      "documentation": "생산 전, 생산 중, 생산 후 또는 고객 불만에서 접수된 품질문제의 사업 영향을 판단한다. 생산방법이나 필요 자재를 바꿔야 할 때 새 생산기준을 승인하고, 자재·일정·현장 준비가 끝난 뒤 생산 재개를 승인한다.",
      "nodes": [
        {
          "id": "QE_Start",
          "type": "bpmn:StartEvent",
          "name": "품질문제 발생",
          "x": 220,
          "y": 172
        },
        {
          "id": "QE_ReceiveIssue",
          "type": "bpmn:UserTask",
          "name": "문제 접수\n전 · 중 · 후 · 고객불만",
          "x": 390,
          "y": 150
        },
        {
          "id": "QE_AssessBusinessImpact",
          "type": "bpmn:UserTask",
          "name": "안전 · 고객 · 납기\n영향 확인",
          "x": 620,
          "y": 150
        },
        {
          "id": "QE_ChangeRequiredGate",
          "type": "bpmn:ExclusiveGateway",
          "name": "생산기준을\n바꿔야 하나?",
          "x": 870,
          "y": 165
        },
        {
          "id": "QE_ApproveDispositionOnly",
          "type": "bpmn:UserTask",
          "name": "현재 기준으로 재작업 ·\n조건부사용 · 폐기 결정",
          "x": 1080,
          "y": 70
        },
        {
          "id": "QE_EndNoChange",
          "type": "bpmn:EndEvent",
          "name": "현재 기준 유지",
          "x": 1330,
          "y": 92
        },
        {
          "id": "QE_DesignNewStandard",
          "type": "bpmn:UserTask",
          "name": "새 자재목록 · 작업순서\n설계",
          "x": 1080,
          "y": 220
        },
        {
          "id": "QE_ApproveNewStandard",
          "type": "bpmn:UserTask",
          "name": "변경안과 적용시점\n승인",
          "x": 1330,
          "y": 220
        },
        {
          "id": "QE_PublishNewStandard",
          "type": "bpmn:SendTask",
          "name": "새 생산기준 배포\n기존 기준도 보존",
          "x": 1590,
          "y": 220
        },
        {
          "id": "QE_ReviewReadiness",
          "type": "bpmn:UserTask",
          "name": "자재 · 일정 · 현장준비\n최종 확인",
          "x": 4550,
          "y": 150
        },
        {
          "id": "QE_ReadinessGate",
          "type": "bpmn:ExclusiveGateway",
          "name": "모두\n준비됐나?",
          "x": 4800,
          "y": 165
        },
        {
          "id": "QE_CloseReadinessGaps",
          "type": "bpmn:UserTask",
          "name": "부족 자재 · 일정 · 문서\n보완",
          "x": 4990,
          "y": 270
        },
        {
          "id": "QE_ApproveResume",
          "type": "bpmn:SendTask",
          "name": "생산 재개 승인",
          "x": 5230,
          "y": 140
        },
        {
          "id": "QE_EndChanged",
          "type": "bpmn:EndEvent",
          "name": "새 기준 적용 승인",
          "x": 5460,
          "y": 162
        }
      ],
      "flows": [
        {
          "id": "QE_F01",
          "source": "QE_Start",
          "target": "QE_ReceiveIssue"
        },
        {
          "id": "QE_F02",
          "source": "QE_ReceiveIssue",
          "target": "QE_AssessBusinessImpact"
        },
        {
          "id": "QE_F03",
          "source": "QE_AssessBusinessImpact",
          "target": "QE_ChangeRequiredGate"
        },
        {
          "id": "QE_F04",
          "source": "QE_ChangeRequiredGate",
          "target": "QE_DesignNewStandard",
          "name": "변경 필요",
          "condition": "${productionStandardChangeRequired == true}"
        },
        {
          "id": "QE_F05",
          "source": "QE_ChangeRequiredGate",
          "target": "QE_ApproveDispositionOnly",
          "name": "변경 불필요",
          "isDefault": true
        },
        {
          "id": "QE_F06",
          "source": "QE_ApproveDispositionOnly",
          "target": "QE_EndNoChange"
        },
        {
          "id": "QE_F07",
          "source": "QE_DesignNewStandard",
          "target": "QE_ApproveNewStandard"
        },
        {
          "id": "QE_F08",
          "source": "QE_ApproveNewStandard",
          "target": "QE_PublishNewStandard"
        },
        {
          "id": "QE_F09",
          "source": "QE_PublishNewStandard",
          "target": "QE_ReviewReadiness"
        },
        {
          "id": "QE_F10",
          "source": "QE_ReviewReadiness",
          "target": "QE_ReadinessGate"
        },
        {
          "id": "QE_F11",
          "source": "QE_ReadinessGate",
          "target": "QE_ApproveResume",
          "name": "준비 완료",
          "condition": "${resumeReady == true}"
        },
        {
          "id": "QE_F12",
          "source": "QE_ReadinessGate",
          "target": "QE_CloseReadinessGaps",
          "name": "보완 필요",
          "isDefault": true
        },
        {
          "id": "QE_F13",
          "source": "QE_CloseReadinessGaps",
          "target": "QE_ReviewReadiness"
        },
        {
          "id": "QE_F14",
          "source": "QE_ApproveResume",
          "target": "QE_EndChanged"
        }
      ],
      "annotations": [
        {
          "id": "QE_AnnoScope",
          "text": "품질문제는 생산 전 검사, 생산 중 이상, 생산 후 검사,\n고객 불만 중 어느 단계에서든 시작할 수 있다.",
          "x": 2150,
          "y": 270,
          "width": 420,
          "height": 65
        },
        {
          "id": "QE_AnnoStandard",
          "text": "생산기준 = 무엇을 쓰고(BOM), 어떤 순서로 만들며(Routing),\n어느 조합을 적용할지(Production Version) 정한 정보",
          "x": 1580,
          "y": 70,
          "width": 500,
          "height": 75
        }
      ],
      "associations": [
        {
          "id": "QE_AssocScope",
          "source": "QE_ReceiveIssue",
          "target": "QE_AnnoScope"
        },
        {
          "id": "QE_AssocStandard",
          "source": "QE_PublishNewStandard",
          "target": "QE_AnnoStandard"
        }
      ]
    },
    {
      "id": "Process_S4",
      "name": "품질 격리와 생산오더 변경",
      "isExecutable": false,
      "documentation": "SAP S/4HANA에서 문제 재고와 배치를 격리하고 관련 생산오더의 실제 착수 여부를 판정한다. 이미 생산을 시작한 오더는 기존 생산기준으로 처분하며, 완전히 미착수한 계획오더와 생산오더만 새 생산기준 적용 대상으로 처리한다.",
      "nodes": [
        {
          "id": "S4_Start",
          "type": "bpmn:StartEvent",
          "name": "품질중단 요청",
          "x": 220,
          "y": 622
        },
        {
          "id": "S4_ContainAffectedScope",
          "type": "bpmn:UserTask",
          "name": "문제 제품 · 재고 · 배치\n우선 격리",
          "x": 390,
          "y": 600
        },
        {
          "id": "S4_CollectOrderFacts",
          "type": "bpmn:ServiceTask",
          "name": "관련 오더와 실제 작업 ·\n자재투입 상태 확인",
          "x": 640,
          "y": 600
        },
        {
          "id": "S4_StartedOrderGate",
          "type": "bpmn:ExclusiveGateway",
          "name": "이미 생산을\n시작했나?",
          "x": 900,
          "y": 615
        },
        {
          "id": "S4_KeepExistingStandard",
          "type": "bpmn:UserTask",
          "name": "생산 중 오더는\n기존 기준 유지",
          "x": 1120,
          "y": 760
        },
        {
          "id": "S4_DisposeStartedOrder",
          "type": "bpmn:UserTask",
          "name": "재작업 · 조건부사용 ·\n폐기 처리",
          "x": 1360,
          "y": 760
        },
        {
          "id": "S4_EndStartedOrder",
          "type": "bpmn:EndEvent",
          "name": "생산 중 오더 처리 완료",
          "x": 1590,
          "y": 782
        },
        {
          "id": "S4_SelectUnstartedOrders",
          "type": "bpmn:UserTask",
          "name": "완전히 미착수한\n오더만 선택",
          "x": 1120,
          "y": 560
        },
        {
          "id": "S4_ChangeApprovedGate",
          "type": "bpmn:ExclusiveGateway",
          "name": "새 생산기준\n승인됐나?",
          "x": 1360,
          "y": 575
        },
        {
          "id": "S4_AdjustWithoutChange",
          "type": "bpmn:UserTask",
          "name": "현재 기준으로 처분 ·\n일정만 조정",
          "x": 1590,
          "y": 480
        },
        {
          "id": "S4_EndWithoutChange",
          "type": "bpmn:EndEvent",
          "name": "현재 기준으로 계속",
          "x": 1810,
          "y": 502
        },
        {
          "id": "S4_RegisterNewStandard",
          "type": "bpmn:UserTask",
          "name": "새 자재목록 · 작업순서 ·\n적용조합 등록",
          "x": 1590,
          "y": 610
        },
        {
          "id": "S4_PublishPlanningStandard",
          "type": "bpmn:SendTask",
          "name": "새 생산기준을\n계획시스템에 전달",
          "x": 1840,
          "y": 610
        },
        {
          "id": "S4_OrderTypeGate",
          "type": "bpmn:ExclusiveGateway",
          "name": "계획만 있는가,\n생산오더인가?",
          "x": 2080,
          "y": 625
        },
        {
          "id": "S4_RequestPlannedOrderReplan",
          "type": "bpmn:SendTask",
          "name": "계획오더를 새 기준으로\n다시 만들도록 요청",
          "x": 2420,
          "y": 490
        },
        {
          "id": "S4_OrderChangeSafeGate",
          "type": "bpmn:ExclusiveGateway",
          "name": "기존 생산오더를\n안전하게 바꿀 수 있나?",
          "x": 2300,
          "y": 700
        },
        {
          "id": "S4_RereadNewStandard",
          "type": "bpmn:UserTask",
          "name": "생산오더에 새 기준\n다시 읽기",
          "x": 2520,
          "y": 610
        },
        {
          "id": "S4_ValidateChangedOrder",
          "type": "bpmn:UserTask",
          "name": "자재 · 공정 · 원가 ·\n가능일 재확인",
          "x": 2760,
          "y": 610
        },
        {
          "id": "S4_CreateReplacementOrder",
          "type": "bpmn:UserTask",
          "name": "미착수 잔량으로\n새 생산오더 생성",
          "x": 2520,
          "y": 790
        },
        {
          "id": "S4_RetireOldOrder",
          "type": "bpmn:UserTask",
          "name": "기존 오더의 잔량 ·\n예약 정리",
          "x": 2760,
          "y": 790
        },
        {
          "id": "S4_MergeOrderChange",
          "type": "bpmn:ExclusiveGateway",
          "name": "오더변경\n합류",
          "x": 3100,
          "y": 625
        },
        {
          "id": "S4_HandleComponents",
          "type": "bpmn:UserTask",
          "name": "투입 · 미투입 · 의심자재를\n나눠 처리",
          "x": 3290,
          "y": 600
        },
        {
          "id": "S4_SendChangedOrders",
          "type": "bpmn:SendTask",
          "name": "변경된 오더를\n계획 · 현장에 전달",
          "x": 3500,
          "y": 600
        },
        {
          "id": "S4_ReceivePlanningResult",
          "type": "bpmn:ReceiveTask",
          "name": "새 일정과 부족결과\n수신",
          "x": 4640,
          "y": 600
        },
        {
          "id": "S4_AdjustParentOrders",
          "type": "bpmn:UserTask",
          "name": "영향받는 상위제품\n오더만 조정",
          "x": 4860,
          "y": 600
        },
        {
          "id": "S4_EndChanged",
          "type": "bpmn:EndEvent",
          "name": "오더 · 재고 조치 완료",
          "x": 5100,
          "y": 622
        }
      ],
      "flows": [
        {
          "id": "S4_F01",
          "source": "S4_Start",
          "target": "S4_ContainAffectedScope"
        },
        {
          "id": "S4_F02",
          "source": "S4_ContainAffectedScope",
          "target": "S4_CollectOrderFacts"
        },
        {
          "id": "S4_F03",
          "source": "S4_CollectOrderFacts",
          "target": "S4_StartedOrderGate"
        },
        {
          "id": "S4_F04",
          "source": "S4_StartedOrderGate",
          "target": "S4_SelectUnstartedOrders",
          "name": "완전 미착수",
          "condition": "${orderStarted == false}"
        },
        {
          "id": "S4_F05",
          "source": "S4_StartedOrderGate",
          "target": "S4_KeepExistingStandard",
          "name": "착수 또는 불명확",
          "isDefault": true
        },
        {
          "id": "S4_F06",
          "source": "S4_KeepExistingStandard",
          "target": "S4_DisposeStartedOrder"
        },
        {
          "id": "S4_F07",
          "source": "S4_DisposeStartedOrder",
          "target": "S4_EndStartedOrder"
        },
        {
          "id": "S4_F08",
          "source": "S4_SelectUnstartedOrders",
          "target": "S4_ChangeApprovedGate"
        },
        {
          "id": "S4_F09",
          "source": "S4_ChangeApprovedGate",
          "target": "S4_RegisterNewStandard",
          "name": "승인됨",
          "condition": "${newStandardApproved == true}"
        },
        {
          "id": "S4_F10",
          "source": "S4_ChangeApprovedGate",
          "target": "S4_AdjustWithoutChange",
          "name": "변경 없음",
          "isDefault": true
        },
        {
          "id": "S4_F11",
          "source": "S4_AdjustWithoutChange",
          "target": "S4_EndWithoutChange"
        },
        {
          "id": "S4_F12",
          "source": "S4_RegisterNewStandard",
          "target": "S4_PublishPlanningStandard"
        },
        {
          "id": "S4_F13",
          "source": "S4_PublishPlanningStandard",
          "target": "S4_OrderTypeGate"
        },
        {
          "id": "S4_F14",
          "source": "S4_OrderTypeGate",
          "target": "S4_RequestPlannedOrderReplan",
          "name": "계획오더",
          "condition": "${plannedOrder == true}"
        },
        {
          "id": "S4_F15",
          "source": "S4_OrderTypeGate",
          "target": "S4_OrderChangeSafeGate",
          "name": "생산오더",
          "isDefault": true
        },
        {
          "id": "S4_F16",
          "source": "S4_RequestPlannedOrderReplan",
          "target": "S4_MergeOrderChange"
        },
        {
          "id": "S4_F17",
          "source": "S4_OrderChangeSafeGate",
