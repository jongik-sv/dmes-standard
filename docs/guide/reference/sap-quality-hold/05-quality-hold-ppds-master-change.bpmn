<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_QualityHoldPPDSMasterChange" targetNamespace="urn:sap-quality-hold-reference" exporter="Camunda Modeler" exporterVersion="5.46.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.15.0">
  <bpmn:collaboration id="Collaboration_QualityHoldPPDSMasterChange">
    <bpmn:participant id="Participant_QE" name="품질 · 기술변경 관리" processRef="Process_QE" />
    <bpmn:participant id="Participant_S4" name="SAP S/4HANA QM · PP" processRef="Process_S4" />
    <bpmn:participant id="Participant_PPDS" name="SAP S/4HANA PP/DS" processRef="Process_PPDS" />
    <bpmn:participant id="Participant_DM" name="SAP Digital Manufacturing" processRef="Process_DM" />
    <bpmn:participant id="Participant_PC" name="생산관리 · 현장" processRef="Process_PC" />
    <bpmn:messageFlow id="MF_PC_DM_ActualStatus" name="실제 착수 · 자재투입 상태" sourceRef="PC_VerifyActualStatus" targetRef="DM_AssessSFCScope" />
    <bpmn:messageFlow id="MF_S4_QE_Containment" name="Q3 · 재고 · 오더 영향범위" sourceRef="S4_ContainQualityScope" targetRef="QE_AssessChangeNeed" />
    <bpmn:messageFlow id="MF_QE_S4_Revision" name="승인 Change Number · Revision" sourceRef="QE_PublishRevision" targetRef="S4_UpdateBOMRoutingPV" />
    <bpmn:messageFlow id="MF_S4_PPDS_PDS" name="생산버전 · BOM · Routing 변경" sourceRef="S4_PublishProductionVersion" targetRef="PPDS_GenerateChangedPDS" />
    <bpmn:messageFlow id="MF_S4_PPDS_PlannedOrders" name="미착수 계획오더 목록" sourceRef="S4_SendPlannedOrderCandidates" targetRef="PPDS_PreparePlannedOrders" />
    <bpmn:messageFlow id="MF_S4_PPDS_ProductionOrders" name="갱신 · 대체 생산오더" sourceRef="S4_SendChangedOrders" targetRef="PPDS_AdoptChangedProductionOrders" />
    <bpmn:messageFlow id="MF_S4_DM_OrderChange" name="Order BOM · Routing · 일정" sourceRef="S4_SendChangedOrders" targetRef="DM_WaitChangedOrder" />
    <bpmn:messageFlow id="MF_PPDS_S4_Plan" name="자재 · 능력 · 부모오더 영향" sourceRef="PPDS_SendS4Plan" targetRef="S4_ReceivePlanningImpact" />
    <bpmn:messageFlow id="MF_PPDS_DM_Schedule" name="확정 실행일정" sourceRef="PPDS_SendDMSchedule" targetRef="DM_WaitExecutableSchedule" />
    <bpmn:messageFlow id="MF_S4_QE_Readiness" name="계획 · 오더 · 구성품 조치 완료" sourceRef="S4_ApplyParentOrderActions" targetRef="QE_ReviewReadiness" />
    <bpmn:messageFlow id="MF_QE_DM_Release" name="개정 적용 생산 승인" sourceRef="QE_ApproveProductionResume" targetRef="DM_WaitQualityApproval" />
    <bpmn:messageFlow id="MF_DM_PC_ResumeChanged" name="승인된 SFC Release" sourceRef="DM_ReleaseChangedSFC" targetRef="PC_WaitRelease" />
    <bpmn:textAnnotation id="PC_AnnoComponents">
      <bpmn:text>이미 투입된 구성품은 Hold만으로 자동 취소되지 않는다.
미투입품은 반납·재예약, 의심 Batch는 격리 후 SAP 재고상태와 일치시킨다.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="DM_AnnoSelection">
      <bpmn:text>SFC가 In Queue라도 이전 공정 완료 이력이 있으면 생산 착수로 본다.
주문 전체 Upversion보다 미착수 SFC 선별 또는 잔량 분리가 안전하다.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="PPDS_AnnoNoCascade">
      <bpmn:text>PP/DS는 품질 Hold를 실행하거나 부모·하위 오더를 자동 Hold하지 않는다.
가용일·수량·오더 데이터를 바꾼 후 페깅과 일정으로 영향을 계산한다.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="QE_AnnoVersionPolicy">
      <bpmn:text>기존 생산버전을 덮어쓰거나 삭제하지 않는다.
생산 중 WIP는 기존 개정, 미착수분은 신규 개정을 사용한다.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="QE_AssocVersionPolicy" sourceRef="QE_PublishRevision" targetRef="QE_AnnoVersionPolicy" />
    <bpmn:textAnnotation id="S4_AnnoStarted">
      <bpmn:text>착수 판정: Confirmation/PCNF/CNF, 구성품 GI·Backflush,
생산 GR·Delivery, 외주 PO, 검사 Lot, DM SFC 이력까지 확인한다.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="S4_AssocStarted" sourceRef="S4_StartedOrderGate" targetRef="S4_AnnoStarted" />
    <bpmn:textAnnotation id="S4_AnnoReread">
      <bpmn:text>Read PP Master Data는 기존 구성품·공정·할당을 삭제 후 재생성한다.
릴리즈 상태, 원가, 가용성, 검사 연계를 다시 검증한다.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="S4_AssocReread" sourceRef="S4_ReadPPMasterData" targetRef="S4_AnnoReread" />
    <bpmn:association id="PC_AssocComponents" sourceRef="PC_SegregateComponents" targetRef="PC_AnnoComponents" />
    <bpmn:association id="DM_AssocSelection" sourceRef="DM_UnstartedSFCGate" targetRef="DM_AnnoSelection" />
    <bpmn:association id="PPDS_AssocNoCascade" sourceRef="PPDS_TracePegging" targetRef="PPDS_AnnoNoCascade" />
  </bpmn:collaboration>
  <bpmn:process id="Process_QE" name="품질 · 기술변경 의사결정" isExecutable="false">
    <bpmn:documentation>품질이상의 기술적 처분과 Engineering Change를 승인한다. 생산 중 오더는 기존 개정을 유지하고 미착수 오더만 신규 BOM, Routing, Production Version 적용 대상으로 승인한다.</bpmn:documentation>
    <bpmn:startEvent id="QE_Start" name="품질이상 접수">
      <bpmn:outgoing>QE_F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="QE_RevisionRequiredGate" name="BOM 또는&#10;Routing 개정?" default="QE_F04">
      <bpmn:incoming>QE_F02</bpmn:incoming>
      <bpmn:outgoing>QE_F03</bpmn:outgoing>
      <bpmn:outgoing>QE_F04</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="QE_ApproveDispositionOnly" name="기존 개정 기준&#10;재작업 · 특채 · 폐기 승인">
      <bpmn:incoming>QE_F04</bpmn:incoming>
      <bpmn:outgoing>QE_F05</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="QE_EndNoRevision" name="마스터 변경 없음">
      <bpmn:incoming>QE_F05</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="QE_CreateEngineeringChange" name="Change Number · Revision&#10;유효일 생성">
      <bpmn:incoming>QE_F03</bpmn:incoming>
      <bpmn:outgoing>QE_F06</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="QE_ApproveRevision" name="신규 BOM · Routing ·&#10;생산버전 승인">
      <bpmn:incoming>QE_F06</bpmn:incoming>
      <bpmn:outgoing>QE_F07</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="QE_PublishRevision" name="개정판 Publish&#10;기존판 WIP용 유지">
      <bpmn:incoming>QE_F07</bpmn:incoming>
      <bpmn:outgoing>QE_F08</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="QE_CloseReadinessGaps" name="계획 · 자재 · 문서&#10;미비사항 보완">
      <bpmn:incoming>QE_F11</bpmn:incoming>
      <bpmn:outgoing>QE_F12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="QE_ApproveProductionResume" name="신규 개정 생산&#10;재개 승인">
      <bpmn:incoming>QE_F10</bpmn:incoming>
      <bpmn:outgoing>QE_F13</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="QE_EndChanged" name="개정 적용 승인 완료">
      <bpmn:incoming>QE_F13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="QE_F01" sourceRef="QE_Start" targetRef="QE_AssessChangeNeed" />
    <bpmn:sequenceFlow id="QE_F02" sourceRef="QE_AssessChangeNeed" targetRef="QE_RevisionRequiredGate" />
    <bpmn:sequenceFlow id="QE_F03" name="개정 필요" sourceRef="QE_RevisionRequiredGate" targetRef="QE_CreateEngineeringChange">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${masterRevisionRequired == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="QE_F04" name="개정 불필요" sourceRef="QE_RevisionRequiredGate" targetRef="QE_ApproveDispositionOnly" />
    <bpmn:sequenceFlow id="QE_F05" sourceRef="QE_ApproveDispositionOnly" targetRef="QE_EndNoRevision" />
    <bpmn:sequenceFlow id="QE_F06" sourceRef="QE_CreateEngineeringChange" targetRef="QE_ApproveRevision" />
    <bpmn:sequenceFlow id="QE_F07" sourceRef="QE_ApproveRevision" targetRef="QE_PublishRevision" />
    <bpmn:sequenceFlow id="QE_F08" sourceRef="QE_PublishRevision" targetRef="QE_ReviewReadiness" />
    <bpmn:sequenceFlow id="QE_F12" sourceRef="QE_CloseReadinessGaps" targetRef="QE_ReviewReadiness" />
    <bpmn:sequenceFlow id="QE_F09" sourceRef="QE_ReviewReadiness" targetRef="QE_ReadinessGate" />
    <bpmn:sequenceFlow id="QE_F10" name="완료" sourceRef="QE_ReadinessGate" targetRef="QE_ApproveProductionResume">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${revisionReady == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="QE_F11" name="미완료" sourceRef="QE_ReadinessGate" targetRef="QE_CloseReadinessGaps" />
    <bpmn:sequenceFlow id="QE_F13" sourceRef="QE_ApproveProductionResume" targetRef="QE_EndChanged" />
    <bpmn:userTask id="QE_AssessChangeNeed" name="NCR · Q3 · 페깅 영향&#10;기술검토">
      <bpmn:incoming>QE_F01</bpmn:incoming>
      <bpmn:outgoing>QE_F02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="QE_ReviewReadiness" name="계획 · 오더 · 구성품 ·&#10;실행준비 통합검토">
      <bpmn:incoming>QE_F08</bpmn:incoming>
      <bpmn:incoming>QE_F12</bpmn:incoming>
      <bpmn:outgoing>QE_F09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="QE_ReadinessGate" name="재개 준비&#10;완료?" default="QE_F11">
      <bpmn:incoming>QE_F09</bpmn:incoming>
      <bpmn:outgoing>QE_F10</bpmn:outgoing>
      <bpmn:outgoing>QE_F11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
  </bpmn:process>
  <bpmn:process id="Process_S4" name="S/4HANA 품질 · 생산오더 변경" isExecutable="false">
    <bpmn:documentation>S/4HANA QM과 PP에서 품질 봉쇄, 생산오더 실제실적 판정, 개정 마스터 반영, 미착수 생산오더의 PP Master Data 재읽기 또는 대체오더 생성, 구성품과 부모오더 조치를 수행한다.</bpmn:documentation>
    <bpmn:startEvent id="S4_Start" name="품질 Hold 신호 수신">
      <bpmn:outgoing>S4_F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="S4_ContainQualityScope" name="Q3 · 검사 Lot · Batch&#10;재고 봉쇄">
      <bpmn:incoming>S4_F01</bpmn:incoming>
      <bpmn:outgoing>S4_F02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="S4_CollectOrderFacts" name="생산오더 · 확정 · GI · GR ·&#10;외주 · 검사 Lot 상태 수집">
      <bpmn:incoming>S4_F02</bpmn:incoming>
      <bpmn:outgoing>S4_F03</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="S4_StartedOrderGate" name="생산 착수&#10;발생?" default="S4_F05">
      <bpmn:incoming>S4_F03</bpmn:incoming>
      <bpmn:outgoing>S4_F04</bpmn:outgoing>
      <bpmn:outgoing>S4_F05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="S4_KeepExistingRevision" name="기존 Order BOM · Routing 유지&#10;개정 적용대상 제외">
      <bpmn:incoming>S4_F05</bpmn:incoming>
      <bpmn:outgoing>S4_F06</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="S4_ProcessExistingDisposition" name="기존 개정 기준&#10;재작업 · 특채 · 폐기 처리">
      <bpmn:incoming>S4_F06</bpmn:incoming>
      <bpmn:outgoing>S4_F07</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="S4_EndExistingRevision" name="생산 중 오더 기존 개정 유지">
      <bpmn:incoming>S4_F07</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="S4_SelectUnstartedCandidates" name="미착수 오더 선별&#10;REL 상태만으로 판단 금지">
      <bpmn:incoming>S4_F04</bpmn:incoming>
      <bpmn:outgoing>S4_F08</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="S4_RevisionDecisionGate" name="마스터 개정&#10;승인?" default="S4_F10">
      <bpmn:incoming>S4_F08</bpmn:incoming>
      <bpmn:outgoing>S4_F09</bpmn:outgoing>
      <bpmn:outgoing>S4_F10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="S4_EndNoRevision" name="기존 마스터로 계속">
      <bpmn:incoming>S4_F11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="S4_UpdateBOMRoutingPV" name="Change Number 기준&#10;BOM · Routing · PV 반영">
      <bpmn:incoming>S4_F09</bpmn:incoming>
      <bpmn:outgoing>S4_F12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="S4_PublishProductionVersion" name="신규 생산버전&#10;PP/DS 변경전송">
      <bpmn:incoming>S4_F12</bpmn:incoming>
      <bpmn:outgoing>S4_F13</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="S4_DocumentTypeGate" name="계획오더 또는&#10;생산오더?" default="S4_F15">
      <bpmn:incoming>S4_F13</bpmn:incoming>
      <bpmn:outgoing>S4_F14</bpmn:outgoing>
      <bpmn:outgoing>S4_F15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="S4_SendPlannedOrderCandidates" name="미착수 계획오더&#10;PP/DS 재전개 요청">
      <bpmn:incoming>S4_F14</bpmn:incoming>
      <bpmn:outgoing>S4_F16</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="S4_RereadEligibilityGate" name="Read PP Master Data&#10;허용?" default="S4_F18">
      <bpmn:incoming>S4_F15</bpmn:incoming>
      <bpmn:outgoing>S4_F17</bpmn:outgoing>
      <bpmn:outgoing>S4_F18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="S4_ReadPPMasterData" name="CO02 Read PP Master Data&#10;신규 PV · Revision · Explosion Date">
      <bpmn:incoming>S4_F17</bpmn:incoming>
      <bpmn:outgoing>S4_F19</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="S4_RecheckOrder" name="구성품 · 공정 · 원가 ·&#10;가용성 재검증">
      <bpmn:incoming>S4_F19</bpmn:incoming>
      <bpmn:outgoing>S4_F20</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="S4_RereleaseOrder" name="오더 재스케줄 ·&#10;재릴리즈">
      <bpmn:incoming>S4_F20</bpmn:incoming>
      <bpmn:outgoing>S4_F21</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="S4_CreateReplacementOrder" name="재읽기 제한 시&#10;미착수 잔량 대체오더 생성">
      <bpmn:incoming>S4_F18</bpmn:incoming>
      <bpmn:outgoing>S4_F22</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="S4_RetireOldOrder" name="기존 오더 잔량 · 예약 ·&#10;페깅 정리">
      <bpmn:incoming>S4_F22</bpmn:incoming>
      <bpmn:outgoing>S4_F23</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="S4_MergeOrderUpdate" name="오더변경&#10;합류">
      <bpmn:incoming>S4_F16</bpmn:incoming>
      <bpmn:incoming>S4_F21</bpmn:incoming>
      <bpmn:incoming>S4_F23</bpmn:incoming>
      <bpmn:outgoing>S4_F24</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="S4_ApplyComponentRules" name="구성품 처리&#10;투입분 유지 · 미투입분 재예약&#10;의심 Batch 격리">
      <bpmn:incoming>S4_F24</bpmn:incoming>
      <bpmn:outgoing>S4_F25</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="S4_SendChangedOrders" name="변경 오더 · Order BOM ·&#10;Routing 배포">
      <bpmn:incoming>S4_F25</bpmn:incoming>
      <bpmn:outgoing>S4_F26</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="S4_ReceivePlanningImpact" name="PP/DS 재계획 결과 수신">
      <bpmn:incoming>S4_F26</bpmn:incoming>
      <bpmn:outgoing>S4_F27</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="S4_ApplyParentOrderActions" name="영향 부모오더만&#10;지연 · Hold · 대체공급 반영">
      <bpmn:incoming>S4_F27</bpmn:incoming>
      <bpmn:outgoing>S4_F28</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="S4_EndChanged" name="S/4 변경 완료">
      <bpmn:incoming>S4_F28</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="S4_F01" sourceRef="S4_Start" targetRef="S4_ContainQualityScope" />
    <bpmn:sequenceFlow id="S4_F02" sourceRef="S4_ContainQualityScope" targetRef="S4_CollectOrderFacts" />
    <bpmn:sequenceFlow id="S4_F03" sourceRef="S4_CollectOrderFacts" targetRef="S4_StartedOrderGate" />
    <bpmn:sequenceFlow id="S4_F04" name="미착수 증명" sourceRef="S4_StartedOrderGate" targetRef="S4_SelectUnstartedCandidates">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${orderStarted == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="S4_F05" name="착수 또는 불명확" sourceRef="S4_StartedOrderGate" targetRef="S4_KeepExistingRevision" />
    <bpmn:sequenceFlow id="S4_F06" sourceRef="S4_KeepExistingRevision" targetRef="S4_ProcessExistingDisposition" />
    <bpmn:sequenceFlow id="S4_F07" sourceRef="S4_ProcessExistingDisposition" targetRef="S4_EndExistingRevision" />
    <bpmn:sequenceFlow id="S4_F08" sourceRef="S4_SelectUnstartedCandidates" targetRef="S4_RevisionDecisionGate" />
    <bpmn:sequenceFlow id="S4_F09" name="승인됨" sourceRef="S4_RevisionDecisionGate" targetRef="S4_UpdateBOMRoutingPV">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${masterRevisionApproved == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="S4_F10" name="개정 없음" sourceRef="S4_RevisionDecisionGate" targetRef="S4_ApplyDispositionWithoutRevision" />
    <bpmn:sequenceFlow id="S4_F11" sourceRef="S4_ApplyDispositionWithoutRevision" targetRef="S4_EndNoRevision" />
    <bpmn:sequenceFlow id="S4_F12" sourceRef="S4_UpdateBOMRoutingPV" targetRef="S4_PublishProductionVersion" />
    <bpmn:sequenceFlow id="S4_F13" sourceRef="S4_PublishProductionVersion" targetRef="S4_DocumentTypeGate" />
    <bpmn:sequenceFlow id="S4_F14" name="PP/DS 계획오더" sourceRef="S4_DocumentTypeGate" targetRef="S4_SendPlannedOrderCandidates">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${hasPlannedOrders == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="S4_F15" name="S/4 생산오더" sourceRef="S4_DocumentTypeGate" targetRef="S4_RereadEligibilityGate" />
    <bpmn:sequenceFlow id="S4_F16" sourceRef="S4_SendPlannedOrderCandidates" targetRef="S4_MergeOrderUpdate" />
    <bpmn:sequenceFlow id="S4_F17" name="허용" sourceRef="S4_RereadEligibilityGate" targetRef="S4_ReadPPMasterData">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${rereadAllowed == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="S4_F18" name="확정 · GI · 검사 Lot 등 존재" sourceRef="S4_RereadEligibilityGate" targetRef="S4_CreateReplacementOrder" />
    <bpmn:sequenceFlow id="S4_F19" sourceRef="S4_ReadPPMasterData" targetRef="S4_RecheckOrder" />
    <bpmn:sequenceFlow id="S4_F20" sourceRef="S4_RecheckOrder" targetRef="S4_RereleaseOrder" />
    <bpmn:sequenceFlow id="S4_F21" sourceRef="S4_RereleaseOrder" targetRef="S4_MergeOrderUpdate" />
    <bpmn:sequenceFlow id="S4_F22" sourceRef="S4_CreateReplacementOrder" targetRef="S4_RetireOldOrder" />
    <bpmn:sequenceFlow id="S4_F23" sourceRef="S4_RetireOldOrder" targetRef="S4_MergeOrderUpdate" />
    <bpmn:sequenceFlow id="S4_F24" sourceRef="S4_MergeOrderUpdate" targetRef="S4_ApplyComponentRules" />
    <bpmn:sequenceFlow id="S4_F25" sourceRef="S4_ApplyComponentRules" targetRef="S4_SendChangedOrders" />
    <bpmn:sequenceFlow id="S4_F26" sourceRef="S4_SendChangedOrders" targetRef="S4_ReceivePlanningImpact" />
    <bpmn:sequenceFlow id="S4_F27" sourceRef="S4_ReceivePlanningImpact" targetRef="S4_ApplyParentOrderActions" />
    <bpmn:sequenceFlow id="S4_F28" sourceRef="S4_ApplyParentOrderActions" targetRef="S4_EndChanged" />
    <bpmn:userTask id="S4_ApplyDispositionWithoutRevision" name="마스터 변경 없이&#10;품질처분 · 일정조정">
      <bpmn:incoming>S4_F10</bpmn:incoming>
      <bpmn:outgoing>S4_F11</bpmn:outgoing>
    </bpmn:userTask>
  </bpmn:process>
  <bpmn:process id="Process_PPDS" name="PP/DS 공급 · 소요 · 상세일정 재계획" isExecutable="false">
    <bpmn:documentation>PP/DS는 품질 Hold 실행 주체가 아니다. 보류된 입고예정과 페깅을 기준으로 종속자재, 부모오더, 자원일정을 분석하며 신규 PDS로 미착수 계획오더를 재전개한다.</bpmn:documentation>
    <bpmn:startEvent id="PPDS_Start" name="품질 Hold 영향 수신">
      <bpmn:outgoing>PPDS_F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="PPDS_TracePegging" name="Dynamic · Fixed Pegging 추적&#10;종속자재 · 부모오더 식별">
      <bpmn:incoming>PPDS_F01</bpmn:incoming>
      <bpmn:outgoing>PPDS_F02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="PPDS_AdjustHeldReceipt" name="보류 생산입고&#10;가용일 지연 · 수량 감소">
      <bpmn:incoming>PPDS_F02</bpmn:incoming>
      <bpmn:outgoing>PPDS_F03</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="PPDS_ProtectAffectedSupply" name="의심 Batch · 전용공급 격리&#10;공용 정상공급은 유지">
      <bpmn:incoming>PPDS_F03</bpmn:incoming>
      <bpmn:outgoing>PPDS_F04</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="PPDS_RevisionDecisionGate" name="마스터 개정&#10;필요?" default="PPDS_F06">
      <bpmn:incoming>PPDS_F04</bpmn:incoming>
      <bpmn:outgoing>PPDS_F05</bpmn:outgoing>
      <bpmn:outgoing>PPDS_F06</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="PPDS_ReplanExistingRevision" name="기존 개정으로&#10;처분 · 일정 재계획">
      <bpmn:incoming>PPDS_F06</bpmn:incoming>
      <bpmn:outgoing>PPDS_F07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="PPDS_PublishExistingPlan" name="기존 개정 계획 배포">
      <bpmn:incoming>PPDS_F07</bpmn:incoming>
      <bpmn:outgoing>PPDS_F08</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="PPDS_GenerateChangedPDS" name="신규 생산버전에서&#10;PDS 생성 · 활성화">
      <bpmn:incoming>PPDS_F05</bpmn:incoming>
      <bpmn:outgoing>PPDS_F09</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:inclusiveGateway id="PPDS_OrderScopeGate" name="변경 대상&#10;오더유형">
      <bpmn:incoming>PPDS_F09</bpmn:incoming>
      <bpmn:outgoing>PPDS_F10</bpmn:outgoing>
      <bpmn:outgoing>PPDS_F11</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:userTask id="PPDS_PreparePlannedOrders" name="미착수 계획오더&#10;Firming · Fixed Pegging 검토">
      <bpmn:incoming>PPDS_F10</bpmn:incoming>
      <bpmn:outgoing>PPDS_F12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="PPDS_ReexplodePlannedOrders" name="신규 PDS로 재전개&#10;또는 삭제 · 재생성">
      <bpmn:incoming>PPDS_F12</bpmn:incoming>
      <bpmn:outgoing>PPDS_F13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="PPDS_F01" sourceRef="PPDS_Start" targetRef="PPDS_TracePegging" />
    <bpmn:sequenceFlow id="PPDS_F02" sourceRef="PPDS_TracePegging" targetRef="PPDS_AdjustHeldReceipt" />
    <bpmn:sequenceFlow id="PPDS_F03" sourceRef="PPDS_AdjustHeldReceipt" targetRef="PPDS_ProtectAffectedSupply" />
    <bpmn:sequenceFlow id="PPDS_F04" sourceRef="PPDS_ProtectAffectedSupply" targetRef="PPDS_RevisionDecisionGate" />
    <bpmn:sequenceFlow id="PPDS_F05" name="개정" sourceRef="PPDS_RevisionDecisionGate" targetRef="PPDS_GenerateChangedPDS">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${masterRevisionApproved == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="PPDS_F06" name="기존 개정" sourceRef="PPDS_RevisionDecisionGate" targetRef="PPDS_ReplanExistingRevision" />
    <bpmn:sequenceFlow id="PPDS_F07" sourceRef="PPDS_ReplanExistingRevision" targetRef="PPDS_PublishExistingPlan" />
    <bpmn:sequenceFlow id="PPDS_F08" sourceRef="PPDS_PublishExistingPlan" targetRef="PPDS_EndNoRevision" />
    <bpmn:sequenceFlow id="PPDS_F09" sourceRef="PPDS_GenerateChangedPDS" targetRef="PPDS_OrderScopeGate" />
    <bpmn:sequenceFlow id="PPDS_F10" name="계획오더" sourceRef="PPDS_OrderScopeGate" targetRef="PPDS_PreparePlannedOrders">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${hasPlannedOrders == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="PPDS_F11" name="생산오더" sourceRef="PPDS_OrderScopeGate" targetRef="PPDS_AdoptChangedProductionOrders">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${hasProductionOrders == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="PPDS_F12" sourceRef="PPDS_PreparePlannedOrders" targetRef="PPDS_ReexplodePlannedOrders" />
    <bpmn:sequenceFlow id="PPDS_F13" sourceRef="PPDS_ReexplodePlannedOrders" targetRef="PPDS_MergeChangedOrders" />
    <bpmn:sequenceFlow id="PPDS_F14" sourceRef="PPDS_AdoptChangedProductionOrders" targetRef="PPDS_MergeChangedOrders" />
    <bpmn:sequenceFlow id="PPDS_F15" sourceRef="PPDS_MergeChangedOrders" targetRef="PPDS_RunDetailedScheduling" />
    <bpmn:sequenceFlow id="PPDS_F20" sourceRef="PPDS_SendS4Plan" targetRef="PPDS_SendDMSchedule" />
    <bpmn:sequenceFlow id="PPDS_F21" sourceRef="PPDS_SendDMSchedule" targetRef="PPDS_EndChanged" />
    <bpmn:endEvent id="PPDS_EndNoRevision" name="기존 개정 재계획 완료">
      <bpmn:incoming>PPDS_F08</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="PPDS_AdoptChangedProductionOrders" name="갱신 · 대체 생산오더&#10;활동 · 소요 반영">
      <bpmn:incoming>PPDS_F11</bpmn:incoming>
      <bpmn:outgoing>PPDS_F14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:inclusiveGateway id="PPDS_MergeChangedOrders" name="변경오더&#10;합류">
      <bpmn:incoming>PPDS_F13</bpmn:incoming>
      <bpmn:incoming>PPDS_F14</bpmn:incoming>
      <bpmn:outgoing>PPDS_F15</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:serviceTask id="PPDS_RunDetailedScheduling" name="Product Heuristic ·&#10;Detailed Scheduling 실행">
      <bpmn:incoming>PPDS_F15</bpmn:incoming>
      <bpmn:outgoing>PPDS_F16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="PPDS_CheckMaterialCapacity" name="구성품 가용성 · 능력 ·&#10;자원대체 검증">
      <bpmn:incoming>PPDS_F16</bpmn:incoming>
      <bpmn:outgoing>PPDS_F17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="PPDS_RebuildPegging" name="Dynamic Pegging 재구성&#10;Fixed Pegging 유지 · 해제 검토">
      <bpmn:incoming>PPDS_F17</bpmn:incoming>
      <bpmn:outgoing>PPDS_F18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="PPDS_AssessParentOrders" name="부모오더 부족 · 지연 ·&#10;대체공급 영향 산출">
      <bpmn:incoming>PPDS_F18</bpmn:incoming>
      <bpmn:outgoing>PPDS_F19</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="PPDS_SendS4Plan" name="S/4에 자재 · 부모오더&#10;영향 배포">
      <bpmn:incoming>PPDS_F19</bpmn:incoming>
      <bpmn:outgoing>PPDS_F20</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sequenceFlow id="PPDS_F16" sourceRef="PPDS_RunDetailedScheduling" targetRef="PPDS_CheckMaterialCapacity" />
    <bpmn:sequenceFlow id="PPDS_F17" sourceRef="PPDS_CheckMaterialCapacity" targetRef="PPDS_RebuildPegging" />
    <bpmn:sequenceFlow id="PPDS_F18" sourceRef="PPDS_RebuildPegging" targetRef="PPDS_AssessParentOrders" />
    <bpmn:sequenceFlow id="PPDS_F19" sourceRef="PPDS_AssessParentOrders" targetRef="PPDS_SendS4Plan" />
    <bpmn:sendTask id="PPDS_SendDMSchedule" name="DM에 실행가능 일정&#10;배포">
      <bpmn:incoming>PPDS_F20</bpmn:incoming>
      <bpmn:outgoing>PPDS_F21</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="PPDS_EndChanged" name="PP/DS 재계획 완료">
      <bpmn:incoming>PPDS_F21</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:process id="Process_DM" name="SAP DM 생산중단 · SFC 개정 적용" isExecutable="false">
    <bpmn:documentation>SAP DM에서 품질이상 SFC를 Hold하고 실제 착수 여부와 SFC별 이력을 판정한다. 미착수 SFC만 Order BOM/Routing Upversion 또는 Production Change로 신규 개정을 적용하며 생산 중 SFC는 기존 개정으로 처분한다.</bpmn:documentation>
    <bpmn:startEvent id="DM_Start" name="품질이상 검출">
      <bpmn:outgoing>DM_F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="DM_RecordNC" name="NC · 검사결과 ·&#10;Buyoff Reject 기록">
      <bpmn:incoming>DM_F01</bpmn:incoming>
      <bpmn:outgoing>DM_F02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="DM_HoldAffectedSFC" name="영향 SFC Hold&#10;Start · Complete 차단">
      <bpmn:incoming>DM_F02</bpmn:incoming>
      <bpmn:outgoing>DM_F03</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="DM_AssessSFCScope" name="SFC · Batch · Genealogy&#10;영향범위와 상태 수집">
      <bpmn:incoming>DM_F03</bpmn:incoming>
      <bpmn:outgoing>DM_F04</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="DM_UnstartedSFCGate" name="SFC 완전&#10;미착수?" default="DM_F06">
      <bpmn:incoming>DM_F04</bpmn:incoming>
      <bpmn:outgoing>DM_F05</bpmn:outgoing>
      <bpmn:outgoing>DM_F06</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="DM_KeepExistingRevision" name="생산 중 SFC&#10;기존 BOM · Routing 유지">
      <bpmn:incoming>DM_F06</bpmn:incoming>
      <bpmn:outgoing>DM_F07</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="DM_ProcessMRBDisposition" name="재작업 · 특채 · 폐기&#10;MRB 처분 실행">
      <bpmn:incoming>DM_F07</bpmn:incoming>
      <bpmn:outgoing>DM_F08</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="DM_ResumeExistingRevision" name="허용된 기존 개정&#10;SFC Hold 해제">
      <bpmn:incoming>DM_F08</bpmn:incoming>
      <bpmn:outgoing>DM_F09</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="DM_EndExistingRevision" name="생산 중 SFC 처분 완료">
      <bpmn:incoming>DM_F09</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="DM_RevisionDecisionGate" name="마스터 개정&#10;승인?" default="DM_F11">
      <bpmn:incoming>DM_F05</bpmn:incoming>
      <bpmn:outgoing>DM_F10</bpmn:outgoing>
      <bpmn:outgoing>DM_F11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="DM_DispositionWithoutRevision" name="기존 BOM · Routing으로&#10;품질처분 반영">
      <bpmn:incoming>DM_F11</bpmn:incoming>
      <bpmn:outgoing>DM_F12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="DM_ResumeWithoutRevision" name="SFC Hold 해제&#10;기존 개정 재개">
      <bpmn:incoming>DM_F12</bpmn:incoming>
      <bpmn:outgoing>DM_F13</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="DM_EndNoRevision" name="마스터 변경 없이 재개">
      <bpmn:incoming>DM_F13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:receiveTask id="DM_WaitChangedOrder" name="S/4 변경오더 수신">
      <bpmn:incoming>DM_F10</bpmn:incoming>
      <bpmn:outgoing>DM_F14</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:serviceTask id="DM_UpversionOrder" name="SupportChangeAfterRelease&#10;Order BOM · Routing Upversion">
      <bpmn:incoming>DM_F14</bpmn:incoming>
      <bpmn:outgoing>DM_F15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="DM_MixedOrderGate" name="동일 오더에&#10;착수 SFC 혼재?" default="DM_F17">
      <bpmn:incoming>DM_F15</bpmn:incoming>
      <bpmn:outgoing>DM_F16</bpmn:outgoing>
      <bpmn:outgoing>DM_F17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="DM_ApplyAllUnstartedSFC" name="미착수 SFC 전체에&#10;신규 개정 할당">
      <bpmn:incoming>DM_F17</bpmn:incoming>
      <bpmn:outgoing>DM_F19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="DM_ApplySelectedSFC" name="Production Change API로 선별&#10;또는 미착수 잔량 오더 분리">
      <bpmn:incoming>DM_F16</bpmn:incoming>
      <bpmn:outgoing>DM_F18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="DM_MergeRevisionAssignment" name="개정할당&#10;합류">
      <bpmn:incoming>DM_F18</bpmn:incoming>
      <bpmn:incoming>DM_F19</bpmn:incoming>
      <bpmn:outgoing>DM_F20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="DM_HoldChangedSFC" name="HoldProduction=BY_SFC&#10;검토 중 Hold 유지">
      <bpmn:incoming>DM_F20</bpmn:incoming>
      <bpmn:outgoing>DM_F21</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:receiveTask id="DM_WaitExecutableSchedule" name="PP/DS 실행가능 일정 수신">
      <bpmn:incoming>DM_F21</bpmn:incoming>
      <bpmn:outgoing>DM_F22</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:receiveTask id="DM_WaitQualityApproval" name="품질 · 기술 생산재개 승인">
      <bpmn:incoming>DM_F22</bpmn:incoming>
      <bpmn:outgoing>DM_F23</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:sendTask id="DM_ReleaseChangedSFC" name="신규 개정 SFC&#10;Hold 해제 · Dispatch">
      <bpmn:incoming>DM_F23</bpmn:incoming>
      <bpmn:outgoing>DM_F24</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="DM_EndChanged" name="신규 개정 생산 준비">
      <bpmn:incoming>DM_F24</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="DM_F01" sourceRef="DM_Start" targetRef="DM_RecordNC" />
    <bpmn:sequenceFlow id="DM_F02" sourceRef="DM_RecordNC" targetRef="DM_HoldAffectedSFC" />
    <bpmn:sequenceFlow id="DM_F03" sourceRef="DM_HoldAffectedSFC" targetRef="DM_AssessSFCScope" />
    <bpmn:sequenceFlow id="DM_F04" sourceRef="DM_AssessSFCScope" targetRef="DM_UnstartedSFCGate" />
    <bpmn:sequenceFlow id="DM_F05" name="완전 미착수" sourceRef="DM_UnstartedSFCGate" targetRef="DM_RevisionDecisionGate">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${sfcEverStarted == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="DM_F06" name="착수 · 부분완료 · 불명확" sourceRef="DM_UnstartedSFCGate" targetRef="DM_KeepExistingRevision" />
    <bpmn:sequenceFlow id="DM_F07" sourceRef="DM_KeepExistingRevision" targetRef="DM_ProcessMRBDisposition" />
    <bpmn:sequenceFlow id="DM_F08" sourceRef="DM_ProcessMRBDisposition" targetRef="DM_ResumeExistingRevision" />
    <bpmn:sequenceFlow id="DM_F09" sourceRef="DM_ResumeExistingRevision" targetRef="DM_EndExistingRevision" />
    <bpmn:sequenceFlow id="DM_F10" name="개정 적용" sourceRef="DM_RevisionDecisionGate" targetRef="DM_WaitChangedOrder">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${masterRevisionApproved == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="DM_F11" name="개정 없음" sourceRef="DM_RevisionDecisionGate" targetRef="DM_DispositionWithoutRevision" />
    <bpmn:sequenceFlow id="DM_F12" sourceRef="DM_DispositionWithoutRevision" targetRef="DM_ResumeWithoutRevision" />
    <bpmn:sequenceFlow id="DM_F13" sourceRef="DM_ResumeWithoutRevision" targetRef="DM_EndNoRevision" />
    <bpmn:sequenceFlow id="DM_F14" sourceRef="DM_WaitChangedOrder" targetRef="DM_UpversionOrder" />
    <bpmn:sequenceFlow id="DM_F15" sourceRef="DM_UpversionOrder" targetRef="DM_MixedOrderGate" />
    <bpmn:sequenceFlow id="DM_F16" name="혼재" sourceRef="DM_MixedOrderGate" targetRef="DM_ApplySelectedSFC">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${mixedSFCStatus == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="DM_F17" name="모두 미착수" sourceRef="DM_MixedOrderGate" targetRef="DM_ApplyAllUnstartedSFC" />
    <bpmn:sequenceFlow id="DM_F19" sourceRef="DM_ApplyAllUnstartedSFC" targetRef="DM_MergeRevisionAssignment" />
    <bpmn:sequenceFlow id="DM_F18" sourceRef="DM_ApplySelectedSFC" targetRef="DM_MergeRevisionAssignment" />
    <bpmn:sequenceFlow id="DM_F20" sourceRef="DM_MergeRevisionAssignment" targetRef="DM_HoldChangedSFC" />
    <bpmn:sequenceFlow id="DM_F21" sourceRef="DM_HoldChangedSFC" targetRef="DM_WaitExecutableSchedule" />
    <bpmn:sequenceFlow id="DM_F22" sourceRef="DM_WaitExecutableSchedule" targetRef="DM_WaitQualityApproval" />
    <bpmn:sequenceFlow id="DM_F23" sourceRef="DM_WaitQualityApproval" targetRef="DM_ReleaseChangedSFC" />
    <bpmn:sequenceFlow id="DM_F24" sourceRef="DM_ReleaseChangedSFC" targetRef="DM_EndChanged" />
  </bpmn:process>
  <bpmn:process id="Process_PC" name="생산관리 · 현장 중단과 재개" isExecutable="false">
    <bpmn:documentation>현장에서 영향 WIP를 즉시 정지하고 투입·미투입 구성품과 실제 착수상태를 확인한다. 승인된 기존 또는 신규 개정의 SFC만 작업문서와 배치를 확인한 후 생산을 재개한다.</bpmn:documentation>
    <bpmn:startEvent id="PC_Start" name="중단 지시 수신">
      <bpmn:outgoing>PC_F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:manualTask id="PC_StopAffectedWIP" name="영향 설비 · WIP&#10;안전 정지">
      <bpmn:incoming>PC_F01</bpmn:incoming>
      <bpmn:outgoing>PC_F02</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="PC_SegregateComponents" name="투입 · 미투입 · 의심 Batch&#10;물리적 식별 · 격리">
      <bpmn:incoming>PC_F02</bpmn:incoming>
      <bpmn:outgoing>PC_F03</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="PC_VerifyActualStatus" name="작업착수 · 실적 · 자재투입&#10;현장사실 확인">
      <bpmn:incoming>PC_F03</bpmn:incoming>
      <bpmn:outgoing>PC_F04</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="PC_ReportActualStatus" name="S/4 · DM에&#10;실제상태 보고">
      <bpmn:incoming>PC_F04</bpmn:incoming>
      <bpmn:outgoing>PC_F05</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="PC_WaitRelease" name="승인된 SFC Release 대기">
      <bpmn:incoming>PC_F05</bpmn:incoming>
      <bpmn:outgoing>PC_F06</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="PC_CheckRevisionDocuments" name="BOM · Routing · 작업지시 ·&#10;배치 · 자재 확인">
      <bpmn:incoming>PC_F06</bpmn:incoming>
      <bpmn:outgoing>PC_F07</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="PC_ResumeProduction" name="승인 개정으로&#10;생산 재개">
      <bpmn:incoming>PC_F07</bpmn:incoming>
      <bpmn:outgoing>PC_F08</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="PC_End" name="현장 재개 완료">
      <bpmn:incoming>PC_F08</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="PC_F01" sourceRef="PC_Start" targetRef="PC_StopAffectedWIP" />
    <bpmn:sequenceFlow id="PC_F02" sourceRef="PC_StopAffectedWIP" targetRef="PC_SegregateComponents" />
    <bpmn:sequenceFlow id="PC_F03" sourceRef="PC_SegregateComponents" targetRef="PC_VerifyActualStatus" />
    <bpmn:sequenceFlow id="PC_F04" sourceRef="PC_VerifyActualStatus" targetRef="PC_ReportActualStatus" />
    <bpmn:sequenceFlow id="PC_F05" sourceRef="PC_ReportActualStatus" targetRef="PC_WaitRelease" />
    <bpmn:sequenceFlow id="PC_F06" sourceRef="PC_WaitRelease" targetRef="PC_CheckRevisionDocuments" />
    <bpmn:sequenceFlow id="PC_F07" sourceRef="PC_CheckRevisionDocuments" targetRef="PC_ResumeProduction" />
    <bpmn:sequenceFlow id="PC_F08" sourceRef="PC_ResumeProduction" targetRef="PC_End" />
  </bpmn:process>
