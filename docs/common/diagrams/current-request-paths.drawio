        <mxCell id="oasisUi" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;fontSize=13;fontColor=#4C1D95;" value="mcm 접근관리 화면&#xa;POST /api/{module}/oasis/{serviceId}/{action}&#xa;예: /api/mcm/oasis/secMenu/search" vertex="1">
