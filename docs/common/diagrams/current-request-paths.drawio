        <mxCell id="e3" edge="1" parent="1" source="oasisUi" style="endArrow=block;html=1;rounded=0;strokeColor=#D97706;strokeWidth=2;entryX=-0.004;entryY=0.398;entryDx=0;entryDy=0;entryPerimeter=0;" target="proxy" value="">
