        <mxCell id="cmp-h1" value="항목" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1e5eb;strokeColor=#999999;fontSize=11;fontStyle=1;" vertex="1" parent="cmp">
          <mxGeometry x="0" y="0" width="200" height="30" as="geometry" />
