        <mxCell id="e-auth-gw" value="/api/auth/*&lt;br&gt;→ portal WAS 고정" style="endArrow=classic;html=1;fontSize=10;dashed=0;strokeColor=#82b366;" edge="1" parent="1" source="bff-authroute-v" target="portal-was">
          <mxGeometry relative="1" as="geometry" />
