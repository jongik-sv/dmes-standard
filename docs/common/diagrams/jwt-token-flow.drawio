        <mxCell id="cmp-h2" value="외피 — NextAuth 세션 (JWE)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#999999;fontSize=11;fontStyle=1;" vertex="1" parent="cmp">
          <mxGeometry x="200" y="0" width="620" height="30" as="geometry" />
