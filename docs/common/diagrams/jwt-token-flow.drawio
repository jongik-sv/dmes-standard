        <mxCell id="cmp-r1c" value="login API 발급/갱신용 (2026-05-21~ BFF↔WAS 호출 인증에는 미사용 — shared secret 모델)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="cmp">
          <mxGeometry x="820" y="30" width="780" height="40" as="geometry" />
        </mxCell>

        <mxCell id="cmp-r2a" value="발급 주체" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8f8f8;strokeColor=#cccccc;fontSize=10;fontStyle=1;" vertex="1" parent="cmp">
          <mxGeometry x="0" y="70" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="cmp-r2b" value="BFF 자신 (NextAuth jwt callback)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="cmp">
          <mxGeometry x="200" y="70" width="620" height="40" as="geometry" />
        </mxCell>
        <mxCell id="cmp-r2c" value="mcm WAS (AuthService.login / refresh)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="cmp">
          <mxGeometry x="820" y="70" width="780" height="40" as="geometry" />
        </mxCell>

        <mxCell id="cmp-r3a" value="형식·암호" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8f8f8;strokeColor=#cccccc;fontSize=10;fontStyle=1;" vertex="1" parent="cmp">
          <mxGeometry x="0" y="110" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="cmp-r3b" value="JWE (A256GCM 대칭 암호화) — 페이로드 비공개" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="cmp">
          <mxGeometry x="200" y="110" width="620" height="40" as="geometry" />
        </mxCell>
        <mxCell id="cmp-r3c" value="JWS (HS256 HMAC 서명) — 페이로드 base64url 평문" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="cmp">
          <mxGeometry x="820" y="110" width="780" height="40" as="geometry" />
        </mxCell>

        <mxCell id="cmp-r4a" value="서명/암호 키" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8f8f8;strokeColor=#cccccc;fontSize=10;fontStyle=1;" vertex="1" parent="cmp">
          <mxGeometry x="0" y="150" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="cmp-r4b" value="AUTH_SECRET  (BFF 만 보유)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;align=left;spacingLeft=8;fontFamily=Menlo,monospace;" vertex="1" parent="cmp">
          <mxGeometry x="200" y="150" width="620" height="40" as="geometry" />
        </mxCell>
        <mxCell id="cmp-r4c" value="cactus.jwt.secret  (모든 WAS 공유, BFF 는 모름)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;align=left;spacingLeft=8;fontFamily=Menlo,monospace;" vertex="1" parent="cmp">
          <mxGeometry x="820" y="150" width="780" height="40" as="geometry" />
        </mxCell>

        <mxCell id="cmp-r5a" value="검증 주체" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8f8f8;strokeColor=#cccccc;fontSize=10;fontStyle=1;" vertex="1" parent="cmp">
          <mxGeometry x="0" y="190" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="cmp-r5b" value="BFF (getToken / NextAuth jwt callback)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="cmp">
          <mxGeometry x="200" y="190" width="620" height="40" as="geometry" />
        </mxCell>
        <mxCell id="cmp-r5c" value="login/refresh API 응답 검증 시에만 mcm WAS JwtTokenProvider 가 사용 (2026-05-21~ BFF↔BE 일반 호출에서는 검증 안 함)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="cmp">
          <mxGeometry x="820" y="190" width="780" height="40" as="geometry" />
        </mxCell>

        <mxCell id="cmp-r6a" value="저장 위치" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8f8f8;strokeColor=#cccccc;fontSize=10;fontStyle=1;" vertex="1" parent="cmp">
          <mxGeometry x="0" y="230" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="cmp-r6b" value="브라우저 쿠키 + BFF 요청 메모리" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="cmp">
          <mxGeometry x="200" y="230" width="620" height="40" as="geometry" />
        </mxCell>
        <mxCell id="cmp-r6c" value="NextAuth JWT 안에 호환 보관 (2026-05-21~ BE 로 forward 되지 않음)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="cmp">
          <mxGeometry x="820" y="230" width="780" height="40" as="geometry" />
        </mxCell>

        <mxCell id="cmp-r7a" value="수명" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8f8f8;strokeColor=#cccccc;fontSize=10;fontStyle=1;" vertex="1" parent="cmp">
          <mxGeometry x="0" y="270" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="cmp-r7b" value="세션 쿠키 수명 (NextAuth 기본 30일, 쿠키 maxAge 설정 기준)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="cmp">
          <mxGeometry x="200" y="270" width="620" height="40" as="geometry" />
        </mxCell>
        <mxCell id="cmp-r7c" value="access 8시간 / refresh 7일 (mcm cactus.jwt.access-token-expiry=28800 / refresh-token-expiry=604800)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="cmp">
          <mxGeometry x="820" y="270" width="780" height="40" as="geometry" />
        </mxCell>

        <mxCell id="cmp-r8a" value="노출 위험" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8f8f8;strokeColor=#cccccc;fontSize=10;fontStyle=1;" vertex="1" parent="cmp">
          <mxGeometry x="0" y="310" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="cmp-r8b" value="httpOnly 로 JS 비노출. 암호화되어 MITM 에서 값 읽어도 내용 불가." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="cmp">
          <mxGeometry x="200" y="310" width="620" height="40" as="geometry" />
        </mxCell>
        <mxCell id="cmp-r8c" value="BFF↔BE forward 안 함 → 네트워크/프록시 로그 노출 위험 제거. login 응답 한정 노출만 (2026-05-21~)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="cmp">
          <mxGeometry x="820" y="310" width="780" height="40" as="geometry" />
        </mxCell>

        <mxCell id="cmp-r9a" value="회수·회전" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8f8f8;strokeColor=#cccccc;fontSize=10;fontStyle=1;" vertex="1" parent="cmp">
          <mxGeometry x="0" y="350" width="200" height="30" as="geometry" />
        </mxCell>
        <mxCell id="cmp-r9b" value="AUTH_SECRET 교체 = 전 사용자 즉시 로그아웃" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="cmp">
          <mxGeometry x="200" y="350" width="620" height="30" as="geometry" />
        </mxCell>
        <mxCell id="cmp-r9c" value="cactus.jwt.secret 교체 = mcm WAS login 토큰 재발급 영향. BACKEND_CLIENT_KEY 회전 = 전 BFF↔BE 호출 동시 영향." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="cmp">
          <mxGeometry x="820" y="350" width="780" height="30" as="geometry" />
        </mxCell>

        <mxCell id="risk-box" value="구조상 꼭 기억할 5가지 (2026-05-21~ shared secret 모델 기준)&lt;br&gt;────────────────&lt;br&gt;① 세 시크릿(AUTH_SECRET · cactus.jwt.secret · BACKEND_CLIENT_KEY) 은 절대 같은 값이면 안 된다.&lt;br&gt;② AUTH_SECRET 유출 : NextAuth 세션 탈취 가능 — 사용자 컨텍스트(sub/roles) 가 외부 노출.&lt;br&gt;③ BACKEND_CLIENT_KEY 유출 : BFF 위조 가능 — 임의 X-Authenticated-User/Role 헤더로 BE 접근 가능.&lt;br&gt;   ★ shared secret 모델의 단일 신뢰 게이트라 가장 중요. 회전 정책 + 네트워크 경계 제한 필수.&lt;br&gt;④ cactus.jwt.secret 유출 : mcm login API 의 토큰 위조 가능. BFF↔BE 일반 호출엔 영향 적음 (JWT 검증 안 함).&lt;br&gt;⑤ 브라우저 JS 는 어떤 경우에도 cactus JWT 를 볼 수 없다 — NextAuth 세션 쿠키만 보유, 그것마저 httpOnly + JWE." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="990" width="1600" height="150" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
