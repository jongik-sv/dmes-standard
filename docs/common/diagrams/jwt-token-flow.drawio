        <mxCell id="a5-aps" value="APS WAS&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;(공정계획 · :8081)&lt;/font&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="720" y="60" width="160" height="990" as="geometry" />
        </mxCell>
        <mxCell id="a5-mpp" value="MPP WAS&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;(조업관리 · :8083)&lt;/font&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="940" y="60" width="160" height="990" as="geometry" />
        </mxCell>
        <mxCell id="a5-mqc" value="MQC WAS&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;(품질관리 · :8084)&lt;/font&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1160" y="60" width="160" height="990" as="geometry" />
        </mxCell>

        <mxCell id="p5s1" value="— Step A :  로그인은 언제나 portal WAS 로 고정 —" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=2;fontColor=#666666" vertex="1" parent="1">
          <mxGeometry x="60" y="180" width="1260" height="20" as="geometry" />
        </mxCell>

        <mxCell id="p5m1" value="1. POST /api/auth/login (userId, password)" style="html=1;endArrow=classic;startArrow=none;edgeStyle=none;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="130" y="220" as="sourcePoint" />
            <mxPoint x="350" y="220" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p5a1" value="2. /api/auth 경로 → authenticateViaBackend()&lt;br&gt;upstream = MCM_WAS_URL (mcm WAS 고정)&lt;br&gt;portal NextAuth → BE /api/auth/login&lt;br&gt;(ClientKeyFilter skip path: /api/auth/**)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="240" y="245" width="260" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p5m3" value="3. POST {MCM_WAS}/api/auth/login&lt;br&gt;(NextAuth → mcm BE McmAuthController, ClientKeyFilter skip /api/auth/**)" style="html=1;endArrow=classic;startArrow=none;edgeStyle=none;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="350" y="310" as="sourcePoint" />
            <mxPoint x="580" y="310" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p5a2" value="4. cactus AuthService.login()&lt;br&gt;SecUserRepository + BCrypt + loadUserRoles&lt;br&gt;+ JwtTokenProvider.generate(SecUser)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="480" y="335" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p5m5" value="5. 200 {accessToken, refreshToken, userInfo}" style="html=1;endArrow=classic;startArrow=none;edgeStyle=none;rounded=0;dashed=1;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="580" y="400" as="sourcePoint" />
            <mxPoint x="350" y="400" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p5a3" value="6. NextAuth jwt callback&lt;br&gt;token.backendAccessToken / RefreshToken / roles 보관" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="240" y="425" width="260" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p5m7" value="7. 200  +  Set-Cookie: oasis-portal-auth.session-token" style="html=1;endArrow=classic;startArrow=none;edgeStyle=none;rounded=0;dashed=1;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="350" y="490" as="sourcePoint" />
            <mxPoint x="130" y="490" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="p5s2" value="— Step B :  업무 API — /api/{module}/oasis/… 또는 /api/{module}/nooasis/… 는 module 키로 upstream 분기 —" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=2;fontColor=#666666" vertex="1" parent="1">
          <mxGeometry x="60" y="525" width="1260" height="20" as="geometry" />
        </mxCell>

        <mxCell id="p5m8" value="8. POST /api/aps/oasis/scheduling/search" style="html=1;endArrow=classic;startArrow=none;edgeStyle=none;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="130" y="565" as="sourcePoint" />
            <mxPoint x="350" y="565" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p5a4" value="9. createOasisProxyHandler&lt;br&gt;module=&quot;aps&quot; → upstream = APS_WAS_URL&lt;br&gt;인증 헤더: X-Client-Key + X-Authenticated-User&lt;br&gt;+ X-Authenticated-Role (2026-05-21~)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;verticalAlign=middle;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="240" y="585" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p5m10" value="10. POST {APS_WAS}/oasis/scheduling/search&lt;br&gt;X-Client-Key + X-Authenticated-User + X-Authenticated-Role + X-Request-Id" style="html=1;endArrow=classic;startArrow=none;edgeStyle=none;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="350" y="685" as="sourcePoint" />
            <mxPoint x="800" y="685" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p5a5" value="11. cactus 필터 체인 (2026-05-21~ shared secret 모델):&lt;br&gt;TxIdFilter → RequestIdFilter → ClientKeyFilter → JwtAuthenticationFilter&lt;br&gt;★ ClientKeyFilter 가 X-Client-Key 검증 후 X-Authenticated-*&lt;br&gt;헤더로 SecurityContext 사전 인증 set → JwtAuthFilter 는 사전 인증&lt;br&gt;보존 분기로 JWT 검증 스킵 → cactus OasisController 실행" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;verticalAlign=middle;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="700" y="690" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p5m12" value="12. 200 {schedule grid}" style="html=1;endArrow=classic;startArrow=none;edgeStyle=none;rounded=0;dashed=1;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="800" y="760" as="sourcePoint" />
            <mxPoint x="350" y="760" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p5m13" value="13. 200" style="html=1;endArrow=classic;startArrow=none;edgeStyle=none;rounded=0;dashed=1;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="350" y="780" as="sourcePoint" />
            <mxPoint x="130" y="780" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="p5m14" value="14. POST /api/mpp/oasis/workOrder/save" style="html=1;endArrow=classic;startArrow=none;edgeStyle=none;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="130" y="820" as="sourcePoint" />
            <mxPoint x="350" y="820" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p5a6" value="15. module=&quot;mpp&quot; → upstream = MPP_WAS_URL&lt;br&gt;인증 헤더 3 종 (shared secret 모델, 사용자 JWT 미전달)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="240" y="840" width="260" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p5m16" value="16. POST {MPP_WAS}/oasis/workOrder/save  (X-Client-Key + X-Authenticated-User + X-Authenticated-Role + X-Request-Id)" style="html=1;endArrow=classic;startArrow=none;edgeStyle=none;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="350" y="895" as="sourcePoint" />
            <mxPoint x="1020" y="895" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p5m17" value="17. 200" style="html=1;endArrow=classic;startArrow=none;edgeStyle=none;rounded=0;dashed=1;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1020" y="915" as="sourcePoint" />
            <mxPoint x="130" y="915" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="p5m18" value="18. POST /api/mqc/oasis/ncr/search" style="html=1;endArrow=classic;startArrow=none;edgeStyle=none;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="130" y="955" as="sourcePoint" />
            <mxPoint x="350" y="955" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p5a7" value="19. module=&quot;mqc&quot; → upstream = MQC_WAS_URL" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="240" y="975" width="260" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p5m20" value="20. POST {MQC_WAS}/oasis/ncr/search  (X-Client-Key + X-Authenticated-User + X-Authenticated-Role + X-Request-Id)" style="html=1;endArrow=classic;startArrow=none;edgeStyle=none;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="350" y="1020" as="sourcePoint" />
            <mxPoint x="1240" y="1020" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p5m21" value="21. 200" style="html=1;endArrow=classic;startArrow=none;edgeStyle=none;rounded=0;dashed=1;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1040" as="sourcePoint" />
            <mxPoint x="130" y="1040" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="p5note" value="이 그림의 포인트 (2026-05-21 기준)&lt;br&gt;────────────────&lt;br&gt;· 브라우저는 항상 BFF 만 안다 — 모듈별 WAS URL 은 외부 비공개.&lt;br&gt;· 로그인(/api/auth/*)은 URL 분기와 무관하게 mcm WAS &lt;b&gt;McmAuthController&lt;/b&gt; 로만 간다.&lt;br&gt;· 업무 호출은 module 키(aps/mpn/mpp/mqc/mcm/…)만 보고 upstream 선택.&lt;br&gt;· UI→BFF: /api/{module}/oasis/{serviceId}/{action} 또는 /api/{module}/rest/{API_PATH}.&lt;br&gt;· BFF→BE: OASIS 그대로, REST 는 rest segment 제거.&lt;br&gt;&lt;br&gt;★ 2026-05-21~ BFF↔BE shared secret 신뢰 모델:&lt;br&gt;· 업무 호출 단일 동선: BFF 가 X-Client-Key(env BACKEND_CLIENT_KEY)&lt;br&gt;  + X-Authenticated-User + X-Authenticated-Role + X-Request-Id 부착.&lt;br&gt;· Authorization: Bearer 폐기 — 사용자 JWT 를 BE 로 forward 하지 않음.&lt;br&gt;· cactus 필터 순서: TxIdFilter → RequestIdFilter → ClientKeyFilter → JwtAuthenticationFilter → Spring Security 표준.&lt;br&gt;  ClientKeyFilter 가 SecurityContext 사전 인증을 set → JwtAuthFilter 가 검증 스킵.&lt;br&gt;· /api/auth/** 는 ClientKeyFilter skip path (mcm SecurityConfig 가 permitAll).&lt;br&gt;· BFF self-fetch (RBAC cache warmup): X-Internal-Bff-Call=1 + X-Authenticated-User/Role fallback.&lt;br&gt;&lt;br&gt;★ Refresh 흐름은 BFF↔BE 경로에서 더 이상 발생하지 않는다.&lt;br&gt;  (BE access token 만료가 BFF 호출의 401 을 유발하지 않으므로)&lt;br&gt;  업무 WAS 는 refresh 엔드포인트를 가질 필요가 없다." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="60" width="600" height="340" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="⑥ 이중 토큰 구조 (외피 JWE + 내피 JWT)" id="dual-token">
    <mxGraphModel dx="1422" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1180" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="t6" value="⑥ 이중 토큰 구조 — 외피(NextAuth JWE) + 내피(cactus JWT, 호환 보관)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1400" height="30" as="geometry" />
        </mxCell>

        <mxCell id="t6sub" value="두 토큰이 한 사용자 세션에 공존한다. 브라우저는 외피만, WAS 는 내피를 보유하나 인증에 쓰지 않는다 (2026-05-21~ shared secret 모델). BFF 는 외피를 복호화해 사용자 컨텍스트(sub/roles)만 꺼내 X-Authenticated-* 헤더로 BE 에 전달한다." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#555555" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="1600" height="50" as="geometry" />
        </mxCell>

        <mxCell id="browser6" value="Browser" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;verticalAlign=top;spacingTop=10;container=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="110" width="280" height="280" as="geometry" />
        </mxCell>
        <mxCell id="browser6inner" value="외피 1개만 보유&lt;br&gt;──────────────&lt;br&gt;oasis-portal-auth.session-token&lt;br&gt;&lt;br&gt;httpOnly · sameSite=lax · (운영) Secure&lt;br&gt;JS 로 접근 불가&lt;br&gt;&lt;br&gt;값은 암호화되어 판독 불가&lt;br&gt;(내부의 cactus JWT 조차 보이지 않음)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;" vertex="1" parent="browser6">
          <mxGeometry x="10" y="40" width="260" height="230" as="geometry" />
        </mxCell>

        <mxCell id="bff6" value="Next.js BFF" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;verticalAlign=top;spacingTop=10;container=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="480" y="110" width="480" height="420" as="geometry" />
        </mxCell>
        <mxCell id="bff6step1" value="① getToken(req, {secret: AUTH_SECRET})&lt;br&gt;   → 외피 JWE 복호화 (AUTH_SECRET 필요)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;fontStyle=1;" vertex="1" parent="bff6">
          <mxGeometry x="15" y="45" width="450" height="50" as="geometry" />
        </mxCell>
        <mxCell id="bff6decoded" value="복호화된 NextAuth token 객체 (평문, 서버 메모리에만)&lt;br&gt;────────────────&lt;br&gt;{&lt;br&gt;  sub: &quot;admin&quot;,&lt;br&gt;  role: &quot;sysadmin&quot;,&lt;br&gt;  roles: [&quot;SYSADMIN&quot;],&lt;br&gt;  backendAccessToken  : &quot;eyJhbGciOiJIUzI1NiJ9.ey…&quot;,  ← 내피 (cactus JWS)&lt;br&gt;  backendRefreshToken : &quot;eyJhbGciOiJIUzI1NiJ9.ey…&quot;,&lt;br&gt;  iat, exp …&lt;br&gt;}" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;fontFamily=Menlo,monospace;" vertex="1" parent="bff6">
          <mxGeometry x="15" y="105" width="450" height="160" as="geometry" />
        </mxCell>
        <mxCell id="bff6step2" value="② RBAC 판단은 token.role/roles 로 (외피의 평문 필드)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;fontStyle=1;" vertex="1" parent="bff6">
          <mxGeometry x="15" y="275" width="450" height="35" as="geometry" />
        </mxCell>
        <mxCell id="bff6step3" value="③ 업무 API 호출 시 token.sub / token.roles 를 꺼내&lt;br&gt;   X-Authenticated-User / X-Authenticated-Role 헤더로 WAS 로 중계&lt;br&gt;   + X-Client-Key (shared secret) 를 함께 부착&lt;br&gt;   ※ 2026-05-21~ : token.backendAccessToken 은 BE 에 forward 하지 않음&lt;br&gt;   (호환 보관용으로만 NextAuth JWT 에 남아 있음)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;fontStyle=1;" vertex="1" parent="bff6">
          <mxGeometry x="15" y="320" width="450" height="100" as="geometry" />
        </mxCell>

        <mxCell id="was6" value="WAS 클러스터&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal&quot;&gt;mcm · MPN · MPP · MQC&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;fontStyle=1;verticalAlign=top;spacingTop=10;container=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="1100" y="110" width="560" height="470" as="geometry" />
        </mxCell>
        <mxCell id="was6inner" value="내피는 login API 발급용 (BFF↔BE 인증에는 미사용)&lt;br&gt;────────────────&lt;br&gt;cactus JWT (JWS / HS256) — mcm WAS 가 login/refresh 응답으로 발급&lt;br&gt;&lt;br&gt;★ 2026-05-21~ shared secret 신뢰 모델:&lt;br&gt;BFF↔BE 인증은 X-Client-Key (shared secret) + X-Authenticated-User/Role&lt;br&gt;헤더로 처리. JwtAuthenticationFilter 는 ClientKeyFilter 가 set 한&lt;br&gt;사전 인증을 보존만 하고 JWT 자체 검증은 스킵.&lt;br&gt;cactus.jwt.secret 은 login API 의 토큰 발급/refresh 용도로만 사용." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;" vertex="1" parent="was6">
          <mxGeometry x="15" y="45" width="530" height="170" as="geometry" />
        </mxCell>
        <mxCell id="was6decoded" value="cactus JWT 페이로드 (login API 발급 응답 형태, base64url 평문)&lt;br&gt;────────────────&lt;br&gt;header : {&quot;alg&quot;:&quot;HS256&quot;,&quot;typ&quot;:&quot;JWT&quot;}&lt;br&gt;payload: {&lt;br&gt;  iss: &quot;mcm&quot;,&lt;br&gt;  sub: &quot;admin&quot;,             ← userId&lt;br&gt;  userNm: &quot;관리자&quot;,         ⚠ 평문 노출 (login 응답 한정)&lt;br&gt;  userEmpNo: &quot;E12345&quot;,      ⚠ 평문 노출 (login 응답 한정)&lt;br&gt;  roles: [&quot;ROLE_SYSADMIN&quot;],&lt;br&gt;  jti, iat, exp (8시간)&lt;br&gt;}&lt;br&gt;signature : HMAC-SHA256(header.payload, cactus.jwt.secret)&lt;br&gt;&lt;br&gt;※ 이 토큰은 NextAuth JWT 에 호환 보관되지만&lt;br&gt;   BFF→BE 호출에 Authorization Bearer 로 forward 되지 않음." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;fontFamily=Menlo,monospace;" vertex="1" parent="was6">
          <mxGeometry x="15" y="225" width="530" height="220" as="geometry" />
        </mxCell>

        <mxCell id="e6-br-bff" value="외피 쿠키 (JWE)&lt;br&gt;AUTH_SECRET 로 서명" style="endArrow=classic;html=1;fontSize=11;startArrow=classic;endFill=1;startFill=1;strokeColor=#6c8ebf;" edge="1" parent="1" source="browser6" target="bff6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6-bff-was" value="2026-05-21~ shared secret 모델&lt;br&gt;X-Client-Key (env BACKEND_CLIENT_KEY)&lt;br&gt;+ X-Authenticated-User + X-Authenticated-Role&lt;br&gt;+ X-Request-Id&lt;br&gt;(Authorization Bearer 미부착)" style="endArrow=classic;html=1;fontSize=11;startArrow=classic;endFill=1;startFill=1;strokeColor=#d79b00;" edge="1" parent="1" source="bff6" target="was6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="cmp-title" value="외피 vs 내피 비교" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="60" y="560" width="400" height="25" as="geometry" />
        </mxCell>

        <mxCell id="cmp" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;verticalAlign=top;container=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="590" width="1600" height="380" as="geometry" />
