        <mxCell id="cmp-h3" value="내피 — cactus access JWT (JWS)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#999999;fontSize=11;fontStyle=1;" vertex="1" parent="cmp">
          <mxGeometry x="820" y="0" width="780" height="30" as="geometry" />
