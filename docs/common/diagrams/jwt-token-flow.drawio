        <mxCell id="cmp-r1b" value="브라우저 ↔ BFF 세션 유지" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="cmp">
          <mxGeometry x="200" y="30" width="620" height="40" as="geometry" />
