        <mxCell id="cmp-r1a" value="역할" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8f8f8;strokeColor=#cccccc;fontSize=10;fontStyle=1;" vertex="1" parent="cmp">
          <mxGeometry x="0" y="30" width="200" height="40" as="geometry" />
