        <mxCell id="a5-portal" value="portal WAS&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;(com.dongkuk.dmes.portal.* PortalAuthController&lt;br&gt;토큰 발급 단일 진입점 · :8080)&lt;/font&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#ffe6cc;strokeColor=#b85450;strokeWidth=3;fontSize=12;fontStyle=1" vertex="1" parent="1">
