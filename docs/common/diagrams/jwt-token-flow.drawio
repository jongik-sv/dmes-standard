        <mxCell id="e-oasis-nginx" value="/api/{group}/… (운영)" style="endArrow=classic;html=1;fontSize=10;" edge="1" parent="1" source="bff-oasisroute" target="nginx">
          <mxGeometry relative="1" as="geometry" />
