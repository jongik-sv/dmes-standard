%% TSK-02-03 영역 06 (dme) ERD — design.md §6.5. 배포 순번 chg_seq 없음(버전 스냅샷 배포).
%% RULE_VER→VAR, RULE_VER→ROW 두 FK 에만 ON DELETE CASCADE(F13).
erDiagram
    TB_MDM_RULE {
        CD50 MARU_RULE_ID PK
        NM100 MARU_RULE_NAME
        CD20 RULE_KIND "DECISION DERIVE"
        CD20 STATUS "CREATED INUSE DEPRECATED"
        CD20 SOURCE_SYSTEM FK
        INT4 LAST_VAR_ID
        INT4 LAST_ROW_ID
        INT4 LAST_CASE_ID
    }
    TB_MDM_RULE_SYSTEM["TB_MDM_RULE_SYSTEM (보류)"] {
        CD50 MARU_RULE_ID PK,FK
        CD20 SYSTEM_CODE PK,FK
        CD20 DEPLOY_KIND "DEF RESULT"
    }
    TB_MDM_RULE_VER {
        CD50 MARU_RULE_ID PK,FK
        INT4 VER PK "이탈: 감사 VER 충돌로 AUD_VER 개명"
        CD20 STATUS "DRAFT REQUESTED APPROVED RELEASED CANCELLED"
        CD20 HIT_POLICY "FIRST UNIQUE PRIORITY COLLECT ANY"
        INT4 ROW_VERSION
    }
    TB_MDM_RULE_VAR {
        CD50 MARU_RULE_ID PK,FK
        INT4 VER PK,FK "CASCADE, AUD_VER 개명"
        INT4 VAR_ID PK
        CD20 VAR_KIND "COND RESULT"
        INT4 DOMAIN_ID FK "정방향 02→06"
        JSONV VAR_AST
    }
    TB_MDM_RULE_ROW {
        CD50 MARU_RULE_ID PK,FK
        INT4 VER PK,FK "CASCADE, AUD_VER 개명"
        INT4 ROW_ID PK
        CD20 ROW_KIND "NORMAL DEFAULT"
        JSONV_NN CELLS "NOT NULL"
    }
    TB_MDM_RULE_TEST_CASE {
        CD50 MARU_RULE_ID PK,FK
        INT4 CASE_ID PK
        JSONV_NN INPUT_JSON
        JSONV EXPECTED_JSON
        INT4 ROW_VERSION
    }
    TB_MDM_RULE_SET["TB_MDM_RULE_SET (버전 없음, 저장 즉시 배포)"] {
        CD50 MARU_RULE_SET_ID PK
        NM100 MARU_RULE_SET_NAME
        JSONV_NN RULE_IDS "FK 없음"
        JSONV FLOW_JSON "흐름도 JSON(NULL=RULE_IDS 한 줄 흐름)"
        CD20 STATUS "INUSE DEPRECATED"
        INT4 ROW_VERSION
    }
    TB_MDM_RULE_RECV["TB_MDM_RULE_RECV (수신 로그, 보류)"] {
        ID_AI RECV_ID PK
        CD50 MARU_RULE_ID FK
        CD20 SOURCE_SYSTEM FK
        CD20 REQ_KIND "VERSION CANCEL DEPRECATE"
        INT4 VER "이탈: AUD_VER 개명 대상"
    }
    TB_MDM_SYSTEM["TB_MDM_SYSTEM (TSK-01-02 소유)"] {
        CD20 SYSTEM_CODE PK
    }
    TB_MDM_DOMAIN["TB_MDM_DOMAIN (02, 교차영역)"] {
        ID_AI DOMAIN_ID PK
    }

    TB_MDM_SYSTEM ||--o{ TB_MDM_RULE : "SOURCE_SYSTEM"
    TB_MDM_RULE ||--o{ TB_MDM_RULE_SYSTEM : "MARU_RULE_ID"
    TB_MDM_SYSTEM ||--o{ TB_MDM_RULE_SYSTEM : "SYSTEM_CODE"
    TB_MDM_RULE ||--o{ TB_MDM_RULE_VER : "MARU_RULE_ID"
    TB_MDM_RULE_VER ||--o{ TB_MDM_RULE_VAR : "MARU_RULE_ID,VER (ON DELETE CASCADE)"
    TB_MDM_DOMAIN ||..o{ TB_MDM_RULE_VAR : "DOMAIN_ID (점선, 정방향 교차영역)"
    TB_MDM_RULE_VER ||--o{ TB_MDM_RULE_ROW : "MARU_RULE_ID,VER (ON DELETE CASCADE)"
    TB_MDM_RULE ||--o{ TB_MDM_RULE_TEST_CASE : "MARU_RULE_ID"
    TB_MDM_RULE ||--o{ TB_MDM_RULE_RECV : "MARU_RULE_ID"
    TB_MDM_SYSTEM ||--o{ TB_MDM_RULE_RECV : "SOURCE_SYSTEM"
