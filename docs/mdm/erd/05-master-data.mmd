        CD50 MARU_DATA_ID PK,FK
        CD50 CODE PK
        DTS VALID_FROM PK
        DTS VALID_TO
        INT4 ROW_VERSION
        BIGI CHG_SEQ
    }
    TB_MDM_DATA_CATE {
        CD50 MARU_DATA_ID PK,FK
        CD50 CATE_ID PK
        DTS VALID_FROM PK
        CD20 DEF_KIND "REGEX TABLE"
        BIGI CHG_SEQ
    }
    TB_MDM_DATA_CATE_ITEM {
        CD50 MARU_DATA_ID PK,FK
        CD50 CATE_ID PK "FK 없음, 앱 검사"
        CD50 CODE PK "FK 없음, 앱 검사"
        DTS VALID_FROM PK
        BIGI CHG_SEQ
    }
    TB_MDM_DATA_RECV["TB_MDM_DATA_RECV (수신 로그, 보류)"] {
        ID_AI RECV_ID PK
        CD50 MARU_DATA_ID FK
        CD20 SOURCE_SYSTEM FK
        INT4 ROW_COUNT
    }
    TB_MDM_DATA_RECV_ITEM["TB_MDM_DATA_RECV_ITEM (보류)"] {
        INT4 RECV_ID PK,FK
        INT4 SEQ PK
        CD20 ACTION "예약어, INSERT UPDATE CLOSE REOPEN NONE"
    }
    TB_MDM_SYSTEM["TB_MDM_SYSTEM (TSK-01-02 소유)"] {
        CD20 SYSTEM_CODE PK
    }

