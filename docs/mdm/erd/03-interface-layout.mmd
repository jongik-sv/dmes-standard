%% TSK-02-03 영역 03 (dmb) ERD — design.md §6.2. D1(헤더 적층)·D2(상수 재정의) 신설 테이블 포함.
%% EAI↔LAYOUT 은 영역 내부 순환 FK(SQLite 인라인 가능, MSSQL 후행 ALTER, §6.6).
erDiagram
    TB_MDM_EAI {
        CD20 EAI_CODE PK
        NM100 EAI_NAME
        CD20 ENCODING
        INT4 HEADER_LAYOUT_ID FK "순환, TB_MDM_LAYOUT"
    }
    TB_MDM_LAYOUT {
        ID_AI LAYOUT_ID PK
        CD20 LAYOUT_KIND "HEADER 또는 MESSAGE"
        NM100 LAYOUT_NAME
        CD20 EAI_CODE FK "순환, TB_MDM_EAI"
        CD20 SND_SYSTEM FK
        CD20 RCV_SYSTEM FK
        BIGI VERSION "예약어, 배포 스냅샷 번호"
    }
    TB_MDM_LAYOUT_ITEM {
        INT4 LAYOUT_ID PK,FK
        INT4 SEQ PK
        CD20 FILL_KIND "DATA CONST AUTO FILLER"
        CD50 COLUMN_PHYS FK "TB_MDM_COLUMN.PHYS_NAME(02)"
        CD20 TRANS_UNIT FK
        INT4 OFFSET "예약어, 계산값"
        INT4 LENGTH "예약어, 계산값"
    }
    TB_MDM_LAYOUT_HEADER["TB_MDM_LAYOUT_HEADER (신설, D1)"] {
        INT4 LAYOUT_ID PK,FK "MESSAGE 측"
        INT4 SEQ PK "적층 순서"
        INT4 HEADER_LAYOUT_ID PK,FK "HEADER 측"
    }
    TB_MDM_LAYOUT_CONST["TB_MDM_LAYOUT_CONST (신설, D2)"] {
        INT4 LAYOUT_ID PK,FK
        INT4 HEADER_LAYOUT_ID PK,FK
        INT4 HEADER_SEQ PK,FK "TB_MDM_LAYOUT_ITEM 복합FK"
        CD50 CONST_VALUE "전문별 재정의 값"
    }
    TB_MDM_SYSTEM["TB_MDM_SYSTEM (TSK-01-02 소유)"] {
        CD20 SYSTEM_CODE PK
    }
    TB_MDM_COLUMN["TB_MDM_COLUMN (02, 교차영역)"] {
        CD50 PHYS_NAME UK
    }
    TB_MDM_UNIT["TB_MDM_UNIT (02, 교차영역)"] {
        CD20 UNIT_CODE PK
    }

    TB_MDM_LAYOUT ||--o{ TB_MDM_EAI : "HEADER_LAYOUT_ID (순환)"
    TB_MDM_EAI ||--o{ TB_MDM_LAYOUT : "EAI_CODE (순환, MESSAGE 측)"
    TB_MDM_SYSTEM ||--o{ TB_MDM_LAYOUT : "SND_SYSTEM/RCV_SYSTEM"
    TB_MDM_LAYOUT ||--o{ TB_MDM_LAYOUT_ITEM : "LAYOUT_ID"
    TB_MDM_COLUMN ||..o{ TB_MDM_LAYOUT_ITEM : "COLUMN_PHYS (점선, 교차영역 03→02)"
    TB_MDM_UNIT ||..o{ TB_MDM_LAYOUT_ITEM : "TRANS_UNIT (점선, 교차영역)"
    TB_MDM_LAYOUT ||--o{ TB_MDM_LAYOUT_HEADER : "LAYOUT_ID(MESSAGE)"
    TB_MDM_LAYOUT ||--o{ TB_MDM_LAYOUT_HEADER : "HEADER_LAYOUT_ID(HEADER)"
    TB_MDM_LAYOUT ||--o{ TB_MDM_LAYOUT_CONST : "LAYOUT_ID"
    TB_MDM_LAYOUT_ITEM ||--o{ TB_MDM_LAYOUT_CONST : "HEADER_LAYOUT_ID,HEADER_SEQ"
    TB_MDM_LAYOUT_HEADER ||--o{ TB_MDM_LAYOUT_CONST : "LAYOUT_ID,HEADER_LAYOUT_ID (부착 무결성)"
