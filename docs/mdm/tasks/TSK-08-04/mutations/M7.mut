rule: RR7 — 식 셀 판정은 검사기와 조립이 같은 함수(RuleExpressionChecks.exprCell)를 쓴다
file: src/backend/mdm/lib/src/main/java/com/dongkuk/dmes/mdm/common/rule/check/RuleExpressionChecks.java
test: cd src/backend && JAVA_HOME=/opt/homebrew/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home ./gradlew :mdm:lib:test --tests "com.dongkuk.dmes.mdm.common.rule.definition.RuleDefinitionAssemblerTest" --console=plain
e2e: no
--- find
    public static boolean exprCell(String varKind, String dispType, Map<String, Object> cell) {
        boolean cond = "COND".equals(varKind);
        return cell.get("expr") != null && (cond ? "Expression".equals(dispType) && cell.get("op") == null
                : cell.get("val") == null && cell.get("op") == null && "Expression".equals(dispType));
    }
--- replace
    public static boolean exprCell(String varKind, String dispType, Map<String, Object> cell) {
        return false;
    }
