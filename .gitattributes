# analog 엔진 테스트 픽스처 — 줄바꿈 무변환(-text) 필수.
# 엔진이 바이트 오프셋 기반 검색이라 CRLF→LF 정규화 시 픽스처가 오염된다
# (tiny_crlf.log 는 CRLF 줄바꿈 자체를 검증하는 자원).
src/backend/analog/core/src/test/resources/logs/** -text
src/backend/analog/api/src/test/resources/fixture-logs/** -text

# Windows 실행 스크립트 — 반드시 CRLF 로 체크아웃돼야 한다.
#   .cmd : cmd.exe 가 LF 만 있는 배치를 잘못 파싱하는 경우가 있다.
#   .ps1 : UTF-8 BOM 으로 커밋돼 있다(Windows PowerShell 5.1 이 BOM 없는 파일을 ANSI 로 읽어
#          한글 주석/로그가 깨지기 때문). BOM 은 그대로 두고 줄바꿈만 CRLF 로 고정한다.
*.cmd text eol=crlf
*.ps1 text eol=crlf

# dflow-kit — 스킬 스크립트 줄끝 고정
.claude/skills/** text eol=lf
